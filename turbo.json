{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": ["bun.lock", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "VITE_*"],
  "globalPassThroughEnv": [
    "CI",
    "TERM",
    "FORCE_COLOR",
    "NO_COLOR",
    "DO_NOT_TRACK",
    "TURBO_TELEMETRY_DISABLED",
    "electron_config_cache",
    "ELECTRON_DISABLE_SANDBOX",
    "ELECTRON_OVERRIDE_DIST_PATH",
    "DISPLAY",
    "XAUTHORITY",
    "LD_PRELOAD",
    "TREETIME_PROJECT_ROOT",
    "TREETIME_APP_DIR",
    "TREETIME_DESKTOP_DEV_DIR",
    "TREETIME_DESKTOP_PROD_DIR",
    "TREETIME_PROFILE_DIR",
    "TREETIME_RUNS_DIR",
    "TREETIME_LOGS_DIR",
    "TREETIME_EXAMPLES_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
