#!/usr/bin/env python3
"""Update dev/docker/prod-bases.json, the base images of dev/docker/prod-images.

The production images neherlab/treetime build on the 6 newest Alpine
releases, the 3 newest Debian releases, and scratch. Each base is pinned to
the digest of its Docker Hub tag, so the images of one release and a later
re-run use the same base. The release lines come from endoflife.date, and the
digests from the tags of the official images on Docker Hub.

A release line or a digest is used only when it is at least 7 days old, the
quarantine of the project for base images:
  - a release line released less than 7 days ago is skipped
  - when the tag of a line was pushed less than 7 days ago, the line takes
    the newest dated tag of the same line that is at least 7 days old (Debian
    keeps every build as <codename>-YYYYMMDD; Alpine has no dated tags), or
    else keeps the digest that the file already has
  - a line without such a digest fails the run, with the date from which a
    re-run succeeds

Run it from time to time, so the nightly images get the security fixes of
their bases, and commit the file. Needs network access; prints nothing on success.

Examples:
  dev/docker/run dev/docker/prod-bases-update
"""

import argparse
import json
import re
import sys
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import UTC, date, datetime, timedelta
from pathlib import Path
from typing import NoReturn

ROOT = Path(__file__).resolve().parents[2]
BASES_FILE = ROOT / "dev/docker/prod-bases.json"
QUARANTINE = timedelta(days=7)


@dataclass(frozen=True)
class Distro:
    """Release lines of a base on endoflife.date, and the number of newest lines to build on."""

    lines_url: str
    count: int
    # The official image also tags each build as <codename>-YYYYMMDD.
    dated_tags: bool


@dataclass(frozen=True)
class Line:
    """Release line: its Docker Hub tag and its codename."""

    tag: str
    codename: str


# Docker Hub repository of each base.
DISTROS = {
    "alpine": Distro("https://endoflife.date/api/alpine-linux.json", 6, dated_tags=False),
    "debian": Distro("https://endoflife.date/api/debian.json", 3, dated_tags=True),
}
DOCKER_HUB_TAGS = "https://hub.docker.com/v2/namespaces/library/repositories/{repository}/tags"


def main() -> None:
    argparse.ArgumentParser(
        prog="dev/docker/prod-bases-update",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    ).parse_args()

    now = datetime.now(UTC)
    pinned = read_pinned()
    bases: dict[str, list[dict[str, str]]] = {}
    errors = []
    for repository, distro in DISTROS.items():
        bases[repository] = []
        for line in release_lines(distro, now.date()):
            tag_url = f"{DOCKER_HUB_TAGS.format(repository=repository)}/{line.tag}"
            tag_info = fetch_json(tag_url)
            pushed = datetime.fromisoformat(tag_info["tag_last_pushed"])
            digest = None
            if now - pushed >= QUARANTINE:
                digest = tag_info["digest"]
            elif distro.dated_tags:
                digest = newest_dated_digest(repository, line.codename, now)
            if digest is None:
                digest = pinned.get(repository, {}).get(line.tag)
            if digest is None:
                errors.append(
                    f"{repository}:{line.tag} has no pinned digest, and its current digest {tag_info['digest']} was "
                    f"pushed at {pushed:%Y-%m-%d %H:%M} UTC, less than 7 days ago; re-run from "
                    f"{pushed + QUARANTINE:%Y-%m-%d %H:%M} UTC"
                )
                continue
            bases[repository].append({"tag": line.tag, "digest": digest})
    if errors:
        fail("\n".join(errors))
    bases["scratch"] = []
    BASES_FILE.write_text(json.dumps({"bases": bases}, indent=2) + "\n")


def release_lines(distro: Distro, today: date) -> list[Line]:
    """Return the newest release lines that were released at least 7 days ago, newest first."""
    released = [
        line
        for line in fetch_json(distro.lines_url)
        if line.get("releaseDate") and date.fromisoformat(line["releaseDate"]) <= today - QUARANTINE
    ]
    released.sort(key=lambda line: line["releaseDate"], reverse=True)
    return [Line(str(line["cycle"]), str(line.get("codename") or "").lower()) for line in released[: distro.count]]


def newest_dated_digest(repository: str, codename: str, now: datetime) -> str | None:
    """Return the digest of the newest tag <codename>-YYYYMMDD pushed at least 7 days ago."""
    if not codename:
        return None
    query = urllib.parse.urlencode({"name": f"{codename}-", "page_size": 100})
    pattern = re.compile(rf"{re.escape(codename)}-\d{{8}}")
    old_enough = [
        tag
        for tag in fetch_json(f"{DOCKER_HUB_TAGS.format(repository=repository)}?{query}")["results"]
        if pattern.fullmatch(tag["name"]) and now - datetime.fromisoformat(tag["tag_last_pushed"]) >= QUARANTINE
    ]
    if not old_enough:
        return None
    return max(old_enough, key=lambda tag: tag["name"])["digest"]


def read_pinned() -> dict[str, dict[str, str]]:
    """Return the digests of the file by repository and tag; empty when the file does not exist."""
    if not BASES_FILE.exists():
        return {}
    bases = json.loads(BASES_FILE.read_text())["bases"]
    return {repository: {base["tag"]: base["digest"] for base in entries} for repository, entries in bases.items()}


def fetch_json(url: str):
    request = urllib.request.Request(url, headers={"User-Agent": "treetime dev/docker/prod-bases-update"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except OSError as error:
        fail(f"Failed to fetch {url}: {error}")


def fail(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
