#!/usr/bin/env bash
#
# Usage: dev/docker/python <command> [args...]
#
# Run a command in the Python image of TreeTime v0, the reference
# implementation: python3 with its scientific stack, and `treetime` for v0.
#
# Examples:
#   dev/docker/python treetime ancestral --help
#   dev/docker/python python3 test_scripts/fitch.py
#
set -euo pipefail

if (($# == 0)); then
  sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" >&2
  exit 1
fi
TREETIME_DOCKER_IMAGE=jupyter exec "$(dirname "${BASH_SOURCE[0]}")/run" "$@"
