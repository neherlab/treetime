#!/usr/bin/env bash
#
# Usage: dev/docker/run [command [args...]]
#
# Run a command inside a TreeTime build container. With no command, start an
# interactive shell. The image is built on first use and rebuilt whenever one of
# its build inputs changes.
#
# The checkout is mounted read-write at its host path, so paths in build output,
# git worktree links, and per-worktree port resolution match the host. The git
# metadata is mounted read-only: nothing inside the container can plant a hook or
# a config entry that later runs on the host.
#
# Environment:
#   CROSS_COMPILE           Target of the image: `native` (default, development
#                           image) or one of the release targets in dev/cross/targets
#   TREETIME_DOCKER_IMAGE   `jupyter` selects the v0 Python image instead
#   TREETIME_DOCKER_X11=1   Share the host X11 display (desktop app development)
#   TREETIME_DOCKER_PUSH=1  Push the built image and its layer cache to the
#                           registry (CI on the base branch only)
#   KACHE_STORE             Host directory of the optional kache compiler cache;
#                           mounted at the same path when set (see .env.example)
#   PORTLESS_STATE_DIR      State directory of the optional portless proxy
#                           (default ~/.portless); mounted when it exists
#
# Examples:
#   dev/docker/run just check
#   CROSS_COMPILE=aarch64-apple-darwin dev/docker/run dev/cross/build treetime
#
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
# shellcheck source=../lib/env.sh
source "${root}/dev/lib/env.sh"
load_env_file "${root}/.env"

registry="neherlab/treetime_builder"
platform="linux/amd64"
target="${CROSS_COMPILE:-native}"
kind="${TREETIME_DOCKER_IMAGE:-${target}}"

# Cross images: the Dockerfile and the toolchain names of each release target.
cross_image() {
  dockerfile="dev/docker/${1}.dockerfile"
  build_args=(
    --build-arg="CROSS_COMPILE=${target}"
    --build-arg="CROSS_COMPILE_UPPER=$(printf '%s' "${target//-/_}" | tr '[:lower:]' '[:upper:]')"
    --build-arg="CROSS_COMPILE_SAFE=${target//-/_}"
    --build-arg="CROSS_GCC_TRIPLET=${2}"
    --build-arg="CROSS_ARCH=${3:-}"
    --build-arg="CROSS_ARCH_DEBIAN=${4:-}"
    --build-arg="CROSS_RUNNER=${5:-}"
    --build-arg="CROSS_APPLE_TRIPLET=${6:-}"
  )
}

build_args=()
case "${kind}" in
native) dockerfile="dev/docker/native.dockerfile" ;;
jupyter)
  dockerfile="dev/docker/jupyter.dockerfile"
  build_args=(--build-arg="UID=$(id -u)" --build-arg="GID=$(id -g)")
  ;;
x86_64-unknown-linux-gnu) cross_image cross-linux "${target}" x86_64 amd64 qemu-x86_64 ;;
x86_64-unknown-linux-musl) cross_image cross-linux "${target}" x86_64 amd64 qemu-x86_64 ;;
aarch64-unknown-linux-gnu) cross_image cross-linux "${target}" aarch64 arm64 qemu-aarch64 ;;
aarch64-unknown-linux-musl) cross_image cross-linux "${target}" aarch64 arm64 qemu-aarch64 ;;
x86_64-pc-windows-gnu) cross_image cross-linux x86_64-w64-mingw32 x86_64 amd64 /usr/lib/wine/wine64 ;;
x86_64-apple-darwin) cross_image cross-darwin x86_64-apple-darwin20.2 "" "" "" x86_64-apple-darwin20.2 ;;
aarch64-apple-darwin) cross_image cross-darwin aarch64-apple-darwin20.2 "" "" "" arm64-apple-darwin20.2 ;;
*)
  printf 'Unsupported image: %s. Supported: native, jupyter, and the targets in dev/cross/targets\n' "${kind}" >&2
  exit 1
  ;;
esac

# The image tag is a hash of the build inputs, their paths included, so any
# change to them builds a new image and an unchanged set reuses the tag.
build_inputs=(
  "${dockerfile}"
  "${dockerfile}.dockerignore"
  dev/docker/files
  rust-toolchain.toml
)
case "${kind}" in
native) build_inputs+=(mise.toml mise.lock dev/lints/dylint-custom/rust-toolchain.toml dev/lints/dylint-mordant/rust-toolchain.toml dev/lints/dylint-trailofbits/rust-toolchain.toml) ;;
jupyter) build_inputs+=(requirements.txt) ;;
esac
image_hash="$(cd "${root}" && hash_files "${build_inputs[@]}" "${build_args[@]+"${build_args[@]}"}" "${platform}")"
image="${registry}:${kind}-${image_hash}"

build_image() {
  local flags=()
  if [[ "${TREETIME_DOCKER_PUSH:-}" == 1 ]]; then
    local builder="treetime-${kind}"
    docker buildx inspect "${builder}" >/dev/null 2>&1 || docker buildx create --name="${builder}" --driver=docker-container >/dev/null
    flags=(
      --builder="${builder}"
      --push
      --cache-from="type=registry,ref=${registry}:cache-${kind}"
      --cache-to="type=registry,mode=max,ref=${registry}:cache-${kind}"
    )
  else
    flags=(--load)
  fi
  docker buildx build \
    --platform="${platform}" \
    --file="${root}/${dockerfile}" \
    --tag="${image}" \
    "${build_args[@]+"${build_args[@]}"}" \
    "${flags[@]}" \
    --progress=plain \
    "${root}" >&2
}

if ! docker image inspect "${image}" >/dev/null 2>&1; then
  if ! docker pull --quiet --platform="${platform}" "${image}" >/dev/null 2>&1; then
    printf 'Building image %s\n' "${image}" >&2
    build_image
    if [[ "${TREETIME_DOCKER_PUSH:-}" == 1 ]]; then
      docker pull --quiet --platform="${platform}" "${image}" >/dev/null
    fi
  fi
fi

run_flags=(
  --rm
  --interactive
  --init
  --platform="${platform}"
  --network=host
  --cap-drop=ALL
  --security-opt=no-new-privileges
  --user="$(id -u):$(id -g)"
  --volume="${root}:${root}"
  --env="TREETIME_CONTAINER=1"
  --env="TREETIME_ROOT=${root}"
  --env="TERM=${TERM:-xterm-256color}"
  --env="TZ=Etc/UTC"
  --env="LANG=C.UTF-8"
  --env="DO_NOT_TRACK=1"
  --env="MISE_DISABLE_UPDATE_WARNING=1"
  --env="TURBO_TELEMETRY_DISABLED=1"
)
if [[ -t 0 && -t 1 ]]; then
  run_flags+=(--tty)
fi

# The working directory follows the caller when it is inside the checkout.
cwd="$(pwd -P)"
case "${cwd}/" in
"${root}/"*) run_flags+=(--workdir="${cwd}") ;;
*) run_flags+=(--workdir="${root}") ;;
esac

# A linked worktree keeps its git directory under the main checkout, outside the
# mounted root; mount the common directory read-only so git works inside.
if git_common_dir="$(git -C "${root}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  run_flags+=(--volume="${git_common_dir}:${git_common_dir}:ro")
fi

for name in CI GITHUB_ACTIONS COLORTERM NO_COLOR FORCE_COLOR TREETIME_BUILD_MODE TREETIME_VERSION_SUFFIX TREETIME_API_PORT TREETIME_WEB_PORT TREETIME_PORTLESS; do
  if [[ -n "${!name+x}" ]]; then
    run_flags+=(--env="${name}=${!name}")
  fi
done

case "${kind}" in
jupyter)
  mkdir -p "${root}/.cache/jupyter"
  run_flags+=(--volume="${root}/.cache/jupyter:/home/user/.jupyter" --env="JUPYTER_PORT=${JUPYTER_PORT:-10000}")
  ;;
*)
  # The cargo home and the bun cache live under .cache of the checkout; build
  # output goes to .build/container, apart from host builds in .build/host.
  mkdir -p "${root}/.cache/cargo/dylint_drivers" "${root}/.cache/bun" "${root}/.build/container"
  run_flags+=(
    --env="HOME=/tmp/home"
    --env="MISE_TRUSTED_CONFIG_PATHS=${root}"
    --env="CARGO_HOME=${root}/.cache/cargo"
    --env="DYLINT_DRIVER_PATH=${root}/.cache/cargo/dylint_drivers"
    --env="TREETIME_BUILD_DIR=${root}/.build/container"
    --env="BUN_INSTALL_CACHE_DIR=${root}/.cache/bun"
    --env="electron_config_cache=${root}/.cache/electron"
  )
  if [[ -n "${KACHE_STORE:-}" ]]; then
    mkdir -p "${KACHE_STORE}"
    run_flags+=(--env="KACHE_STORE=${KACHE_STORE}" --volume="${KACHE_STORE}:${KACHE_STORE}")
  fi
  portless_dir="${PORTLESS_STATE_DIR:-${HOME}/.portless}"
  if [[ -d "${portless_dir}" ]]; then
    run_flags+=(--env="PORTLESS_STATE_DIR=${portless_dir}" --volume="${portless_dir}:${portless_dir}")
  fi
  if [[ "${TREETIME_DOCKER_X11:-}" == 1 && -n "${DISPLAY:-}" ]]; then
    run_flags+=(
      --volume="/tmp/.X11-unix:/tmp/.X11-unix:ro"
      --volume="${XAUTHORITY:-${HOME}/.Xauthority}:/tmp/.Xauthority:ro"
      --env="DISPLAY=${DISPLAY}"
      --env="XAUTHORITY=/tmp/.Xauthority"
      --env="ELECTRON_DISABLE_SANDBOX=1"
      --ipc=host
    )
  fi
  ;;
esac

exec docker run "${run_flags[@]}" "${image}" "${@:-bash}"
