#!/usr/bin/env bash
#
# Usage: $0 <prefix>
#
# Install the static, single-threaded OpenBLAS for wasm32-unknown-emscripten
# that binarylandia/build_openblas builds with emcc into a prefix.
#
# - LAPACK comes from the C translation that ships with OpenBLAS. Its functions
#   take no hidden string lengths and return void, as the lapack-sys
#   declarations do; WebAssembly traps on a call whose signature differs from
#   the callee
# - Emscripten gives no ABI guarantee between versions, so the archive links
#   only with the Emscripten version that built it. The install fails when the
#   archive comes from another version than the installed Emscripten; an
#   Emscripten upgrade needs a new build_openblas release first
#
set -euxo pipefail

dest="${1:?prefix}"
release="2026-10-17_03-13-01"
emscripten_version="6.0.10"
archive="/tmp/openblas.tar.xz"
installed_version_file="/opt/emscripten/emscripten/emscripten-version.txt"
mkdir -p "${dest}"

/fetch "https://github.com/binarylandia/build_openblas/releases/download/${release}/openblas-static-0.3.34-432-gde5d4914-wasm32-unknown-emscripten.${emscripten_version}-${release}.tar.xz" "${archive}"
pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
rm "${archive}"

if ! cmp -s "${dest}/share/openblas/emscripten-version.txt" "${installed_version_file}"; then
  printf 'The OpenBLAS archive was built with Emscripten %s, but the image has Emscripten %s. Build a new release of binarylandia/build_openblas with the installed Emscripten.\n' \
    "$(<"${dest}/share/openblas/emscripten-version.txt")" "$(<"${installed_version_file}")" >&2
  exit 1
fi
test -f "${dest}/lib/libopenblas.a"
