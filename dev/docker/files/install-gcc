#!/usr/bin/env bash
#
# Usage: $0 <prefix>
#
# Install GCC 14 for the x86_64 Linux host (C, C++, and Fortran, with the static
# libgfortran that the OpenBLAS archive needs) into a prefix.
#
set -euxo pipefail

dest="${1:?prefix}"
release="2024-11-03_12-57-14"
archive="/tmp/gcc.tar.xz"
mkdir -p "${dest}"

/fetch "https://github.com/binarylandia/build_gcc/releases/download/${release}/gcc-14.2.0-host-x86_64-unknown-linux-gnu.2.17-${release}.tar.xz" "${archive}"
pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
rm "${archive}"
"${dest}/bin/gcc" --version
