#!/usr/bin/env bash
#
# Usage: $0 <triplet> <prefix>
#
# Install the static liblzma (xz) and libzstd that binarylandia/staticbourg
# builds for a target into a prefix, and point the `lzma` and `zstd` links of
# the liblzma-sys and zstd-sys crates at them in /.cargo/config.toml. Cargo then
# links the archives instead of compiling the bundled C sources in every new
# target directory. Cargo reads /.cargo/config.toml for every project below /,
# so only builds in the container use the archives; host builds compile the
# bundled sources.
#
# - The C versions are those that the crates bundle: liblzma-sys 0.4.9 bundles
#   xz 5.8.4, and zstd-sys 2.1.0+zstd.1.5.7 bundles zstd 1.5.7. A new version of
#   either crate needs a staticbourg release with its C version first
# - Emscripten gives no ABI guarantee between versions, so a WebAssembly archive
#   links only with the Emscripten version that built it. The install fails when
#   the archive comes from another version than the installed Emscripten
# - zstd-sys compiles with `feature = "std"` on wasm32, which its build script
#   sets; the override sets it too
#
set -euxo pipefail

triplet="${1:?triplet}"
dest="${2:?prefix}"
release="2026-10-21_13-40-13"
lzma_version="5.8.4"
zstd_version="1.5.7"
emscripten_version="6.0.10"
cargo_config="/.cargo/config.toml"
mkdir -p "${dest}" "$(dirname "${cargo_config}")"

target_name="${triplet}"
if [[ "${triplet}" == wasm32-unknown-emscripten ]]; then
  target_name="${triplet}.${emscripten_version}"
fi

for lib in "lzma-${lzma_version}" "zstd-${zstd_version}"; do
  archive="/tmp/${lib}.tar.xz"
  /fetch "https://github.com/binarylandia/staticbourg/releases/download/${release}/${lib}-static-${target_name}-${release}.tar.xz" "${archive}"
  pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
  rm "${archive}"
done
test -f "${dest}/lib/liblzma.a"
test -f "${dest}/lib/libzstd.a"

zstd_cfg=""
if [[ "${triplet}" == wasm32-unknown-emscripten ]]; then
  installed_version_file="/opt/emscripten/emscripten/emscripten-version.txt"
  if ! cmp -s "${dest}/share/emscripten-version.txt" "${installed_version_file}"; then
    printf 'The lzma and zstd archives were built with Emscripten %s, but the image has Emscripten %s. Build a new release of binarylandia/staticbourg with the installed Emscripten.\n' \
      "$(<"${dest}/share/emscripten-version.txt")" "$(<"${installed_version_file}")" >&2
    exit 1
  fi
  zstd_cfg="rustc-cfg = ['feature=\"std\"']"
fi

cat >>"${cargo_config}" <<CONFIG

[target.${triplet}.lzma]
rustc-link-lib = ["static=lzma"]
rustc-link-search = ["native=${dest}/lib"]

[target.${triplet}.zstd]
rustc-link-lib = ["static=zstd"]
rustc-link-search = ["native=${dest}/lib"]
${zstd_cfg}
CONFIG
