#!/usr/bin/env bash
#
# Usage: $0
#
# Install the rustc toolchain that cargo-hawk was built against. Hawk ships a
# compiler driver linked against a specific rustc's private internals and
# refuses to run on any other compiler, so its toolchain is installed here next
# to dev/dylint's nightly, in its own cached layer.
#
# cargo-hawk itself comes from mise; this only provides the matching compiler.
# The version lives in dev/docker/files/hawk-toolchain (the single source shared
# with the `hawk` justfile recipe) so the Dockerfile and the recipe never repeat
# the literal. It must match the rustc that the pinned cargo-hawk was built for.
#
set -euxo pipefail

HAWK_TOOLCHAIN="$(cat /hawk-toolchain)"

rustup toolchain install "${HAWK_TOOLCHAIN}" --profile minimal -c rustc-dev -c llvm-tools-preview -c rust-src
rustc "+${HAWK_TOOLCHAIN}" --version --verbose
