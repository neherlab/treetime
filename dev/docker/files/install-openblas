#!/usr/bin/env bash
#
# Usage: $0 <triplet> <prefix>
#
# Install a static OpenBLAS built for a target into a prefix.
#
set -euxo pipefail

triplet="${1:?triplet}"
dest="${2:?prefix}"
version="0.3.34"
build_time="2026-10-18_02-46-54"
release="openblas-${version}-${build_time}"
archive="/tmp/openblas.tar.xz"
mkdir -p "${dest}"

/fetch "https://github.com/binarylandia/build_openblas/releases/download/${release}/openblas-static-${version}-${triplet}-${build_time}.tar.xz" "${archive}"
pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
rm "${archive}"
test -f "${dest}/lib/libopenblas.a"
