#!/usr/bin/env bash
#
# Usage: $0 <triplet> <parent-dir>
#
# Install the static OpenBLAS that binarylandia/build_openblas builds for a
# target into <parent-dir>/<archive name>, and make cargo link it through
# /.cargo/config.toml, which cargo reads for every project below /, so only
# builds in the container use these entries.
#
# - Every target builds the same OpenBLAS develop commit with clang and flang 22.
#   Its LAPACK calls the Fortran runtime of flang, libflang_rt.runtime.a, which
#   ships in the archive; both link statically, so no binary or Node addon
#   depends on a shared OpenBLAS or Fortran runtime. The remaining undefined
#   symbols are those of the C library and of the compiler support library
#   (libgcc or compiler-rt), which every link has
# - The override of the `openblas` link replaces the openblas-src build script,
#   which would ask for the shared library
# - The folder carries the archive name, and the target rustflags name it, so a
#   new archive changes the flags of every crate: cargo rebuilds the workspace
#   and relinks every binary, test, and addon, which it would not do for a
#   changed archive alone. Builds that set RUSTFLAGS (dist and cross builds)
#   replace these flags and reach the folder through the override
#
set -euxo pipefail

triplet="${1:?triplet}"
parent="${2:?parent directory}"
version="0.3.34-432-gde5d4914"
# The Windows 7 target has its own release, built later from the same source.
case "${triplet}" in
x86_64-win7-windows-gnu) build_time="2026-10-19_14-04-08" ;;
*) build_time="2026-10-18_12-54-24" ;;
esac
release="openblas-${version}-${build_time}"
name="openblas-static-${version}-${triplet}-${build_time}"
dest="${parent}/${name}"
archive="/tmp/openblas.tar.xz"
cargo_config="/.cargo/config.toml"
mkdir -p "${dest}" "$(dirname "${cargo_config}")"

/fetch "https://github.com/binarylandia/build_openblas/releases/download/${release}/${name}.tar.xz" "${archive}"
pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
rm "${archive}"
test -f "${dest}/lib/libopenblas.a"
test -f "${dest}/lib/libflang_rt.runtime.a"

cat >>"${cargo_config}" <<CONFIG

[target.${triplet}]
rustflags = ["-Lnative=${dest}/lib"]

[target.${triplet}.openblas]
rustc-link-lib = ["static:-bundle=openblas", "static:-bundle=flang_rt.runtime"]
rustc-link-search = ["native=${dest}/lib"]
CONFIG
