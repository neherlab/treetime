#!/usr/bin/env bash
#
# Usage: $0 <prefix>
#
# Install the protobuf compiler, which prost-build runs, into a prefix.
#
set -euxo pipefail

dest="${1:?prefix}"
version="28.3"
archive="/tmp/protoc.zip"
mkdir -p "${dest}"

/fetch "https://github.com/protocolbuffers/protobuf/releases/download/v${version}/protoc-${version}-linux-x86_64.zip" "${archive}"
unzip -q "${archive}" -d "${dest}"
rm "${archive}"
"${dest}/bin/protoc" --version
