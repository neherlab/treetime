#!/usr/bin/env bash
#
# Usage: $0
#
# Install the pinned nightly toolchain used to build and run the custom lint
# library in dev/lints/dylint. Kept in its own image layer so it is cached
# independently of the main Rust toolchain install.
#
# The cargo-dylint and dylint-link binaries come from mise (cargo backend),
# built from source there because the prebuilt releases require a newer glibc
# than the Debian base image provides. mise does not manage rustup toolchains,
# so the nightly driver toolchain stays here.
#
# The copied toolchain file and the lint manifests are the version sources.
#
set -euxo pipefail

pushd "/tmp/lints/dylint" >/dev/null
rustup toolchain install
rustc --version --verbose
popd >/dev/null
