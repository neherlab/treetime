#!/usr/bin/env bash
#
# Usage: $0 <triplet> <prefix>
#
# Install a GCC 14 cross toolchain of binarylandia/build_crosstool-ng for a
# target triplet into a prefix.
#
set -euxo pipefail

triplet="${1:?triplet}"
dest="${2:?prefix}"
version="14.4.0"
build_time="2026-10-18_01-15-48"
release="gcc-${version}-${build_time}"
archive="/tmp/gcc-cross.tar.xz"
mkdir -p "${dest}"

/fetch "https://github.com/binarylandia/build_crosstool-ng/releases/download/${release}/gcc-${version}-${triplet}-${build_time}.tar.xz" "${archive}"
pixz -dp "$(nproc)" <"${archive}" | tar -C "${dest}" -x
rm "${archive}"

# The MinGW toolchain comes with libgcc_eh.a, which rustc links, and with its
# sysroot flattened out of the extra mingw/ directory, so Linux and Windows
# targets share the sysroot variables; build_crosstool-ng adds both.
if [[ "${triplet}" =~ (mingw|windows) ]]; then
  test -e "${dest}/lib/gcc/${triplet}/${version}/libgcc_eh.a"
  test -d "${dest}/${triplet}/sysroot/lib"
fi

test "$("${dest}/bin/${triplet}-gcc" -dumpmachine)" = "${triplet}"
