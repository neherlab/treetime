def main() -> int:
  logging.basicConfig(level=logging.INFO, format="%(message)s", stream=sys.stderr)
  args = parse_args()
  os.chdir(PROJECT_ROOT)
  try:
    if args.run_cases:
      return run_cases_mode(args)
    return host_mode(args)
  except SmokeError as error:
    log.error("%s", error)
    return 2
  except KeyboardInterrupt:
    log.error("interrupted")
    return 2


def parse_args() -> argparse.Namespace:
  parser = argparse.ArgumentParser(prog=SELF, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                   usage=argparse.SUPPRESS)
  parser.add_argument("--tier", choices=[t.value for t in Tier], default=Tier.QUICK.value)
  parser.add_argument("--only", metavar="REGEX")
  parser.add_argument("--rerun-failed", action="store_true")
  parser.add_argument("--list", action="store_true")
  parser.add_argument("--overview", action="store_true")
  parser.add_argument("--against", metavar="REF_OR_ID", default=DEFAULT_AGAINST)
  parser.add_argument("--no-compare", action="store_true")
  parser.add_argument("--jobs", type=int, default=os.cpu_count() or 1)
  parser.add_argument("--timeout-scale", type=float, default=1.0)
  parser.add_argument("--memory-budget", metavar="GIB", type=float)
  parser.add_argument("--rerun", action="store_true")
  parser.add_argument("--no-build", action="store_true")
  parser.add_argument("--check-determinism", action="store_true")
  parser.add_argument("--prune", action="store_true")
  parser.add_argument("--run-cases", action="store_true", help=argparse.SUPPRESS)
  parser.add_argument("--bin", help=argparse.SUPPRESS)
  parser.add_argument("--snapshot", help=argparse.SUPPRESS)
  parser.add_argument("--cases", help=argparse.SUPPRESS)
  args = parser.parse_args()
  if args.jobs < 1:
    parser.error("--jobs must be at least 1")
  if args.memory_budget is not None and args.memory_budget <= 0:
    parser.error("--memory-budget must be positive")
  if args.timeout_scale <= 0:
    parser.error("--timeout-scale must be positive")
  return args


def host_mode(args: argparse.Namespace) -> int:
  start = time.perf_counter()
  current = working_tree_snapshot()
  if args.prune:
    prune_snapshots(current)
    return 0
  cases = build_matrix(PROJECT_ROOT)
  ids = last_failed_ids(current) if args.rerun_failed else None
  if ids is not None and not ids:
    print("The last run has no failed cases")
    return 0
  selected = select_cases(cases, Tier(args.tier), args.only, ids)
  if args.list:
    print("\n".join(case.id for case in selected))
    return 0
  if args.overview:
    print(format_overview(selected))
    return 0
  if not selected:
    raise SmokeError("No case matches the selection")

  hasher = InputHasher()
  ensure_current_binary(current, args.no_build)
  current_results = run_snapshot(current, selected, args, hasher, args.check_determinism)
  baseline = baseline_results = None
  if not args.no_compare:
    baseline = resolve_against(args.against)
    ensure_baseline_binary(baseline)
    baseline_results = run_snapshot(baseline, selected, args, hasher, check_determinism=False)

  reports = build_reports(selected, current, current_results, baseline, baseline_results)
  report_dir = current.dir / "compare" / baseline.id if baseline else current.dir
  write_reports(reports, current, baseline, report_dir)
  write_last_run(current, reports, baseline)
  print_summary(reports, current, baseline, report_dir, time.perf_counter() - start)
  if len(reports) != len(selected):
    raise SmokeError(f"{len(selected)} cases selected, but {len(reports)} have results")
  return 0 if all(report.passed for report in reports) else 1


def build_matrix(root: Path) -> list[Case]:
  spec = load_case_spec(root / CASES_FILE)
  datasets = discover_datasets(root, spec)
  cases = [case for command, rows in spec.rows.items() for row in rows
           for case in row_cases(command, row, spec, datasets)]
  cases += config_cases(root, spec, datasets)
  cases += help_cases(spec)
  cases += cli_cases(spec)
  validate_matrix(cases)
  return cases


def load_case_spec(path: Path) -> CaseSpec:
  """Parse and check the case file, so that a typo fails with its location instead of silently dropping cases."""
  try:
    raw = tomllib.loads(path.read_text())
  except (OSError, tomllib.TOMLDecodeError) as error:
    raise SmokeError(f"Cannot read the case file {path.relative_to(PROJECT_ROOT)}: {error}") from error
  commands = {name: parse_command(name, table) for name, table in raw.pop("commands", {}).items()}
  sizes = {Size(name): parse_size(name, table) for name, table in check_keys(raw.pop("sizes", {}), SIZE_NAMES,
                                                                             "[sizes]").items()}
  if missing := [size.value for size in Size if size not in sizes]:
    raise SmokeError(f"[sizes] lacks the size classes {', '.join(missing)}")
  families = {name: parse_family(name, table) for name, table in raw.pop("families", {}).items()}
  help_table = check_keys(raw.pop("help", {}), {"subcommands"}, "[help]")
  config_table = check_keys(raw.pop("config", {}), {"pattern"}, "[config]")
  cli_rows = [check_keys(row, CLI_ROW_KEYS, "[[cli]]") for row in raw.pop("cli", [])]
  if unknown := sorted(raw.keys() - commands.keys()):
    raise SmokeError(f"The case file has rows for commands without a [commands.<name>] template: {', '.join(unknown)}")
  rows = {command: [check_keys(row, ROW_KEYS, f"[[{command}]]") for row in raw[command]] for command in raw}
  for command, command_rows in rows.items():
    if missing := [index for index, row in enumerate(command_rows) if "variant" not in row]:
      raise SmokeError(f"[[{command}]] row {missing[0] + 1} has no `variant`")
  return CaseSpec(sizes, families, commands, rows, tuple(help_table.get("subcommands", ())), cli_rows,
                  config_table.get("pattern"))


def check_keys(table: dict, allowed: set[str] | frozenset[str], where: str) -> dict:
  if unknown := sorted(table.keys() - allowed):
    raise SmokeError(f"{where} has unknown keys {', '.join(unknown)}; allowed: {', '.join(sorted(allowed))}")
  return table


def parse_command(name: str, table: dict) -> CommandTemplate:
  check_keys(table, {"args", "outputs", "selection"}, f"[commands.{name}]")
  return CommandTemplate(table.get("args", ""), tuple(table.get("outputs", ())), table.get("selection"))


def parse_size(name: str, table: dict) -> SizeClass:
  check_keys(table, {"max_sequences", "tier", "timeout"}, f"[sizes.{name}]")
  return SizeClass(table.get("max_sequences"), Tier(table["tier"]), float(table["timeout"]))


def parse_family(name: str, table: dict) -> Family:
  check_keys(table, {"metadata_args", "mugration_attribute", "command_args", "timeout_factor"}, f"[families.{name}]")
  command_args = {command: tuple(shlex.split(args)) for command, args in table.get("command_args", {}).items()}
  return Family(tuple(shlex.split(table.get("metadata_args", ""))), table.get("mugration_attribute"), command_args,
                float(table.get("timeout_factor", 1.0)))


def discover_datasets(root: Path, spec: CaseSpec) -> dict[str, Dataset]:
  datasets = {}
  for tree in sorted((root / DATA_DIR).glob("**/tree.nwk")):
    directory = tree.parent
    name = directory.relative_to(root / DATA_DIR).as_posix()
    family = directory.parent.relative_to(root / DATA_DIR).as_posix()
    if family not in spec.families:
      raise SmokeError(f"Dataset {name} has no family: add [families.\"{family}\"] to {CASES_FILE}")
    metadata = next((m.name for m in (directory / "metadata.tsv", directory / "metadata.tsv.xz") if m.exists()), None)
    columns = read_tsv_header(directory / metadata) if metadata else frozenset()
    datasets[name] = Dataset(name, size_class(spec, int(directory.name)), spec.families[family], metadata, columns)
  return datasets


def size_class(spec: CaseSpec, sequences: int) -> Size:
  return next(size for size in Size
              if spec.sizes[size].max_sequences is None or sequences <= spec.sizes[size].max_sequences)


def read_tsv_header(path: Path) -> frozenset[str]:
  with lzma.open(path, "rt") if path.suffix == ".xz" else path.open() as handle:
    header = handle.readline()
  return frozenset(column.strip().strip('"') for column in header.rstrip("\n").split("\t"))


def row_cases(command: str, row: dict, spec: CaseSpec, datasets: dict[str, Dataset]) -> list[Case]:
  args, _, where = row_arguments(command, row, spec)
  selected = select_datasets(row.get("datasets", "all"), args, datasets, where)
  expectations = {expect: expected_reasons(row.get(key), selected, f"{where} `{key}`")
                  for key, expect in (("fail", Expect.FAIL), ("hang", Expect.TIMEOUT))}
  if both := expectations[Expect.FAIL].keys() & expectations[Expect.TIMEOUT].keys():
    raise SmokeError(f"{where} declares both `fail` and `hang` for {', '.join(sorted(both))}")
  cases = []
  for dataset in selected:
    expect, reason = next(((expect, reasons[dataset.name]) for expect, reasons in expectations.items()
                           if dataset.name in reasons), (Expect.PASS, None))
    cases.append(make_case(command, row, dataset, spec, (expect, reason)))
  return cases


def row_arguments(command: str, row: dict, spec: CaseSpec) -> tuple[str, bool, str]:
  """Arguments of a row before placeholders are resolved, whether it replaces the template, and its location text."""
  standalone = row.get("standalone", False)
  args = row.get("args", "") if standalone else f"{spec.commands[command].args} {row.get('args', '')}"
  return args, standalone, f"[[{command}]] variant {row['variant']!r}"


def select_datasets(selector: str | list[str], args: str, datasets: dict[str, Dataset], where: str) -> list[Dataset]:
  """Datasets of a row: all of them or a size class, among those that provide the metadata the arguments use."""
  if isinstance(selector, list):
    if unknown := [name for name in selector if name not in datasets]:
      raise SmokeError(f"{where}: unknown datasets {', '.join(unknown)}")
    if lacking := [name for name in selector if not datasets[name].provides(args)]:
      raise SmokeError(f"{where}: datasets {', '.join(lacking)} lack the metadata or attribute the arguments use")
    return [datasets[name] for name in selector]
  if selector != "all" and selector not in SIZE_NAMES:
    raise SmokeError(f"{where}: `datasets` must be \"all\", a size class ({', '.join(sorted(SIZE_NAMES))}), or a list")
  return [dataset for dataset in datasets.values()
          if dataset.provides(args) and selector in ("all", dataset.size.value)]


def expected_reasons(value: str | dict | None, selected: list[Dataset], where: str) -> dict[str, str]:
  """Expected-failure reasons per dataset name, from one reason for the whole row or a table keyed by dataset."""
  if value is None:
    return {}
  if isinstance(value, str):
    return {dataset.name: value for dataset in selected}
  names = {dataset.name for dataset in selected}
  if unknown := sorted(value.keys() - names):
    raise SmokeError(f"{where} names datasets outside the row: {', '.join(unknown)}")
  return dict(value)


def make_case(command: str, row: dict, dataset: Dataset, spec: CaseSpec,
              expectation: tuple[Expect, str | None]) -> Case:
  template, (args, standalone, where) = spec.commands[command], row_arguments(command, row, spec)
  family = dataset.family
  tokens = shlex.split(args)
  tokens += [] if standalone or "{metadata}" not in template.args else list(family.metadata_args)
  tokens += list(family.command_args.get(command, ()))
  selection = row.get("selection", template.selection)
  tokens += [f"--output-selection={selection}"] if selection else []
  replacements = {
    "{dataset}": dataset.path, "{tree}": f"{dataset.path}/{row.get('tree', 'tree.nwk')}",
    "{metadata}": f"{dataset.path}/{dataset.metadata}", "{attribute}": dataset.attribute or "",
  }
  argv = [substitute(token, replacements) for token in tokens]
  placeholders = {match for token in argv for match in re.findall(r"\{[a-z_]+\}", token)}
  if unresolved := sorted(placeholders - RUNTIME_PLACEHOLDERS):
    raise SmokeError(f"{where}: unknown placeholders {', '.join(unresolved)}")
  variant = substitute(row["variant"], replacements)
  size = spec.sizes[dataset.size]
  return Case(
    id=f"{command}/{dataset.name}/{variant}", command=command, dataset=dataset.name, size=dataset.size,
    tier=Tier(row["tier"]) if "tier" in row else size.tier,
    timeout_s=float(row.get("timeout", size.timeout_s * family.timeout_factor)), argv=("{bin}", command, *argv),
    expect=expectation[0], reason=expectation[1],
    required_outputs=tuple(row.get("outputs", () if standalone else template.outputs)),
  )


def substitute(text: str, replacements: dict[str, str]) -> str:
  for placeholder, value in replacements.items():
    text = text.replace(placeholder, value)
  return text


def config_cases(root: Path, spec: CaseSpec, datasets: dict[str, Dataset]) -> list[Case]:
  if spec.config_pattern is None:
    return []
  cases = []
  for config in sorted((root / DATA_DIR).glob(f"**/{spec.config_pattern}")):
    dataset = datasets[config.parent.relative_to(root / DATA_DIR).as_posix()]
    command = "pipeline" if config.stem == "pipeline" else config.stem.split("-")[0]
    size = spec.sizes[dataset.size]
    cases.append(Case(
      id=f"config/{dataset.name}/{config.stem}", command="config", dataset=dataset.name, size=dataset.size,
      tier=size.tier, timeout_s=size.timeout_s * dataset.family.timeout_factor,
      argv=("{bin}", command, f"--config={dataset.path}/{config.name}"), cwd_mode=CwdMode.SANDBOX,
    ))
  return cases


def help_cases(spec: CaseSpec) -> list[Case]:
  size = spec.sizes[Size.SMALL]
  return [Case(id=f"help/{name}", command="help", dataset=None, size=Size.SMALL, tier=size.tier,
               timeout_s=size.timeout_s, argv=("{bin}", *argv), compare_stdout=True)
          for name, argv in [("global", ("--help",)), *((sub, (sub, "--help")) for sub in spec.help_subcommands)]]


def cli_cases(spec: CaseSpec) -> list[Case]:
  """Commands without a dataset: their printed text is compared, or for a sandbox case the files it writes."""
  size = spec.sizes[Size.SMALL]
  return [Case(id=f"cli/{row['variant']}", command="cli", dataset=None, size=Size.SMALL, tier=size.tier,
               timeout_s=size.timeout_s, argv=("{bin}", *shlex.split(row["args"])),
               expect=Expect.FAIL if "fail" in row else Expect.PASS, reason=row.get("fail"),
               compare_stdout=not row.get("sandbox", False),
               cwd_mode=CwdMode.SANDBOX if row.get("sandbox") else CwdMode.ROOT)
          for row in spec.cli_rows]


def validate_matrix(cases: list[Case]) -> None:
  duplicates = [case_id for case_id, count in Counter(case.id for case in cases).items() if count > 1]
  if duplicates:
    raise SmokeError(f"{len(duplicates)} duplicate case ids, first: {', '.join(sorted(duplicates)[:5])}")
  ids = sorted(case.id for case in cases)
  nested = [(a, b) for a, b in itertools.pairwise(ids) if b.startswith(a + "/")]
  if nested:
    raise SmokeError(f"Case id is a directory prefix of another case id: {nested[0][0]} and {nested[0][1]}")


def select_cases(cases: list[Case], tier: Tier, only: str | None, ids: set[str] | None) -> list[Case]:
  if ids is not None:
    selected = [case for case in cases if case.id in ids]
  else:
    selected = [case for case in cases if tier is Tier.FULL or case.tier is Tier.QUICK]
  if only:
    try:
      pattern = re.compile(only)
    except re.error as error:
      raise SmokeError(f"Invalid --only regex {only!r}: {error}") from error
    selected = [case for case in selected if pattern.search(case.id)]
  return selected


def format_overview(cases: list[Case]) -> str:
  """Cases per command and variant, with the datasets each variant runs on, for reading the matrix at a glance."""
  groups: dict[str, dict[str, list[Case]]] = defaultdict(lambda: defaultdict(list))
  for case in cases:
    groups[case.command][case.id.rsplit("/", 1)[-1]].append(case)
  lines = []
  for command, variants in sorted(groups.items()):
    lines.append(f"{command} ({sum(map(len, variants.values()))} cases)")
    for variant, items in sorted(variants.items()):
      names = [case.dataset or "-" for case in items]
      datasets = ", ".join(names) if len(names) <= 4 else f"{len(names)} datasets"
      expected = sum(1 for case in items if case.expect is not Expect.PASS)
      note = f"  [{expected} expected to fail]" if expected else ""
      lines.append(f"  {variant:<24} {datasets}{note}")
  return "\n".join(lines)


def last_failed_ids(current: Snapshot) -> set[str]:
  path = current.dir / "last-run.json"
  if not path.exists():
    runs = [json.loads(p.read_text()) for p in SNAPSHOTS_DIR.glob("*/last-run.json")]
    if not runs:
      raise SmokeError("--rerun-failed: no snapshot has a recorded run yet")
    return set(max(runs, key=lambda run: run["finished_at"])["failed"])
  return set(json.loads(path.read_text())["failed"])


def working_tree_snapshot() -> Snapshot:
  commit = git("rev-parse", "HEAD").decode().strip()
  short = short_commit(commit)
  if not git("status", "--porcelain").strip():
    return Snapshot(short, commit, None, None)
  digest = hashlib.sha256(git("diff", "HEAD", "--binary"))
  untracked = git("ls-files", "--others", "--exclude-standard", "-z").split(b"\0")
  for path in sorted(p for p in untracked if p):
    file = PROJECT_ROOT / os.fsdecode(path)
    content = os.fsencode(os.readlink(file)) if file.is_symlink() else file.read_bytes() if file.is_file() else b""
    digest.update(path + b"\0" + content)
  dirty = digest.hexdigest()[:10]
  return Snapshot(f"{short}+dirty-{dirty}", commit, dirty, None)


def resolve_against(against: str) -> Snapshot:
  if (SNAPSHOTS_DIR / against).is_dir():
    meta = json.loads((SNAPSHOTS_DIR / against / "snapshot.json").read_text())
    return Snapshot(against, meta["commit"], meta.get("dirty_hash"), meta.get("ref"))
  commit = git("rev-parse", "--verify", f"{against}^{{commit}}").decode().strip()
  return Snapshot(short_commit(commit), commit, None, against)


def prune_snapshots(current: Snapshot) -> None:
  if not SNAPSHOTS_DIR.is_dir():
    return
  for directory in sorted(SNAPSHOTS_DIR.iterdir()):
    if directory.is_dir() and "+dirty-" in directory.name and directory.name != current.id:
      shutil.rmtree(directory)
      print(directory.relative_to(PROJECT_ROOT))


def ensure_current_binary(snapshot: Snapshot, no_build: bool) -> None:
  if not no_build:
    log.info("Building the current binary for snapshot %s", snapshot.id)
    build_in_checkout(PROJECT_ROOT)
  binary = PROJECT_ROOT / ".out" / "treetime"
  if not binary.is_file():
    raise SmokeError(f"{binary.relative_to(PROJECT_ROOT)} does not exist: run without --no-build")
  prepare_snapshot(snapshot, binary)


def ensure_baseline_binary(snapshot: Snapshot) -> None:
  if snapshot.binary.is_file():
    return
  if snapshot.dirty_hash is not None:
    raise SmokeError(f"Snapshot {snapshot.id} has no binary and cannot be rebuilt: it is a dirty working tree")
  log.info("Building the baseline binary for %s (%s)", snapshot.ref or snapshot.commit, snapshot.id)
  SNAPSHOTS_DIR.mkdir(parents=True, exist_ok=True)
  staged = build_baseline_binary(snapshot)
  try:
    prepare_snapshot(snapshot, staged)
  finally:
    staged.unlink(missing_ok=True)


def build_baseline_binary(snapshot: Snapshot) -> Path:
  """Build the snapshot's commit in a detached worktree, so the current checkout is never disturbed."""
  checkout = WORKTREES_DIR / snapshot.id
  if checkout.exists():
    git("worktree", "remove", "--force", str(checkout))
  checkout.parent.mkdir(parents=True, exist_ok=True)
  git("worktree", "add", "--detach", "--force", str(checkout), snapshot.commit)
  try:
    staged = SNAPSHOTS_DIR / f".{snapshot.id}.treetime"
    shutil.copy2(build_in_checkout(checkout), staged)
    return staged
  finally:
    git("worktree", "remove", "--force", str(checkout))


def build_in_checkout(checkout: Path) -> Path:
  run_checked([*WRAPPER, *release_build_cmd(checkout)], cwd=checkout)
  binary = checkout / ".out" / "treetime"
  if not binary.is_file():
    raise SmokeError(f"The build did not produce {binary}")
  return binary


def release_build_cmd(checkout: Path) -> list[str]:
  """Pick the task runner of the checkout: the justfile, or the older dev/dev script."""
  if (checkout / "justfile").exists():
    return ["just", "br", "treetime"]
  return ["./dev/dev", "br", "treetime"]


def prepare_snapshot(snapshot: Snapshot, binary: Path) -> None:
  """Install the binary into the snapshot and drop stored cases produced by a different binary."""
  binary_sha = sha256_file(binary)
  meta = snapshot.read_meta()
  if meta is not None and meta.get("binary_sha256") != binary_sha:
    log.info("Binary of snapshot %s changed: deleting its stored cases", snapshot.id)
    shutil.rmtree(snapshot.dir / "cases", ignore_errors=True)
  snapshot.binary.parent.mkdir(parents=True, exist_ok=True)
  if binary.resolve() != snapshot.binary.resolve():
    shutil.copy2(binary, snapshot.binary)
  write_json(snapshot.dir / "snapshot.json", {
    "commit": snapshot.commit, "dirty_hash": snapshot.dirty_hash, "ref": snapshot.ref, "binary_sha256": binary_sha,
    "created_at": (meta or {}).get("created_at") or now_iso(),
  })


def run_snapshot(snapshot: Snapshot, cases: list[Case], args: argparse.Namespace, hasher: InputHasher,
                 check_determinism: bool) -> dict[str, dict]:
  """Run every selected case of a snapshot whose stored result is not reusable, and return all results."""
  pending = []
  for case in cases:
    key = case_key(case, hasher)
    scaled = dataclasses.replace(case, timeout_s=case.timeout_s * args.timeout_scale)
    stored = read_result(snapshot, case.id)
    run_main = args.rerun or not is_reusable(stored, key, scaled.timeout_s)
    if run_main or (check_determinism and stored["determinism"] is None):
      pending.append({"case": scaled.to_json(), "case_key": key, "run_main": run_main,
                      "memory_kib": memory_estimate_kib(case)})
  pending.sort(key=lambda task: -(task["memory_kib"] if task["memory_kib"] is not None else float("inf")))
  log.info("Snapshot %s: %d cases selected, %d to run", snapshot.id, len(cases), len(pending))
  if pending:
    cases_file = snapshot.dir / "pending-cases.json"
    write_json(cases_file, pending)
    command = [*WRAPPER, "python3", SELF, "--run-cases", "--bin", str(snapshot.binary), "--snapshot", str(snapshot.dir),
               "--cases", str(cases_file), "--jobs", str(args.jobs)]
    if args.memory_budget is not None:
      command += ["--memory-budget", str(args.memory_budget)]
    if check_determinism:
      command.append("--check-determinism")
    try:
      run_checked(command)
    finally:
      cases_file.unlink(missing_ok=True)
  results = {case.id: read_result(snapshot, case.id) for case in cases}
  missing = sorted(case_id for case_id, result in results.items() if result is None)
  if missing:
    raise SmokeError(f"Snapshot {snapshot.id}: {len(missing)} cases have no result, first: {missing[0]}")
  return results


def memory_estimate_kib(case: Case) -> int | None:
  """Memory to reserve for a case: the largest peak of its completed runs in any snapshot, with a margin.

  None means the case runs alone. A case without a completed run has an unknown peak when it runs on a large dataset,
  or when an earlier run timed out or was stopped by a signal, for example by the out-of-memory killer.
  """
  results = [json.loads(path.read_text()) for path in SNAPSHOTS_DIR.glob(f"*/cases/{case.id}/result.json")]
  completed = [result["max_rss_kb"] for result in results if not result["timed_out"] and result["exit_code"] >= 0]
  if completed:
    return round(max(completed) * MEMORY_MARGIN)
  estimate_gib = MEMORY_ESTIMATE_GIB.get(case.size)
  return None if results or estimate_gib is None else round(estimate_gib * 1024 * 1024)


def case_key(case: Case, hasher: InputHasher) -> str:
  payload = {
    "argv": list(case.argv), "expect": case.expect.value, "required_outputs": list(case.required_outputs),
    "cwd_mode": case.cwd_mode.value, "inputs": hasher.inputs(case),
  }
  return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()


def read_result(snapshot: Snapshot, case_id: str) -> dict | None:
  path = snapshot.case_dir(case_id) / "result.json"
  return json.loads(path.read_text()) if path.exists() else None


def is_reusable(result: dict | None, key: str, timeout_s: float) -> bool:
  """A stored result is reusable when its inputs are unchanged and it would not differ under the new timeout."""
  if result is None or result["case_key"] != key:
    return False
  if result["timed_out"]:
    return result["timeout_s"] >= timeout_s
  return result["wall_s"] <= timeout_s


def effective_status(result: dict) -> Status:
  status = Status(result["status"])
  if status is Status.OK and result.get("determinism") == "differs":
    return Status.NONDETERMINISTIC
  return status


def run_cases_mode(args: argparse.Namespace) -> int:
  tasks = json.loads(Path(args.cases).read_text())
  binary = Path(args.bin).resolve()
  snapshot_dir = Path(args.snapshot).resolve()
  jobs = max(1, args.jobs)
  budget_kib = round(args.memory_budget * 1024 * 1024) if args.memory_budget else default_memory_budget_kib()
  memory = MemoryBudget(budget_kib)
  log.info("Running %d cases with %d jobs and a memory budget of %.1f GiB", len(tasks), jobs, budget_kib / 1024**2)
  tty = sys.stderr.isatty()
  done = 0
  with ThreadPoolExecutor(max_workers=jobs) as pool:
    futures = {pool.submit(run_case_task, task, binary, snapshot_dir, args.check_determinism, memory): task
               for task in tasks}
    for future in as_completed(futures):
      result = future.result()
      done += 1
      status = effective_status(result)
      if tty:
        sys.stderr.write(CLEAR_LINE)
      if status not in PASSING_STATUSES:
        log.warning("%-17s %7.1fs  %s  %s", status.value, result["wall_s"], result["id"], result["detail"])
      if tty:
        sys.stderr.write(f"[{done}/{len(tasks)}] {result['id']}")
        sys.stderr.flush()
  if tty:
    sys.stderr.write(CLEAR_LINE)
  return 0


def default_memory_budget_kib() -> int:
  """A fraction of the memory available at start, leaving room for the host and the other processes on it."""
  meminfo = Path("/proc/meminfo").read_text()
  available_kib = int(re.search(r"^MemAvailable:\s+(\d+) kB", meminfo, re.MULTILINE).group(1))
  return round(available_kib * MEMORY_BUDGET_FRACTION)


def run_case_task(task: dict, binary: Path, snapshot_dir: Path, check_determinism: bool,
                  memory: MemoryBudget) -> dict:
  case = Case.from_json(task["case"])
  case_dir = snapshot_dir / "cases" / case.id
  extra = [] if case.is_help else ["--no-progress"]
  with memory.reserve(task["memory_kib"]):
    if not task["run_main"]:
      result = json.loads((case_dir / "result.json").read_text())
    else:
      outcome, missing = run_one(case, binary, case_dir, extra, memory.total_kib)
      status, detail = classify(case, outcome, missing)
      result = {
        "id": case.id, "status": status.value, "detail": detail, "exit_code": outcome.exit_code,
        "timed_out": outcome.timed_out, "timeout_s": case.timeout_s, "wall_s": round(outcome.wall_s, 3),
        "cpu_s": round(outcome.cpu_s, 3), "max_rss_kb": outcome.max_rss_kb, "case_key": task["case_key"],
        "expect": case.expect.value, "determinism": None,
      }
    if check_determinism:
      rerun_extra = extra + ([] if case.is_help else ["--jobs=1"])
      rerun_outcome, rerun_missing = run_one(case, binary, case_dir / "rerun", rerun_extra, memory.total_kib)
      rerun_status, _ = classify(case, rerun_outcome, rerun_missing)
      same = rerun_status.value == result["status"] and not diff_run_dirs(case, case_dir, case_dir / "rerun")
      result["determinism"] = "same" if same else "differs"
  write_json(case_dir / "result.json", result)
  return result


def run_one(case: Case, binary: Path, run_dir: Path, extra_args: list[str],
            memory_limit_kib: int) -> tuple[RunOutcome, list[str]]:
  """Run a case into run_dir (out/, stdout.txt, stderr.txt, cmd.sh) and return the outcome and missing outputs."""
  shutil.rmtree(run_dir, ignore_errors=True)
  out = run_dir / "out"
  out.mkdir(parents=True)
  argv = resolve_argv(case, binary, out) + extra_args
  data = PROJECT_ROOT / DATA_DIR
  if case.cwd_mode is CwdMode.SANDBOX:
    cwd = run_dir / "sandbox"
    cwd.mkdir()
    (cwd / DATA_DIR).symlink_to(data)
    script = (f'sandbox="$(mktemp -d)"\nln -s {shlex.quote(str(data))} "$sandbox/{DATA_DIR}"\ncd "$sandbox"\n'
              f"RUST_BACKTRACE=1 NO_COLOR=1 exec {shlex.join(argv)}\n")
  else:
    cwd = PROJECT_ROOT
    script = f"RUST_BACKTRACE=1 NO_COLOR=1 exec {shlex.join(argv)}\n"
  (run_dir / "cmd.sh").write_text(f"#!/usr/bin/env bash\nset -euo pipefail\nulimit -d {memory_limit_kib}\n{script}")
  (run_dir / "cmd.sh").chmod(0o755)
  outcome = execute(argv, cwd, run_dir / "stdout.txt", run_dir / "stderr.txt", case.timeout_s,
                    memory_limit_kib=memory_limit_kib)
  if case.cwd_mode is CwdMode.SANDBOX:
    (cwd / DATA_DIR).unlink()
    for entry in cwd.iterdir():
      shutil.move(str(entry), out / entry.name)
    cwd.rmdir()
  return outcome, missing_outputs(case, run_dir)


def resolve_argv(case: Case, binary: Path, out: Path) -> list[str]:
  replacements = {"{bin}": str(binary), "{data}": DATA_DIR, "{out}": str(out)}
  argv = []
  for arg in case.argv:
    for placeholder, value in replacements.items():
      arg = arg.replace(placeholder, value)
    argv.append(arg)
  return argv


def execute(argv: list[str], cwd: Path, stdout: Path, stderr: Path, timeout_s: float,
            *, memory_limit_kib: int) -> RunOutcome:
  """Run one process with a timeout and a data-segment limit, and measure its wall time, CPU time and peak memory.

  The limit turns an allocation beyond the memory budget into an allocation failure of that process, so a case that
  needs more memory than the machine can give fails on its own instead of exhausting the host.
  """
  env = {**os.environ, "RUST_BACKTRACE": "1", "NO_COLOR": "1"}
  lock = threading.Lock()
  state = {"exited": False, "timed_out": False}
  with stdout.open("wb") as out, stderr.open("wb") as err:
    start = time.perf_counter()
    process = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=out, stderr=err, env=env)
  limit_bytes = memory_limit_kib * 1024
  with contextlib.suppress(ProcessLookupError):
    resource.prlimit(process.pid, resource.RLIMIT_DATA, (limit_bytes, limit_bytes))

  def stop_on_timeout() -> None:
    with lock:
      if not state["exited"]:
        state["timed_out"] = True
        os.kill(process.pid, signal.SIGKILL)

  timer = threading.Timer(timeout_s, stop_on_timeout)
  timer.start()
  # Wait without reaping first, so the timer can never signal a reused pid.
  os.waitid(os.P_PID, process.pid, os.WEXITED | os.WNOWAIT)
  with lock:
    state["exited"] = True
  timer.cancel()
  _, wait_status, usage = os.wait4(process.pid, 0)
  wall = time.perf_counter() - start
  process.returncode = os.waitstatus_to_exitcode(wait_status)
  return RunOutcome(
    exit_code=None if state["timed_out"] else process.returncode, timed_out=state["timed_out"], wall_s=wall,
    cpu_s=usage.ru_utime + usage.ru_stime, max_rss_kb=usage.ru_maxrss,
  )


def missing_outputs(case: Case, run_dir: Path) -> list[str]:
  out = run_dir / "out"
  missing = [name for name in case.required_outputs if not non_empty(out / name)]
  if case.writes_output_dir and not any(non_empty(p) for p in out.rglob("*")):
    missing.append("out/ has no non-empty file")
  if case.compare_stdout and not non_empty(run_dir / "stdout.txt"):
    missing.append("stdout.txt")
  return missing


def non_empty(path: Path) -> bool:
  return path.is_file() and path.stat().st_size > 0


def classify(case: Case, outcome: RunOutcome, missing: list[str]) -> tuple[Status, str]:
  """Derive the status of a run from its exit code, timeout and declared outputs, given the case expectation."""
  missing_detail = f"missing or empty: {', '.join(missing)}"
  if case.expect is Expect.PASS:
    if outcome.timed_out:
      return Status.TIMEOUT, f"exceeded the {case.timeout_s:g}s timeout"
    if outcome.exit_code != 0:
      return Status.FAILED, exit_detail(outcome.exit_code)
    if missing:
      return Status.MISSING_OUTPUT, missing_detail
    return Status.OK, ""
  expected = f"expected {case.expect.value} ({case.reason})"
  if case.expect is Expect.FAIL and outcome.exit_code not in (0, None):
    return Status.XFAIL, f"{exit_detail(outcome.exit_code)}, {expected}"
  if case.expect is Expect.TIMEOUT and outcome.timed_out:
    return Status.XFAIL, f"timed out, {expected}"
  if outcome.timed_out:
    return Status.FAILED, f"timed out, but {expected}"
  if outcome.exit_code != 0:
    return Status.FAILED, f"{exit_detail(outcome.exit_code)}, but {expected}"
  if missing:
    return Status.MISSING_OUTPUT, f"{missing_detail}, {expected}"
  return Status.XPASS, f"passed, but {expected}: remove the expectation"


def exit_detail(exit_code: int | None) -> str:
  if exit_code is not None and exit_code < 0:
    return f"stopped by signal {signal.Signals(-exit_code).name}"
  return f"exit code {exit_code}"


def build_reports(cases: list[Case], current: Snapshot, current_results: dict[str, dict], baseline: Snapshot | None,
                  baseline_results: dict[str, dict] | None) -> list[CaseReport]:
  reports = []
  for case in cases:
    result = current_results[case.id]
    status = effective_status(result)
    report = CaseReport(case, None, status, None, result["wall_s"], None, result["detail"],
                        stderr_line=first_error_line(current.case_dir(case.id)))
    if status is Status.NONDETERMINISTIC:
      report.diffs = diff_run_dirs(case, current.case_dir(case.id), current.case_dir(case.id) / "rerun")
      report.detail = "the --jobs=1 rerun produced different outputs"
    if baseline is not None and baseline_results is not None:
      base = baseline_results[case.id]
      report.baseline_status = effective_status(base)
      report.baseline_wall_s = base["wall_s"]
      report.category = categorize(status, report.baseline_status)
      if report.category is Category.IDENTICAL:
        report.diffs = diff_run_dirs(case, baseline.case_dir(case.id), current.case_dir(case.id))
        if report.diffs:
          report.category = Category.CHANGED
          report.detail = f"{len(report.diffs)} files differ, first: {report.diffs[0].path} ({report.diffs[0].summary})"
      elif report.category is Category.FIXED:
        report.detail = f"baseline {report.baseline_status.value}; outputs not compared"
      elif report.category is Category.REGRESSED:
        report.detail = f"{status.value}: {result['detail']}"
      elif report.category is Category.STILL_FAILING:
        report.detail = f"current {status.value}, baseline {report.baseline_status.value}: {result['detail']}"
    reports.append(report)
  return reports


def categorize(status: Status, baseline: Status) -> Category:
  if status is Status.XFAIL:
    return Category.EXPECTED_FAILURE
  if status is Status.XPASS:
    return Category.UNEXPECTED_PASS
  base_passed = baseline in (Status.OK, Status.XPASS)
  if status is Status.OK and base_passed:
    return Category.IDENTICAL
  if base_passed:
    return Category.REGRESSED
  if status is Status.OK:
    return Category.FIXED
  return Category.STILL_FAILING


def diff_run_dirs(case: Case, base_dir: Path, current_dir: Path) -> list[FileDiff]:
  base_files = compared_files(case, base_dir)
  current_files = compared_files(case, current_dir)
  diffs = []
  for name in sorted(base_files.keys() | current_files.keys()):
    if name not in current_files:
      diffs.append(FileDiff(name, "only-baseline", "only in the baseline"))
    elif name not in base_files:
      diffs.append(FileDiff(name, "only-current", "only in the current run"))
    else:
      old, new = normalized_bytes(base_files[name]), normalized_bytes(current_files[name])
      if old != new:
        diffs.append(content_diff(name, old, new))
  return diffs


def compared_files(case: Case, run_dir: Path) -> dict[str, Path]:
  out = run_dir / "out"
  files = {p.relative_to(out).as_posix(): p for p in out.rglob("*") if p.is_file()} if out.is_dir() else {}
  if case.compare_stdout:
    files["<stdout>"] = run_dir / "stdout.txt"
  return files


def normalized_bytes(path: Path) -> bytes:
  """File content with the volatile fields removed; JSON files of those types are parsed and re-serialized."""
  data = path.read_bytes()
  key_path = next((keys for suffix, keys in VOLATILE_FIELDS.items() if path.name.endswith(suffix)), None)
  if key_path is None:
    return data
  try:
    doc = json.loads(data)
  except ValueError:
    return data
  node = doc
  for key in key_path[:-1]:
    node = node.get(key) if isinstance(node, dict) else None
  if isinstance(node, dict):
    node.pop(key_path[-1], None)
  return json.dumps(doc, indent=2, ensure_ascii=False).encode()


def content_diff(name: str, old: bytes, new: bytes) -> FileDiff:
  if name.endswith(".json"):
    try:
      return json_diff(name, json.loads(old), json.loads(new))
    except ValueError:
      pass
  try:
    return text_diff(name, old.decode(), new.decode())
  except UnicodeDecodeError:
    summary = (f"binary: {len(old)} B sha256 {hashlib.sha256(old).hexdigest()[:12]} -> "
               f"{len(new)} B sha256 {hashlib.sha256(new).hexdigest()[:12]}")
    return FileDiff(name, "binary", summary)


def json_diff(name: str, old, new) -> FileDiff:
  leaves = json_leaf_diffs(old, new)
  if not leaves:
    return FileDiff(name, "json", "key order or formatting only")
  lines = [f"{path}: {json.dumps(a)[:120]} -> {json.dumps(b)[:120]}" for path, a, b in leaves[:MAX_DIFF_ITEMS]]
  if all(is_number(a) and is_number(b) for _, a, b in leaves):
    summary = numeric_summary([(float(a), float(b)) for _, a, b in leaves])
    kind = "numeric"
  else:
    summary = f"structural: {len(leaves)} JSON values differ"
    kind = "structural"
  return FileDiff(name, kind, summary, lines, first_path=leaves[0][0])


def json_leaf_diffs(old, new, path: str = "") -> list[tuple[str, object, object]]:
  if isinstance(old, dict) and isinstance(new, dict):
    diffs = []
    for key in [*old, *(k for k in new if k not in old)]:
      sub = f"{path}.{key}" if path else str(key)
      diffs += json_leaf_diffs(old.get(key, "<absent>"), new.get(key, "<absent>"), sub)
    return diffs
  if isinstance(old, list) and isinstance(new, list):
    diffs = []
    for index in range(max(len(old), len(new))):
      diffs += json_leaf_diffs(old[index] if index < len(old) else "<absent>",
                               new[index] if index < len(new) else "<absent>", f"{path}[{index}]")
    return diffs
  if old == new and type(old) is type(new):
    return []
  return [(path or "<root>", old, new)]


def is_number(value) -> bool:
  return isinstance(value, (int, float)) and not isinstance(value, bool)


def text_diff(name: str, old: str, new: str) -> FileDiff:
  old_lines, new_lines = old.splitlines(), new.splitlines()
  if len(old_lines) == len(new_lines):
    pairs = []
    structural = False
    for a, b in zip(old_lines, new_lines, strict=True):
      if a == b:
        continue
      if NUMBER_RE.split(a) != NUMBER_RE.split(b):
        structural = True
        break
      pairs += [(float(x), float(y)) for x, y in zip(NUMBER_RE.findall(a), NUMBER_RE.findall(b), strict=True) if x != y]
    if not structural and pairs:
      return FileDiff(name, "numeric", numeric_summary(pairs), numeric_examples(old_lines, new_lines))
  diff = [line for line in list(difflib.unified_diff(old_lines, new_lines, n=0, lineterm=""))[2:]
          if not line.startswith("@@")]
  removed = sum(1 for line in diff if line.startswith("-"))
  summary = f"structural: {removed} lines removed, {len(diff) - removed} added"
  return FileDiff(name, "structural", summary,
                  [clip(line) for line in diff[:MAX_DIFF_ITEMS]])


def numeric_summary(pairs: list[tuple[float, float]]) -> str:
  abs_diffs = [abs(a - b) for a, b in pairs]
  rel_diffs = [abs(a - b) / max(abs(a), abs(b)) for a, b in pairs if max(abs(a), abs(b)) > 0]
  return (f"numeric only: {len(pairs)} values changed, max abs diff {max(abs_diffs):.3g}, "
          f"max rel diff {max(rel_diffs, default=0.0):.3g}")


def numeric_examples(old_lines: list[str], new_lines: list[str]) -> list[str]:
  examples = []
  for number, (a, b) in enumerate(zip(old_lines, new_lines, strict=True), start=1):
    for x, y in zip(NUMBER_RE.findall(a), NUMBER_RE.findall(b), strict=False):
      if x != y:
        examples.append(f"line {number}: {x} -> {y}")
        if len(examples) >= MAX_DIFF_ITEMS:
          return examples
  return examples


def clip(line: str, width: int = 200) -> str:
  return line if len(line) <= width else f"{line[:width]}... ({len(line)} chars)"


def first_error_line(run_dir: Path) -> str | None:
  """First stderr line that names an error or panic; for a bare `Error:` header, the message line after it."""
  path = run_dir / "stderr.txt"
  if not path.is_file():
    return None
  text = ANSI_ESCAPE_RE.sub("", path.read_text(errors="replace"))
  lines = [line.strip() for line in text.splitlines() if line.strip()]
  for index, line in enumerate(lines):
    if ERROR_LINE_RE.search(line):
      message = lines[index + 1] if line.rstrip(":") == "Error" and index + 1 < len(lines) else line
      return clip(message, 160)
  return None


def write_reports(reports: list[CaseReport], current: Snapshot, baseline: Snapshot | None, report_dir: Path) -> None:
  report_dir.mkdir(parents=True, exist_ok=True)
  rows = ["id\tcategory\tcommand\tdataset\twall_s\tbaseline_wall_s\tdetail"]
  for r in reports:
    base_wall = "" if r.baseline_wall_s is None else f"{r.baseline_wall_s:.2f}"
    detail = r.detail.replace("\t", " ").replace("\n", " ")
    fields = [r.case.id, r.label, r.case.command, r.case.dataset or "", f"{r.wall_s:.2f}", base_wall, detail]
    rows.append("\t".join(fields))
  (report_dir / "report.tsv").write_text("\n".join(rows) + "\n")

  counts = Counter(r.label for r in reports)
  md = [f"# Smoke run of `{current.id}`" + (f" against `{baseline.id}`" if baseline else ""), ""]
  if baseline:
    md += [f"Baseline: `{baseline.id}`" + (f" (`{baseline.ref}`)" if baseline.ref else ""), ""]
  md += ["| Result | Cases |", "| --- | ---: |"]
  md += [f"| {label} | {count} |" for label, count in sorted(counts.items())]
  md += [""]
  groups = cause_groups(reports)
  if groups:
    md += ["## Cause groups", ""]
    for sig, items in groups:
      md.append(f"- **{len(items)}** `{format_signature(sig)}`: " + ", ".join(f"`{r.case.id}`" for r in items[:5]))
    md += [""]
  failing = [r for r in reports if not r.passed]
  if failing:
    md += ["## Cases", ""]
  for r in failing:
    case_dir = current.case_dir(r.case.id).relative_to(PROJECT_ROOT)
    md += [f"### `{r.case.id}`: {r.label}", "", f"- Detail: {r.detail}", f"- Command: `{case_dir}/cmd.sh`"]
    if r.stderr_line:
      md.append(f"- stderr: `{r.stderr_line}`")
    for diff in r.diffs:
      md.append(f"- `{diff.path}`: {diff.summary}")
      if diff.lines:
        md += ["", "  ```", *[f"  {line}" for line in diff.lines], "  ```", ""]
    md.append("")
  (report_dir / "report.md").write_text("\n".join(md))


def print_summary(reports: list[CaseReport], current: Snapshot, baseline: Snapshot | None, report_dir: Path,
                  elapsed_s: float) -> None:
  labels = [c.value for c in Category] if baseline else [s.value for s in Status]
  counts = Counter(report.label for report in reports)
  title = f"Comparison of {current.id} with {baseline.id}" if baseline else f"Statuses of {current.id}"
  print(f"\n{title}: {len(reports)} cases in {elapsed_s:.0f}s")
  for label in labels:
    if counts[label]:
      print(f"  {label:<18} {counts[label]}")
  by_command: dict[str, list[CaseReport]] = defaultdict(list)
  for report in reports:
    by_command[report.case.command].append(report)
  print("\nPer command:")
  for command, items in sorted(by_command.items()):
    failing = sum(1 for r in items if not r.passed)
    print(f"  {command:<12} {len(items):4} cases  {len(items) - failing:4} pass  {failing:4} fail")
  groups = cause_groups(reports)
  if groups:
    print("\nCause groups:")
    for sig, items in groups[:15]:
      examples = ", ".join(r.case.id for r in items[:3])
      print(f"  {len(items):4}  {format_signature(sig)}\n        e.g. {examples}")
    if len(groups) > 15:
      print(f"  ... {len(groups) - 15} more groups in the report")
  print("\nSlowest cases (information only):")
  for report in sorted(reports, key=lambda r: r.wall_s, reverse=True)[:10]:
    change = ""
    if report.baseline_wall_s is not None and report.baseline_wall_s >= 1.0:
      change = f" ({(report.wall_s - report.baseline_wall_s) / report.baseline_wall_s * 100:+.0f}% vs baseline)"
    print(f"  {report.wall_s:7.1f}s{change}  {report.case.id}")
  print(f"\nCurrent snapshot:  {current.dir.relative_to(PROJECT_ROOT)}")
  if baseline:
    print(f"Baseline snapshot: {baseline.dir.relative_to(PROJECT_ROOT)}")
  print(f"Report:            {(report_dir / 'report.md').relative_to(PROJECT_ROOT)}")


def cause_groups(reports: list[CaseReport]) -> list[tuple[tuple[str, ...], list[CaseReport]]]:
  groups: dict[tuple[str, ...], list[CaseReport]] = defaultdict(list)
  for report in reports:
    if not report.passed:
      groups[signature(report)].append(report)
  return sorted(groups.items(), key=lambda item: (-len(item[1]), item[0]))


def signature(report: CaseReport) -> tuple[str, ...]:
  """Cause of a failing case: many failures with the same signature most likely share one cause."""
  if report.diffs:
    first = report.diffs[0]
    detail = mask_numbers(first.first_path) if first.first_path else first.kind
    return report.label, report.case.command, first.path, detail
  return report.label, report.case.command, "", mask_numbers(report.stderr_line or report.status.value)


def mask_numbers(text: str) -> str:
  return NUMBER_RE.sub("N", text)


def format_signature(sig: tuple[str, ...]) -> str:
  return "  ".join(part for part in sig if part)


def write_last_run(snapshot: Snapshot, reports: list[CaseReport], baseline: Snapshot | None) -> None:
  write_json(snapshot.dir / "last-run.json", {
    "finished_at": now_iso(), "against": baseline.id if baseline else None,
    "failed": sorted(r.case.id for r in reports if not r.passed),
  })


def git(*args: str, cwd: Path = PROJECT_ROOT) -> bytes:
  result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, check=False)
  if result.returncode != 0:
    raise SmokeError(f"git {shlex.join(args)} failed: {result.stderr.decode(errors='replace').strip()}")
  return result.stdout


def short_commit(rev: str) -> str:
  return git("rev-parse", "--short=10", rev).decode().strip()


def run_checked(command: list[str], cwd: Path = PROJECT_ROOT) -> None:
  log.info("+ %s", shlex.join(command))
  result = subprocess.run(command, cwd=cwd, check=False)
  if result.returncode != 0:
    raise SmokeError(f"Command failed with exit code {result.returncode}: {shlex.join(command)} (in {cwd})")


def sha256_file(path: Path) -> str:
  digest = hashlib.sha256()
  with path.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1 << 20), b""):
      digest.update(chunk)
  return digest.hexdigest()


def write_json(path: Path, data) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  temporary = path.with_name(f".{path.name}.tmp")
  temporary.write_text(json.dumps(data, indent=2) + "\n")
  os.replace(temporary, path)


def now_iso() -> str:
  return datetime.now(timezone.utc).isoformat(timespec="seconds")


def enum_value(value):
  if isinstance(value, Enum):
    return value.value
  if isinstance(value, tuple):
    return list(value)
  return value


class SmokeError(Exception):
  """A failure that prevents the script from completing (exit code 2)."""


@dataclass(frozen=True)
class Case:
  id: str
  command: str
  dataset: str | None
  size: Size
  tier: Tier
  timeout_s: float
  argv: tuple[str, ...]
  expect: Expect = Expect.PASS
  reason: str | None = None
  required_outputs: tuple[str, ...] = ()
  compare_stdout: bool = False
  cwd_mode: CwdMode = CwdMode.ROOT

  def __post_init__(self) -> None:
    if (self.expect is Expect.PASS) != (self.reason is None):
      raise ValueError(f"{self.id}: `reason` is required exactly when `expect` is not PASS")

  @property
  def is_help(self) -> bool:
    return self.command == "help"

  @property
  def writes_output_dir(self) -> bool:
    return self.cwd_mode is CwdMode.SANDBOX or "--output-all={out}" in self.argv

  def to_json(self) -> dict:
    return {f.name: enum_value(getattr(self, f.name)) for f in dataclasses.fields(self)}

  @staticmethod
  def from_json(data: dict) -> Case:
    return Case(
      id=data["id"], command=data["command"], dataset=data["dataset"], size=Size(data["size"]),
      tier=Tier(data["tier"]), timeout_s=data["timeout_s"], argv=tuple(data["argv"]),
      expect=Expect(data["expect"]), reason=data["reason"], required_outputs=tuple(data["required_outputs"]),
      compare_stdout=data["compare_stdout"], cwd_mode=CwdMode(data["cwd_mode"]),
    )


