class InputHasher:
  """SHA-256 of input files, computed once per file."""

  def __init__(self) -> None:
    self.cache: dict[Path, str] = {}

  def file(self, path: Path) -> str:
    if path not in self.cache:
      self.cache[path] = sha256_file(path)
    return self.cache[path]

  def inputs(self, case: Case) -> dict[str, str]:
    paths: set[Path] = set()
    if case.dataset:
      paths.update(p for p in (PROJECT_ROOT / DATA_DIR / case.dataset).rglob("*") if p.is_file())
    for arg in case.argv:
      for match in re.finditer(r"\{data\}/([^\s,=]+)", arg):
        path = PROJECT_ROOT / DATA_DIR / match.group(1)
        if not path.is_file():
          raise SmokeError(f"{case.id}: input file {path.relative_to(PROJECT_ROOT)} does not exist")
        paths.add(path)
    return {p.relative_to(PROJECT_ROOT).as_posix(): self.file(p) for p in sorted(paths)}


class MemoryBudget:
  """Memory reservations of the running cases, granted in request order.

  A reservation waits until it fits into the free budget. A reservation of None, or one larger than the budget, waits
  until no other case runs. Granting in request order keeps a large reservation from waiting behind a stream of
  small ones.
  """

  def __init__(self, total_kib: int) -> None:
    self.total_kib = total_kib
    self.used_kib = 0
    self.running = 0
    self.queue: deque[object] = deque()
    self.condition = threading.Condition()

  @contextlib.contextmanager
  def reserve(self, kib: int | None):
    amount = self.total_kib if kib is None else min(kib, self.total_kib)
    ticket = object()
    with self.condition:
      self.queue.append(ticket)
      self.condition.wait_for(lambda: self.queue[0] is ticket and (self.running == 0 or
                                                                   self.used_kib + amount <= self.total_kib))
      self.queue.popleft()
      self.used_kib += amount
      self.running += 1
      self.condition.notify_all()
    try:
      yield
    finally:
      with self.condition:
        self.used_kib -= amount
        self.running -= 1
        self.condition.notify_all()


