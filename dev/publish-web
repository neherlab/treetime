#!/usr/bin/env bash
#
# Usage: $0 [options] <site>...
#
# Upload a static build, by default the production build of the web2 app (`just
# build-web2`), to each site of the preview host, then clear the cache of the
# host. Each site is a folder of the S3 bucket, and the CloudFront distribution in
# front of the bucket serves it at https://<site>.previews.neherlab.click. The
# production sites are also served on their own hosts: `treetime` at
# https://treetime.neherlab.click, and the docs site `treetime-docs` at
# https://docs.treetime.neherlab.click. A site name is lowercased, every
# character other than a-z, 0-9, and `-` becomes `-`, and the name is cut to the
# 63 characters of a DNS label.
#
# The edge functions of the distribution (AWS account preview-deployments, not in
# this repository) map the first label of the host name to the folder of the same
# name, serve `index` for `/`, and for sites whose name starts with
# `neherlab--treetime--` or equals `treetime`, serve `index` for every path
# without a file extension outside `data/`, add the cross-origin isolation
# headers that the threaded WebAssembly module needs, and leave the content
# security policy to the page. The docs sites (`treetime-docs` and
# `neherlab--treetime-docs--<suffix>`) fall outside these rules and are served as
# plain files. Each docs build is a version folder of its site (`--prefix dev`),
# and the site root holds `versions.json` and an `index` page that leads to the
# preferred version.
#
# Every file is stored under its path in the build, except `*.html`, which loses
# its extension, so `index.html` is the object `index`. A file with a `.gz` copy
# from the build is stored as that copy with `Content-Encoding: gzip`; the `.gz`
# and `.br` copies are not stored themselves. Files in `assets/` whose names
# carry a content hash are cached for a year, every other file is revalidated on
# each use. The pages of a site are stored after all other files, so a page never
# refers to a file that is not stored yet. Files that a previous upload stored and
# this build lacks stay, so open pages of the previous version keep working.
#
# The build is uploaded once, to the first site, one file per `aws s3 cp` call.
# Every other site gets copies of exactly these files from the first site inside
# the bucket, which keep their content type, encoding, and cache control and take
# one call per site; a site whose copy fails gets the upload instead.
#
# Options:
#   -h, --help         Show this help
#   --dist <dir>       Build to upload (default: packages/app-web2/dist)
#   --prefix <folder>  Store the build below <site>/<folder>/ instead of the site
#                      root, and its root page also as the object <folder>, so
#                      /<folder> serves it; other folders and the site root stay
#   --label <text>     Heading of the site list in the GitHub step summary
#                      (default: Web app)
#
# Environment:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY   Credentials that may write the
#                                              bucket and clear the cache
#   AWS_DEFAULT_REGION                         Region of the bucket
#   AWS_S3_BUCKET                              Bucket of the sites
#   AWS_CLOUDFRONT_DISTRIBUTION_ID             Distribution in front of the bucket
#
# Examples:
#   $0 neherlab--treetime--branch-rust treetime
#   $0 --dist packages/app-docs/dist --prefix dev --label Docs treetime-docs
#
set -euo pipefail
shopt -s inherit_errexit
trap "exit" INT

PREVIEWS_DOMAIN="previews.neherlab.click"
UPLOAD_JOBS=16

declare -A PRODUCTION_URLS=(
  [treetime]="https://treetime.neherlab.click"
  [treetime - docs]="https://docs.treetime.neherlab.click"
)

# Vite names an emitted file `assets/<name>-<hash>.<ext>`, with 8 characters of
# base64url as the hash.
HASHED_NAME='-[A-Za-z0-9_-]{8}\.[A-Za-z0-9]+$'

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  local dist="packages/app-web2/dist" prefix="" label="Web app"

  # shfmt:off
  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      show_help
      exit 0
      ;;
    --dist)
      if (($# < 2)); then
        printf "Missing value of %s\n" "${1}" >&2
        exit 1
      fi
      dist="${2}"
      shift 2
      ;;
    --prefix | --label)
      if (($# < 2)); then
        printf "Missing value of %s\n" "${1}" >&2
        exit 1
      fi
      if [[ "${1}" == --prefix ]]; then
        prefix="${2}"
      else
        label="${2}"
      fi
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      printf "Unknown option: %s\n" "${1}" >&2
      exit 1
      ;;
    *) break ;;
    esac
  done
  # shfmt:on

  if (($# == 0)); then
    printf "No site given. Run %s --help for usage\n" "${0##*/}" >&2
    exit 1
  fi

  : "${AWS_ACCESS_KEY_ID:?AWS_ACCESS_KEY_ID is not set}"
  : "${AWS_SECRET_ACCESS_KEY:?AWS_SECRET_ACCESS_KEY is not set}"
  : "${AWS_DEFAULT_REGION:?AWS_DEFAULT_REGION is not set}"
  : "${AWS_S3_BUCKET:?AWS_S3_BUCKET is not set}"
  : "${AWS_CLOUDFRONT_DISTRIBUTION_ID:?AWS_CLOUDFRONT_DISTRIBUTION_ID is not set}"

  if [[ ! -f "${dist}/index.html" ]]; then
    printf "No build in %s: it has no index.html; run the build recipe of %s first\n" "${dist}" "${dist}" >&2
    exit 1
  fi

  if [[ -n "${prefix}" && ! "${prefix}" =~ ^[a-z0-9][a-z0-9.-]*$ ]]; then
    printf "Invalid prefix: '%s' (expected a folder name such as dev or 1.0)\n" "${prefix}" >&2
    exit 1
  fi

  local sites=()
  local name site
  for name in "$@"; do
    site="$(site_name "${name}")"
    if [[ ! "${site}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
      printf "Invalid site name: '%s' (as a DNS label: '%s')\n" "${name}" "${site}" >&2
      exit 1
    fi
    sites+=("${site}")
  done

  local files=() pages=() file
  shopt -s globstar dotglob nullglob
  pushd "${dist}" >/dev/null
  for file in **; do
    if [[ ! -f "${file}" ]] || is_compressed_copy "${file}"; then
      continue
    elif [[ "${file}" == *.html ]]; then
      pages+=("${file}")
    else
      files+=("${file}")
    fi
  done
  popd >/dev/null

  export DIST="${dist}" PREFIX="${prefix}" AWS_S3_BUCKET HASHED_NAME
  export -f upload_file upload_object content_type cache_control

  local first="${sites[0]}"
  printf "Uploading %d files to %s\n" "$((${#files[@]} + ${#pages[@]}))" "${first}" >&2
  upload_all "${first}" "${files[@]}"
  upload_all "${first}" "${pages[@]}"
  upload_folder_page "${first}"
  for site in "${sites[@]:1}"; do
    printf "Copying %d files from %s to %s\n" "$((${#files[@]} + ${#pages[@]}))" "${first}" "${site}" >&2
    if ! { copy_all "${first}" "${site}" "${files[@]}" && copy_all "${first}" "${site}" "${pages[@]}"; }; then
      printf "Copying to %s failed; uploading the build to it instead\n" "${site}" >&2
      upload_all "${site}" "${files[@]}"
      upload_all "${site}" "${pages[@]}"
    fi
    upload_folder_page "${site}"
  done

  aws cloudfront create-invalidation --distribution-id "${AWS_CLOUDFRONT_DISTRIBUTION_ID}" --paths "/*" --output text --query "Invalidation.Id" >/dev/null

  local urls=()
  for site in "${sites[@]}"; do
    urls+=("$(site_url "${site}")${prefix:+/${prefix}}")
  done
  printf "%s\n" "${urls[@]}"

  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    {
      printf "## %s\n\n" "${label}"
      printf -- "- %s\n" "${urls[@]}"
    } >>"${GITHUB_STEP_SUMMARY}"
  fi
}

site_name() {
  printf "%s" "${1}" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9-]/-/g; s/^-+//' |
    cut -c1-63 |
    sed -E 's/-+$//'
}

site_url() {
  if [[ -v "PRODUCTION_URLS[${1}]" ]]; then
    printf "%s\n" "${PRODUCTION_URLS[${1}]}"
  else
    printf "https://%s.%s\n" "${1}" "${PREVIEWS_DOMAIN}"
  fi
}

is_compressed_copy() {
  local file="${1}"
  [[ ("${file}" == *.gz || "${file}" == *.br) && -f "${file%.*}" ]]
}

upload_all() {
  local site="${1}"
  shift
  (($# > 0)) || return 0
  # shellcheck disable=SC2016 # $1 and $2 expand in the child shell
  printf "%s\0" "$@" |
    xargs -0 -P "${UPLOAD_JOBS}" -I {} bash -c 'upload_file "$1" "$2" || exit 255' _ "${site}" {}
}

# Copy the given files of the build from one site to another inside the bucket,
# with one `aws s3 cp` call that filters the folder of the first site by their
# keys. The copies keep the content type, encoding, and cache control of the
# uploads (`metadata-directive`, which reads no tags). A key with a character
# that the filters read as a pattern is copied on its own.
copy_all() {
  local from="${1}" to="${2}"
  shift 2
  (($# > 0)) || return 0
  local filters=() file key
  for file in "$@"; do
    key="${PREFIX:+${PREFIX}/}${file%.html}"
    case "${key}" in
    *'*'* | *'?'* | *'['*)
      aws s3 cp --copy-props metadata-directive --only-show-errors \
        "s3://${AWS_S3_BUCKET}/${from}/${key}" "s3://${AWS_S3_BUCKET}/${to}/${key}" || return 1
      ;;
    *) filters+=(--include "${key}") ;;
    esac
  done
  ((${#filters[@]} > 0)) || return 0
  aws s3 cp --recursive --copy-props metadata-directive --only-show-errors --exclude "*" "${filters[@]}" \
    "s3://${AWS_S3_BUCKET}/${from}/" "s3://${AWS_S3_BUCKET}/${to}/"
}

# Store the root page of a build in a version folder also as the object of the
# folder name, so /<folder> serves it without an edge rule.
upload_folder_page() {
  [[ -n "${PREFIX}" ]] || return 0
  upload_object "${1}" index.html "${PREFIX}"
}

upload_file() {
  local site="${1}" file="${2}"
  upload_object "${site}" "${file}" "${PREFIX:+${PREFIX}/}${file%.html}"
}

upload_object() {
  local site="${1}" file="${2}" key="${3}"
  local body="${DIST}/${file}"
  local args=(
    --content-type "$(content_type "${file}")"
    --cache-control "$(cache_control "${file}")"
    --no-guess-mime-type
    --only-show-errors
  )
  if [[ -f "${body}.gz" ]]; then
    body="${body}.gz"
    args+=(--content-encoding gzip)
  fi
  aws s3 cp "${args[@]}" "${body}" "s3://${AWS_S3_BUCKET}/${site}/${key}"
}

content_type() {
  case "${1##*/}" in
  *.html) printf "text/html; charset=utf-8" ;;
  *.js | *.mjs) printf "text/javascript; charset=utf-8" ;;
  *.css) printf "text/css; charset=utf-8" ;;
  *.json) printf "application/json" ;;
  *.webmanifest) printf "application/manifest+json" ;;
  *.wasm) printf "application/wasm" ;;
  *.svg) printf "image/svg+xml" ;;
  *.png) printf "image/png" ;;
  *.ico) printf "image/x-icon" ;;
  *.woff2) printf "font/woff2" ;;
  *.woff) printf "font/woff" ;;
  *.csv) printf "text/csv; charset=utf-8" ;;
  *.tsv) printf "text/tab-separated-values; charset=utf-8" ;;
  *.md) printf "text/markdown; charset=utf-8" ;;
  *.yaml | *.yml) printf "application/yaml" ;;
  *.xml) printf "application/xml" ;;
  *.xz) printf "application/x-xz" ;;
  *.txt | *.nwk | *.nex | *.fasta | *.phylip | *.gff3 | *.vcf) printf "text/plain; charset=utf-8" ;;
  *) printf "application/octet-stream" ;;
  esac
}

cache_control() {
  if [[ "${1}" == assets/* && "${1##*/}" =~ ${HASHED_NAME} ]]; then
    printf "public, max-age=31536000, immutable"
  else
    printf "no-cache"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
