#!/usr/bin/env bash
#
# Usage: $0 <binary> [target]
#
# Print the linkage of a cross-compiled binary. Fails when a musl binary is not
# static or depends on glibc or libgcc; glibc binaries link glibc by design.
#
set -euo pipefail

bin="${1:?}"
target="${2:-"${CROSS_COMPILE:-}"}"
target_safe="${target//-/_}"

has_error=0
must_be_static=0
[[ "${target}" == *-linux-musl ]] && must_be_static=1

function run_for_linux() {
  : "${CROSS_SYSROOT:?}"

  local LDD OBJDUMP STRINGS output dump glibc_version libgcc_version needs
  LDD="$(printenv "LDD_${target_safe}" || printenv "LDD" || echo "ldd")"
  OBJDUMP="$(printenv "OBJDUMP_${target_safe}" || printenv "OBJDUMP" || echo "objdump")"
  STRINGS="$(printenv "STRINGS_${target_safe}" || printenv "STRINGS" || echo "strings")"

  output=$("${LDD}" ${CROSS_SYSROOT:+--root="${CROSS_SYSROOT}"} "$1" 2>&1 || true)
  if ! echo "$output" | grep -qE 'statically linked|not a dynamic executable'; then
    echo "Not a static executable: '$1'" >&2
    has_error="${must_be_static}"
  fi

  dump=$("${OBJDUMP}" -p "$1" 2>&1 || true)
  glibc_version=$(echo "${dump}" | grep 'GLIBC_' | awk '{print $NF}' | sed 's/GLIBC_//' | sort -V | tail -n 1)
  if [ -n "$glibc_version" ]; then
    echo "Depends on glibc $glibc_version" >&2
    has_error="${must_be_static}"
  fi

  libgcc_version=$(echo "${dump}" | grep 'GCC_' | awk '{print $NF}' | sed 's/GCC_//' | sort -V | tail -n 1)
  if [ -n "${libgcc_version}" ]; then
    echo "Depends on libgcc ${libgcc_version}" >&2
    has_error="${must_be_static}"
  fi

  needs=$("${OBJDUMP}" -p "${1}" | awk '$1 == "NEEDED" {print $2}' | tr -s ' ' | sort)
  if [ -n "$needs" ]; then
    echo "Needs:"
    echo "$needs" | while read -r lib_name; do
      if [[ ! "$lib_name" =~ ^(libc.so|libgcc) ]]; then
        echo "  * $lib_name"
      fi
    done
  fi

  output=$("${LDD}" ${CROSS_SYSROOT:+--root="${CROSS_SYSROOT}"} "$1" 2>&1 | awk '/=>/ {print $(NF-1)}' | while read -r lib_path; do
    version="$("${STRINGS}" "${CROSS_SYSROOT}$lib_path" | grep -Eo '([0-9]+\.[0-9]+\.[0-9]+)' | sort -u | head -n 1)"
    if [ -n "$version" ]; then
      lib_name="$(basename "$lib_path")"
      if [[ ! "$lib_name" =~ ^(libc.so|libgcc) ]]; then
        echo "$lib_name $version"
      fi
    fi
  done | sort)

  if [ -n "$output" ]; then
    echo "Depends on:"
    echo "$output" | while read -r line; do
      echo "  * $line"
    done
  fi
}

function run_for_windows() {
  local OBJDUMP dump
  OBJDUMP="$(printenv "OBJDUMP_${target_safe}" || printenv "OBJDUMP" || echo "objdump")"
  dump=$("${OBJDUMP}" -p "${1}" | grep "DLL Name" | sed 's/^[ \t]*DLL Name: //;s/^/ * /' | sort)
  if [ -n "$dump" ]; then
    echo "The executable '$1' depends on:"
    echo "$dump"
  fi
}

function run_for_mac() {
  local OTOOL dump
  OTOOL="$(printenv "OTOOL_${target_safe}" || printenv "OTOOL" || echo "objdump")"
  dump=$("${OTOOL}" -L "${bin}" | awk 'NR>1 {print " * " $1}' | sort)
  if [ -n "$dump" ]; then
    echo "The executable '$1' depends on:"
    echo "$dump"
  fi
}

function main() {
  if [[ "${target}" =~ (mingw|windows) ]]; then
    run_for_windows "${bin}"
  elif [[ "${target}" =~ (apple|darwin) ]]; then
    run_for_mac "${bin}"
  elif [[ "${target}" =~ (linux) ]]; then
    run_for_linux "${bin}"
  else
    printf "Unknown target platform: %s\n" "${target}" >&2
    has_error=1
  fi

  if [ "$has_error" != "0" ]; then
    printf '%s: static binary checks failed (see above): %s\n' "$0" "${bin}" >&2
    exit 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
