#!/usr/bin/env bash
#
# Usage: $0 <binary> [target]
#
# Check the linkage of a cross-compiled Linux binary. Fails when a musl binary
# is not static or depends on glibc, and when any Linux binary depends on
# libgcc: glibc binaries link glibc by design, but link the GCC unwinder
# statically (dev/cross/build). Prints nothing when the checks pass.
#
set -euo pipefail

bin="${1:?}"
target="${2:-"${CROSS_COMPILE:-}"}"
target_safe="${target//-/_}"

function main() {
  if [[ "${target}" != *-linux-* ]]; then
    printf "Not a Linux target: %s\n" "${target}" >&2
    exit 1
  fi
  : "${CROSS_SYSROOT:?}"

  local LDD OBJDUMP ldd_output dump glibc_version libgcc_version has_error=0
  LDD="$(printenv "LDD_${target_safe}" || printenv "LDD" || echo "ldd")"
  OBJDUMP="$(printenv "OBJDUMP_${target_safe}" || printenv "OBJDUMP" || echo "objdump")"

  if [[ "${target}" == *-linux-musl ]]; then
    ldd_output="$("${LDD}" ${CROSS_SYSROOT:+--root="${CROSS_SYSROOT}"} "${bin}" 2>&1)" || true # ldd exits 1 for a static binary
    if ! grep -qE 'statically linked|not a dynamic executable' <<<"${ldd_output}"; then
      printf "Not a static executable: '%s'. ldd prints:\n%s\n" "${bin}" "${ldd_output}" >&2
      has_error=1
    fi
  fi

  dump="$("${OBJDUMP}" -p "${bin}")"
  glibc_version=$(awk '/GLIBC_/ {v = $NF; sub(/GLIBC_/, "", v); print v}' <<<"${dump}" | sort -V | tail -n 1)
  if [[ "${target}" == *-linux-musl && -n "${glibc_version}" ]]; then
    printf "Depends on glibc %s: '%s'\n" "${glibc_version}" "${bin}" >&2
    has_error=1
  fi

  libgcc_version=$(awk '/GCC_/ {v = $NF; sub(/GCC_/, "", v); print v}' <<<"${dump}" | sort -V | tail -n 1)
  if [[ -n "${libgcc_version}" ]]; then
    printf "Depends on libgcc %s: '%s'\n" "${libgcc_version}" "${bin}" >&2
    has_error=1
  fi

  if ((has_error)); then
    printf '%s: static binary checks failed (see above): %s\n' "$0" "${bin}" >&2
    exit 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
