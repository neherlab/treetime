def run_timetree(name: str, out: str, extra_args: str):
  # Build output selection based on which outputs the extra_args actually support:
  #  - confidence requires --time-marginal or --confidence
  #  - gtr requires ancestral reconstruction (excluded with --branch-length-mode=input)
  outputs = ["nwk", "nexus", "auspice", "augur-node-data", "clock-model"]
  if "--branch-length-mode=input" not in extra_args:
    outputs.append("gtr")
  if "--time-marginal" in extra_args or "--confidence" in extra_args:
    outputs.append("confidence-tsv")
  selection = f"--output-selection={','.join(outputs)}"

  outdir = f"{RESULTS_DIR}/timetree/{out}"
  cmd = f"""
  {TREETIME_BIN} timetree
  --tree={DATA_DIR}/{name}/tree.nwk
  --dates={DATA_DIR}/{name}/metadata.tsv
  --aln={DATA_DIR}/{name}/aln.fasta.xz
  --output-all={outdir}
  {selection}
  {extra_args}
  """
  return run_batch_cmd(name, "timetree", cmd, outdir)


def init_worker():
  signal(SIGINT, SIG_IGN)


def get_timing(res: dict[str, str | int | float | Timing | None]) -> Timing:
  t = res.get("timing")
  return t if isinstance(t, Timing) else Timing(0, 0, 0)


def result_label(res: dict[str, str | int | float | Timing | None]) -> str:
  cmd_name = res["cmd_name"]
  data_name = res["data_name"]
  return f"{cmd_name} for {data_name}" if data_name else str(cmd_name)


def print_table(title: str, headers: list[str], rows: list[list[str]], color_fn=grey) -> None:
  if not rows:
    return
  widths = [max(len(h), max((len(r[i]) for r in rows), default=0)) for i, h in enumerate(headers)]
  total_width = sum(widths) + 3 * len(widths) + 1
  sep = "+" + "-" * (total_width - 2) + "+"
  col_sep = "+-" + "-+-".join("-" * w for w in widths) + "-+"
  header_row = "| " + " | ".join(h.ljust(w) for h, w in zip(headers, widths)) + " |"
  title_row = "| " + title.center(total_width - 4) + " |"
  print(sep)
  print(blue(title_row))
  print(col_sep)
  print(grey(header_row))
  print(col_sep)
  for row in rows:
    print(color_fn("| " + " | ".join(c.ljust(w) for c, w in zip(row, widths)) + " |"))
  print(col_sep)


def print_summary(results: list[dict[str, str | int | float | Timing | None]], wall_time: float, num_cores: int, skip_perf: bool = False) -> None:
  n = len(results)
  failures = [res for res in results if res["code"] != 0]
  successes = [res for res in results if res["code"] == 0]
  n_err = len(failures)
  n_ok = len(successes)

  if n == 0:
    print("No tests found")
    sys.exit(1)

  timings = [get_timing(res) for res in successes]
  walls = [t.wall for t in timings] if timings else [0.0]
  cpus = [t.cpu for t in timings] if timings else [0.0]

  sum_wall = sum(walls)
  sum_cpu = sum(cpus)
  max_wall = max(walls) if walls else 0

  print()

  # 1. Test Results
  f_color = red if n_err > 0 else green
  print_table(
    "TEST RESULTS",
    ["Outcome", "Count"],
    [
      ["Passed", str(n_ok)],
      ["Failed", str(n_err)],
      ["Total", str(n)],
    ],
    lambda x: green(x) if "Passed" in x and n_ok > 0 else (red(x) if "Failed" in x and n_err > 0 else grey(x))
  )
  print()

  # 2. Timing and Parallelism (skip if only_failures mode)
  if not skip_perf:
    if n_ok > 0:
      speedup = sum_wall / wall_time if wall_time > 0 else 0
      efficiency = (speedup / num_cores * 100) if num_cores > 0 else 0
      cpu_ratio = (sum_cpu / sum_wall * 100) if sum_wall > 0 else 0
      bottleneck_pct = (max_wall / wall_time * 100) if wall_time > 0 else 0

      print_table(
        "TIMING AND PARALLELISM (passed tests only)" if n_err > 0 else "TIMING AND PARALLELISM",
        ["Metric", "Value", "How Calculated"],
        [
          ["Script wall time", format_duration(wall_time), "Measured"],
          ["Sum of test wall times", format_duration(sum_wall), "Measured"],
          ["Sum of test CPU times", format_duration(sum_cpu), "Measured"],
          ["", "", ""],
          ["Shortest test", format_duration(min(walls)), "Measured"],
          ["Median test", format_duration(statistics.median(walls)), "Measured"],
          ["Longest test", format_duration(max_wall), "Measured"],
          ["", "", ""],
          ["CPU cores", str(num_cores), "Hardware"],
          ["Speedup", f"{speedup:.1f}x", "sum_test_wall / script_wall"],
          ["Efficiency", f"{efficiency:.0f}%", "speedup / cores"],
          ["CPU ratio", f"{cpu_ratio:.0f}%", "sum_cpu / sum_wall"],
          ["Bottleneck", f"{bottleneck_pct:.0f}%", "longest_test / script_wall"],
        ]
      )
    else:
      print_table(
        "TIMING",
        ["Metric", "Value"],
        [["Script wall time", format_duration(wall_time)]]
      )
    print()

  # 5. Results by Command Type
  def get_cmd_type(res: dict[str, str | int | float | Timing | None]) -> str:
    return str(res["cmd_name"]).split("-")[0]

  cmd_types = sorted(set(get_cmd_type(res) for res in results))
  cmd_passed = Counter(get_cmd_type(res) for res in successes)
  cmd_failed = Counter(get_cmd_type(res) for res in failures)
  cmd_total = Counter(get_cmd_type(res) for res in results)

  print_table(
    "RESULTS BY COMMAND TYPE",
    ["Command", "Passed", "Failed", "Total"],
    [[cmd, str(cmd_passed[cmd]), str(cmd_failed[cmd]), str(cmd_total[cmd])] for cmd in cmd_types]
  )
  print()

  # 6. Slowest Tests (skip if only_failures mode)
  if not skip_perf and n_ok > 0:
    sorted_by_wall = sorted(successes, key=lambda r: get_timing(r).wall, reverse=True)
    print_table(
      "TOP 10 SLOWEST TESTS",
      ["Wall Clock", "CPU Time", "CPU %", "Test Name"],
      [
        [
          format_duration(get_timing(res).wall),
          format_duration(get_timing(res).cpu),
          f"{(get_timing(res).cpu / get_timing(res).wall * 100) if get_timing(res).wall > 0 else 0:.0f}%",
          result_label(res)
        ]
        for res in sorted_by_wall[:10]
      ]
    )
    print()

  # 7. Most I/O Bound Tests (skip if only_failures mode)
  if not skip_perf and n_ok > 0:
    sorted_by_cpu_eff = sorted(
      [(res, get_timing(res).cpu / get_timing(res).wall if get_timing(res).wall > 0 else 0) for res in successes],
      key=lambda x: x[1]
    )
    io_bound = [(res, eff) for res, eff in sorted_by_cpu_eff if get_timing(res).wall > 0.1][:5]
    if io_bound:
      print_table(
        "MOST I/O BOUND TESTS (lowest CPU utilization)",
        ["CPU %", "Wall Clock", "Test Name"],
        [[f"{eff*100:.1f}%", format_duration(get_timing(res).wall), result_label(res)] for res, eff in io_bound]
      )
      print()

  if n_err > 0:
    failed_cmds = [""] + [str(failure["cmd"]) for failure in failures]
    print(red("Failed commands:" + "\n\n  ".join(failed_cmds) + "\n\n"))

  sys.exit(0 if n_err == 0 else 1)


def build_manifest(results: list[dict], results_dir: str, binary_path: str, data_dir_abs: str) -> dict:
  """Assemble the completion-attesting manifest for one finished matrix run.

  `completed` is written only here, after the whole matrix has run to a result list, so its presence
  (via the atomic write in `write_manifest`) is a driver-completion signal, not a per-case pass/fail
  signal. `binary_sha256`, `matrix_id`, and `input_id` bind the manifest to the exact binary, test
  matrix, and input data it describes, letting `smoke-compare` refuse to reuse or cross-compare
  evidence produced against a different binary, matrix, or inputs.
  """
  cases = [manifest_entry(res, results_dir) for res in results]
  return {
    "schema": MANIFEST_SCHEMA,
    "completed": True,
    "generated_at": datetime.now(timezone.utc).isoformat(),
    "binary": binary_path,
    "binary_sha256": sha256_file(Path(binary_path)),
    "results_dir": results_dir,
    "matrix_id": matrix_identity(),
    "input_id": input_identity(data_dir_abs),
    "case_count": len(cases),
    "cases": cases,
  }


def write_manifest(manifest: dict, manifest_path: Path) -> None:
  """Write the manifest atomically (temp file + rename).

  A driver that dies mid-run therefore never leaves a half-written or stale-looking manifest: the
  completed file appears whole or not at all. `smoke-compare` deletes the target path before each run
  and requires a fresh completed manifest afterwards, so a missing manifest is read as a driver
  failure rather than silently reusing older evidence.
  """
  manifest_path.parent.mkdir(parents=True, exist_ok=True)
  tmp_path = manifest_path.with_name(f"{manifest_path.name}.tmp")
  tmp_path.write_text(json.dumps(manifest, indent=2))
  os.replace(tmp_path, manifest_path)


def manifest_entry(res: dict, results_dir: str) -> dict:
  outdir = res.get("output_dir")
  rel = os.path.relpath(str(outdir), results_dir) if outdir else None
  return {
    "id": rel if rel is not None else str(res["cmd_name"]),
    "cmd_name": res["cmd_name"],
    "data_name": res["data_name"],
    "code": res["code"],
    "output_dir": rel,
  }


def sha256_file(path: Path) -> str:
  digest = hashlib.sha256()
  with path.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1 << 20), b""):
      digest.update(chunk)
  return digest.hexdigest()


def matrix_identity() -> str:
  """Content hash of the entire test-matrix definition (every batch table plus the expansion plan).

  Two runs share a `matrix_id` only when they cover exactly the same set of cases, so a persisted
  before-run cannot be silently compared against an after-run built from a changed matrix.
  """
  additional = [name for name, _cmd in make_additional_commands("EXE", "DATA", "OUT")]
  payload = {
    "ancestral": ANCESTRAL_BATCH_RUNS,
    "clock": CLOCK_BATCH_RUNS,
    "mugration": MUGRATION_BATCH_RUNS,
    "optimize": OPTIMIZE_BATCH_RUNS,
    "prune": PRUNE_BATCH_RUNS,
    "timetree": TIMETREE_BATCH_RUNS,
    "additional": additional,
    "expansions": [
      "clock",
      "ancestral:parsimony",
      "ancestral:marginal:sparse",
      "ancestral:marginal:dense",
      "mugration",
      "optimize:false",
      "prune",
      "timetree",
    ],
  }
  blob = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
  return hashlib.sha256(blob).hexdigest()


def referenced_input_files(data_dir_abs: str) -> list[Path]:
  """Every input file the matrix reads: the referenced dataset directories plus auxiliary files named
  through `{data_dir}/...` in extra args (e.g. mugration weights)."""
  root = Path(data_dir_abs)
  names = {entry[0] for table in
           (ANCESTRAL_BATCH_RUNS, CLOCK_BATCH_RUNS, OPTIMIZE_BATCH_RUNS, PRUNE_BATCH_RUNS, TIMETREE_BATCH_RUNS)
           for entry in table}
  names.update(entry[0] for entry in MUGRATION_BATCH_RUNS)

  files = {path
           for name in names
           for path in (root / name).rglob("*")
           if (root / name).is_dir() and path.is_file()}

  aux = {root / match.group(1)
         for entry in MUGRATION_BATCH_RUNS
         for match in re.finditer(r"\{data_dir\}/(\S+)", entry[-1])}
  files.update(path for path in aux if path.is_file())
  return sorted(files)


def input_identity(data_dir_abs: str) -> str:
  """Content hash over every referenced input file, so a persisted before-run is only reused against
  an after-run that read byte-identical inputs."""
  root = Path(data_dir_abs)
  digest = hashlib.sha256()
  for path in referenced_input_files(data_dir_abs):
    digest.update(path.relative_to(root).as_posix().encode())
    digest.update(b"\0")
    digest.update(sha256_file(path).encode())
    digest.update(b"\n")
  return digest.hexdigest()


if __name__ == "__main__":
  # Parse arguments (order-independent). Boolean flags and `--key=value` flags are both accepted.
  usage = (
    f"Usage: {sys.argv[0]} <path_to_treetime_executable> "
    "[--only-failures] [--no-stats] [--output-dir=PATH] [--manifest=PATH]"
  )
  bool_flags = {"--only-failures", "--no-stats"}
  valued_flags = {"--output-dir", "--manifest"}
  seen_bool: set[str] = set()
  valued: dict[str, str] = {}
  positional_args: list[str] = []
  for arg in sys.argv[1:]:
    if arg in bool_flags:
      seen_bool.add(arg)
    elif arg.startswith("--") and "=" in arg:
      key, _, value = arg.partition("=")
      if key not in valued_flags:
        sys.exit(f"Unknown flag: {key}\n{usage}")
      valued[key] = value
    elif arg.startswith("--"):
      sys.exit(f"Unknown or malformed flag: {arg}\n{usage}")
    else:
      positional_args.append(arg)

  if len(positional_args) != 1:
    sys.exit(usage)

  only_failures = "--only-failures" in seen_bool
  no_stats = "--no-stats" in seen_bool


  def normpath(path: Path) -> str:
    return str(path.resolve())


  THIS_DIR = normpath(Path(__file__).parent)
  PROJECT_ROOT = normpath(Path(THIS_DIR) / '..')


  def relpath(path: Path) -> str:
    return os.path.relpath(normpath(path), PROJECT_ROOT)


  TREETIME_BIN = normpath(Path(positional_args[0]))
  DATA_DIR = relpath(Path(PROJECT_ROOT) / 'data')
  DATA_DIR_ABS = normpath(Path(PROJECT_ROOT) / 'data')
  RESULTS_DIR = relpath(Path(valued["--output-dir"])) if "--output-dir" in valued else relpath(Path(PROJECT_ROOT) / 'tmp/smoke-tests')
  RESULTS_DIR_ADDITIONAL = Path(RESULTS_DIR) / 'additional'

  num_cores = cpu_count()

  batches = [
    (run_clock, CLOCK_BATCH_RUNS),
    (run_ancestral, [("parsimony", None, *args) for args in ANCESTRAL_BATCH_RUNS]),
    (run_ancestral, [("marginal", "sparse", *args) for args in ANCESTRAL_BATCH_RUNS]),
    (run_ancestral, [("marginal", "dense", *args) for args in ANCESTRAL_BATCH_RUNS]),
    (run_mugration, MUGRATION_BATCH_RUNS),
    (run_optimize, [("false", *args) for args in OPTIMIZE_BATCH_RUNS]),
    # (run_optimize, [("true", *args) for args in OPTIMIZE_BATCH_RUNS]), # TODO: enable optimize dense tests
    (run_prune, PRUNE_BATCH_RUNS),
    (run_timetree, TIMETREE_BATCH_RUNS),
    (run_additional_cmd, make_additional_commands(TREETIME_BIN, DATA_DIR, RESULTS_DIR_ADDITIONAL))
  ]

  start_time = time.perf_counter()
  with Pool(processes=num_cores, initializer=init_worker) as pool:
    try:
      results = [pool.starmap_async(func, args) for func, args in batches]
      results = [code for result in results for code in result.get()]
      if "--manifest" in valued:
        manifest = build_manifest(results, RESULTS_DIR, TREETIME_BIN, DATA_DIR_ABS)
        write_manifest(manifest, Path(valued["--manifest"]))
      wall_time = time.perf_counter() - start_time
      print_summary(results, wall_time, num_cores, skip_perf=no_stats)
    except KeyboardInterrupt:
      pool.terminate()
      pool.close()
    finally:
      pool.close()
      pool.join()
