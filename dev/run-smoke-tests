def blue(text):
  return f"\033[38;5;32m{text}\033[0m"


def red(text):
  return f"\033[38;5;203m{text}\033[0m"


def orange(text):
  return f"\033[38;5;166m{text}\033[0m"


def green(text):
  return f"\033[38;5;113m{text}\033[0m"


def grey(text):
  return f"\033[38;5;244m{text}\033[0m"


@dataclass(frozen=True)
class Timing:
  wall: float
  user: float
  sys: float

  @property
  def cpu(self) -> float:
    return self.user + self.sys


def format_duration(seconds: float) -> str:
  total = int(round(seconds))
  hours, remainder = divmod(total, 3600)
  minutes, secs = divmod(remainder, 60)
  parts = []
  if hours:
    parts.append(f"{hours:02d}h")
  if minutes:
    parts.append(f"{minutes:02d}m")
  if secs or not parts:
    parts.append(f"{secs:02d}s")
  return "".join(parts)


def run_cmd(name: str, cmd: str) -> tuple[list[str], int, Timing]:
  output: list[str] = []
  code = 0
  ru_before = resource.getrusage(resource.RUSAGE_CHILDREN)
  start = time.perf_counter()
  try:
    result = subprocess.run(
      cmd,
      shell=True,
      stdout=subprocess.DEVNULL,
      stderr=subprocess.PIPE,
      text=True,
      env={**os.environ, 'CLICOLOR_FORCE': '1', 'RUST_BACKTRACE': 'full'}
    )
    output.append(result.stderr or "")
    code = result.returncode
  except subprocess.CalledProcessError as e:
    output.append(e.output)
    code = e.returncode
  wall = time.perf_counter() - start
  ru_after = resource.getrusage(resource.RUSAGE_CHILDREN)
  timing = Timing(
    wall=wall,
    user=ru_after.ru_utime - ru_before.ru_utime,
    sys=ru_after.ru_stime - ru_before.ru_stime,
  )
  return output, code, timing


def clean_cmd(cmd: str) -> str:
  return " ".join(dedent(cmd).splitlines()).strip()


def format_timing(t: Timing) -> str:
  return f"wall={format_duration(t.wall)} cpu={format_duration(t.cpu)}"


def run_batch_cmd(data_name: str, cmd_name: str, cmd: str, outdir: Optional[str] = None) -> dict[str, str | int | float | Timing | None]:
  cmd = clean_cmd(cmd)
  output, code, timing = run_cmd(data_name, cmd)
  show_output = code != 0 or not only_failures
  if show_output:
    status = "🚨 Failed" if code != 0 else "🏁 Finished"
    print("\n".join([f"{status}: {orange(cmd_name)} for {blue(data_name)} {grey(f'[{format_timing(timing)}]')}\n", grey(f"+{cmd}")] + output))
  return {"data_name": data_name, "cmd_name": cmd_name, "cmd": cmd, "code": code, "timing": timing, "output_dir": outdir}


def run_additional_cmd(cmd_name: str, cmd: str) -> dict[str, str | int | float | Timing | None]:
  cmd = clean_cmd(cmd)
  output, code, timing = run_cmd(cmd_name, cmd)
  show_output = code != 0 or not only_failures
  if show_output:
    status = "🚨 Failed" if code != 0 else "🏁 Finished"
    print("\n".join([f"{status}: {orange(cmd_name)} {grey(f'[{format_timing(timing)}]')}\n", grey(f"+{cmd}")] + output))
  return {"data_name": None, "cmd_name": cmd_name, "cmd": cmd, "code": code, "timing": timing, "output_dir": None}


def run_clock(name: str, out: str, extra_args: str):
  outdir = f"{RESULTS_DIR}/clock/{out}"
  cmd = f"""
  {TREETIME_BIN} clock
  --tree={DATA_DIR}/{name}/tree.nwk
  --dates={DATA_DIR}/{name}/metadata.tsv
  --output-all={outdir}
  {extra_args}
  """
  return run_batch_cmd(name, "clock", cmd, outdir)


def run_ancestral(method: str, seq_mode: Optional[str], name: str, out: str, extra_args: str):
  outdir_base = f"{RESULTS_DIR}/ancestral/{method}"
  dense = ""
  if method == "marginal":
    if seq_mode == "dense":
      dense = "--dense=true --model=jc69"
      outdir_base = f"{outdir_base}-dense"
    else:
      dense = "--dense=false"
      outdir_base = f"{outdir_base}-sparse"

  # Parsimony does not infer a GTR model, so exclude gtr from default outputs
  selection = "--output-selection=nwk,nexus,augur-node-data,reconstructed-nuc-fasta" if method == "parsimony" else ""

  outdir = f"{outdir_base}/{out}"
  cmd = f"""
  {TREETIME_BIN} ancestral
  --method-anc={method}
  {dense}
  --tree={DATA_DIR}/{name}/tree.nwk
  --aln={DATA_DIR}/{name}/aln.fasta.xz
  --output-all={outdir}
  {selection}
  {extra_args}
  """

  method_str = f"ancestral-{method}"
  if method == "marginal" and seq_mode is not None:
    method_str = f"{method_str}-{seq_mode}"

  return run_batch_cmd(name, method_str, cmd, outdir)


def run_mugration(name: str, out: str, attribute: str, extra_args: str):
  outdir = f"{RESULTS_DIR}/mugration/{out}"
