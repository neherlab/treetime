#!/usr/bin/env bash
#
# Usage: $0 <tag> [target]
#
# Build the images of the web deploy: treetime-web:<tag> with the static
# treetime-server binary for a musl target (default x86_64-unknown-linux-musl),
# the web UI, and the example datasets, and treetime-caddy:<tag>, the reverse
# proxy with rate limiting (dev/deploy/caddy.dockerfile). Run it on the host; the
# compilation runs in the build containers of dev/docker/run.
#
# Environment:
#   TREETIME_DOCKER_PUSH=1  Push a newly built Caddy image to the registry, as
#                           dev/docker/run does with its images (CI only)
#
# Examples:
#   $0 local
#   $0 "$(git rev-parse --short HEAD)"
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"
# shellcheck source=../lib/env.sh
source "${root}/dev/lib/env.sh"

tag="${1:?image tag}"
target="${2:-x86_64-unknown-linux-musl}"

# The distroless base image has no libc, so only fully static musl binaries run in it.
case "${target}" in
x86_64-unknown-linux-musl) platform="linux/amd64" ;;
aarch64-unknown-linux-musl) platform="linux/arm64" ;;
*)
  printf 'Unsupported target: %s. The image needs a static musl binary\n' "${target}" >&2
  exit 1
  ;;
esac

caddy_registry="neherlab/treetime_builder"

# The cross image also holds bun and node, so the server binary and the UI build
# in one image.
export CROSS_COMPILE="${target}"
dev/docker/run dev/cross/build treetime-server
dev/docker/run dev/cross/check treetime-server
dev/docker/run bun install --frozen-lockfile
dev/docker/run bun run build:web

docker build \
  --platform="${platform}" \
  --build-arg="TARGET=${target}" \
  --file=dev/deploy/web.dockerfile \
  --tag="treetime-web:${tag}" \
  .

# The Caddy image changes only with its Dockerfile. It is named by a hash of the
# Dockerfile and the platform in the registry of dev/docker/run, pulled when the
# registry has it, and built otherwise; TREETIME_DOCKER_PUSH=1 (CI) pushes a new
# build. The build needs no context.
caddy_image="${caddy_registry}:caddy-$(hash_files dev/deploy/caddy.dockerfile "${platform}")"
if ! docker image inspect "${caddy_image}" >/dev/null 2>&1 &&
  ! docker pull --quiet --platform="${platform}" "${caddy_image}" >/dev/null 2>&1; then
  printf 'Building image %s\n' "${caddy_image}" >&2
  docker build \
    --platform="${platform}" \
    --tag="${caddy_image}" \
    - <dev/deploy/caddy.dockerfile
  if [[ "${TREETIME_DOCKER_PUSH:-}" == 1 ]]; then
    docker push --quiet "${caddy_image}"
  fi
fi
docker tag "${caddy_image}" "treetime-caddy:${tag}"
