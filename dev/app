#!/usr/bin/env bash
#
# Usage: $0 <up|serve|health|status|up-web2|serve-web2|docs|docs-prod>
#
# Servers of the web app: the API server (treetime-server), and in development
# the Vite dev server, which proxies /api to it. The web2 app needs no API
# server: its back end is the WebAssembly build in a web worker of the page, so
# it runs from one Vite server.
#
#   up          Start both development servers in the foreground until Ctrl-C
#   serve       Build the web app and the API server for production and serve both
#               from one port in the foreground until Ctrl-C
#   health      Probe both development servers; exit 1 when one is absent, not
#               answering, or started from another commit than the checkout HEAD
#   status      Print the resolved ports and URLs and what each server was started from
#   up-web2     Start the web2 development server in the foreground until Ctrl-C;
#               both WebAssembly modules must be built (just build-wasm, just
#               build-wasm-mt)
#   serve-web2  Build the web2 app for production and serve it in the foreground
#               until Ctrl-C; both WebAssembly modules must be built (just
#               build-wasm prod, just build-wasm-mt prod)
#   docs        Start the docs site development server, which reloads pages and styles
#               as they change, in the foreground until Ctrl-C; it runs no post-build
#               step, so search and the version list work only in docs-prod
#   docs-prod   Build the docs site as published and serve the build with the file
#               layout of the docs host (the site root files at /, the build at
#               /<version>, pages without their extension) in the foreground until Ctrl-C
#
# Each checkout resolves its own ports from its path, so worktrees run side by
# side. TREETIME_API_PORT, TREETIME_WEB_PORT, TREETIME_SERVE_PORT,
# TREETIME_WEB2_PORT, TREETIME_WEB2_SERVE_PORT, TREETIME_DOCS_PORT and
# TREETIME_DOCS_SERVE_PORT override the resolved ports.
#
# Each mode keeps its runs in its own directory of the checkout:
#
#   tmp/app/web-dev/runs    runs of the development servers (up)
#   tmp/app/web-prod/runs   runs of the production server (serve)
#
# A route launcher on the host can publish the web development server through an
# HTTPS proxy. The launcher writes the assigned hostnames to
# tmp/portless/web.hostnames.json as {"hostnames": [...], "urls": [...]} and then
# starts `up`, which writes the port of the web server to tmp/portless/web.json
# as {"port": <n>} once the server answers. `status` prints the URLs. Without a
# launcher, nobody reads web.json and the server has no public hostname.
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "${root}"

web_dev_dir="tmp/app/web-dev"
web_prod_dir="tmp/app/web-prod"
state_dir="${root}/${web_dev_dir}/servers"
route_dir="${root}/tmp/portless"

api_base_port=3100
web_base_port=5173
serve_base_port=4100
web2_base_port=4620
web2_serve_base_port=2580
docs_base_port=6100
docs_serve_base_port=6700

resolve() {
  local toplevel offset
  toplevel="$(git rev-parse --show-toplevel)"
  offset="$(($(printf '%s' "${toplevel}" | cksum | cut -d' ' -f1) % 512))"
  export TREETIME_API_PORT="${TREETIME_API_PORT:-$((api_base_port + offset))}"
  export TREETIME_WEB_PORT="${TREETIME_WEB_PORT:-$((web_base_port + offset))}"
  export TREETIME_SERVE_PORT="${TREETIME_SERVE_PORT:-$((serve_base_port + offset))}"
  export TREETIME_WEB2_PORT="${TREETIME_WEB2_PORT:-$((web2_base_port + offset))}"
  export TREETIME_WEB2_SERVE_PORT="${TREETIME_WEB2_SERVE_PORT:-$((web2_serve_base_port + offset))}"
  export TREETIME_DOCS_PORT="${TREETIME_DOCS_PORT:-$((docs_base_port + offset))}"
  export TREETIME_DOCS_SERVE_PORT="${TREETIME_DOCS_SERVE_PORT:-$((docs_serve_base_port + offset))}"
}

commit() {
  git rev-parse --short HEAD
}

probe() {
  curl -fsS -o /dev/null --max-time 3 "${1}"
}

# Poll a URL until it answers. The server is a separate process whose only
# readiness signal is the socket; the timeout bounds a cold compile.
wait_ready() {
  local url="${1}" timeout="${2}" pid="${3}" elapsed=0
  until probe "${url}" 2>/dev/null; do
    ((elapsed < timeout)) || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    sleep 1
    elapsed=$((elapsed + 1))
  done
}

write_state() {
  mkdir -p "${state_dir}"
  jq -n --arg url "${2}" --arg commit "$(commit)" '{url: $url, commit: $commit}' >"${state_dir}/${1}.json"
}

# Rename into place, so a launcher that watches the folder never reads a partial file.
write_route_request() {
  local tmp
  mkdir -p "${route_dir}"
  tmp="$(mktemp "${route_dir}/.${1}.json.XXXXXX")"
  jq -n --argjson port "${2}" '{port: $port}' >"${tmp}" || {
    rm -f -- "${tmp}"
    return 1
  }
  mv -f -- "${tmp}" "${route_dir}/${1}.json"
}

prefix() {
  local line
  while IFS= read -r line; do
    printf '[%s] %s\n' "${1}" "${line}"
  done
}

stop_servers() {
  local pid
  for pid in "${pids[@]}"; do
    kill -TERM -- "-${pid}" 2>/dev/null || true
  done
}

up() {
  resolve
  rm -rf "${state_dir}"
  local api_url="http://127.0.0.1:${TREETIME_API_PORT}/api/version"
  local web_url="http://127.0.0.1:${TREETIME_WEB_PORT}/"
  local url
  for url in "${api_url}" "${web_url}"; do
    if probe "${url}" 2>/dev/null; then
      printf 'A server already answers at %s; stop it before starting another (just status)\n' "${url}" >&2
      return 1
    fi
  done

  pids=()
  # Each server runs in its own process group, so stopping it reaches cargo's child too.
  # A signal ends the script through exit, so the EXIT trap stops both groups.
  set -m
  trap stop_servers EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  printf 'Starting the API server on http://127.0.0.1:%s\n' "${TREETIME_API_PORT}" >&2
  PORT="${TREETIME_API_PORT}" cargo run --locked --bin treetime-server -- --runs-dir="${web_dev_dir}/runs" \
    > >(prefix api) 2>&1 &
  pids+=("$!")
  wait_ready "${api_url}" 900 "${pids[0]}" || {
    printf 'The API server did not answer at %s\n' "${api_url}" >&2
    return 1
  }
  write_state api "${api_url}"

  printf 'Starting the web server on http://127.0.0.1:%s\n' "${TREETIME_WEB_PORT}" >&2
  bun run --cwd packages/app-web dev > >(prefix web) 2>&1 &
  pids+=("$!")
  wait_ready "${web_url}" 300 "${pids[1]}" || {
    printf 'The web server did not answer at %s\n' "${web_url}" >&2
    return 1
  }
  write_state web "${web_url}"
  write_route_request web "${TREETIME_WEB_PORT}"

  printf 'Ready: %s (Ctrl-C to stop)\n' "${web_url}" >&2
  wait -n "${pids[@]}"
}

serve() {
  resolve
  local url="http://127.0.0.1:${TREETIME_SERVE_PORT}"
  if probe "${url}/api/version" 2>/dev/null; then
    printf 'A server already answers at %s; stop it before starting another\n' "${url}" >&2
    return 1
  fi

  bun run --silent build:web
  cargo build --locked --release --bin treetime-server

  printf 'Serving the production web app on %s (Ctrl-C to stop)\n' "${url}" >&2
  STATIC_DIR=packages/app-web/dist PORT="${TREETIME_SERVE_PORT}" exec cargo run --locked --release --bin treetime-server -- \
    --runs-dir="${web_prod_dir}/runs"
}

health() {
  local svc state url started rc=0
  for svc in api web; do
    state="${state_dir}/${svc}.json"
    if [[ ! -f "${state}" ]]; then
      printf '%s: not started (start it with: just up)\n' "${svc}" >&2
      rc=1
      continue
    fi
    url="$(jq -r '.url' "${state}")"
    started="$(jq -r '.commit' "${state}")"
    if ! probe "${url}"; then
      printf '%s: not answering at %s\n' "${svc}" "${url}" >&2
      rc=1
    elif [[ "${started}" != "$(commit)" ]]; then
      printf '%s: stale, started from %s while the checkout is at %s\n' "${svc}" "${started}" "$(commit)" >&2
      rc=1
    else
      printf '%s: ok at %s\n' "${svc}" "${url}"
    fi
  done
  return "${rc}"
}

status() {
  resolve
  printf 'api   port %s\n' "${TREETIME_API_PORT}"
  printf 'web   port %s\n' "${TREETIME_WEB_PORT}"
  printf 'serve port %s\n' "${TREETIME_SERVE_PORT}"
  printf 'web2  port %s\n' "${TREETIME_WEB2_PORT}"
  printf 'web2 serve port %s\n' "${TREETIME_WEB2_SERVE_PORT}"
  printf 'docs  port %s\n' "${TREETIME_DOCS_PORT}"
  printf 'docs serve port %s\n' "${TREETIME_DOCS_SERVE_PORT}"
  if [[ -f "${route_dir}/web.hostnames.json" ]]; then
    jq -r '.urls[] | "web   public URL \(.)"' "${route_dir}/web.hostnames.json"
  else
    printf 'web   no public hostname\n'
  fi
  printf 'checkout HEAD %s\n' "$(commit)"
  local svc
  for svc in api web; do
    if [[ -f "${state_dir}/${svc}.json" ]]; then
      jq -r --arg svc "${svc}" '"\($svc)  started from \(.commit) at \(.url)"' "${state_dir}/${svc}.json"
    else
      printf '%s  not started\n' "${svc}"
    fi
  done
}

up_web2() {
  resolve
  printf 'Starting the web2 server on http://127.0.0.1:%s (Ctrl-C to stop)\n' "${TREETIME_WEB2_PORT}" >&2
  exec bun run --cwd packages/app-web2 dev
}

serve_web2() {
  resolve
  bun run --silent build:web2
  printf 'Serving the production web2 app on http://127.0.0.1:%s (Ctrl-C to stop)\n' "${TREETIME_WEB2_SERVE_PORT}" >&2
  exec bun run --cwd packages/app-web2 preview
}

docs() {
  resolve
  printf 'Starting the docs server on http://127.0.0.1:%s/dev (Ctrl-C to stop)\n' "${TREETIME_DOCS_PORT}" >&2
  exec bun run --cwd packages/app-docs dev
}

docs_prod() {
  resolve
  bun run --silent build:docs
  exec bun run --cwd packages/app-docs serve
}

case "${1:-}" in
up | serve | health | status) "${1}" ;;
up-web2 | serve-web2 | docs | docs-prod) "${1//-/_}" ;;
*)
  sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g" >&2
  exit 1
  ;;
esac
