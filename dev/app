#!/usr/bin/env bash
#
# Usage: $0 <health|status|up-web2|serve-web2|docs|docs-prod|desktop>
#
# Development servers of the apps. The web2 app needs no API server: its back
# end is the WebAssembly build in a web worker of the page, so it runs from one
# Vite server.
#
#   health      Probe the web2 development server; exit 1 when it is absent, not
#               answering, or started from another commit than the checkout HEAD
#   status      Print the resolved ports and URLs and what the web2 server was started from
#   up-web2     Start the web2 development server in the foreground until Ctrl-C;
#               both WebAssembly modules must be built (just build-wasm, just
#               build-wasm-mt)
#   serve-web2  Build the web2 app for production and serve it in the foreground
#               until Ctrl-C; both WebAssembly modules must be built (just
#               build-wasm prod, just build-wasm-mt prod)
#   docs        Start the docs site development server, which reloads pages and styles
#               as they change, in the foreground until Ctrl-C; it runs no post-build
#               step, so search and the version list work only in docs-prod
#   docs-prod   Build the docs site as published and serve the build with the file
#               layout of the docs host (the site root files at /, the build at
#               /<version>, pages without their extension) in the foreground until Ctrl-C
#   desktop     Start the desktop app in development mode with its renderer dev
#               server, in the foreground until Ctrl-C
#
# Each checkout takes its ports from its port slot (dev/lib/ports.sh), so
# worktrees run side by side: the main checkout uses 14000-14004, and a linked
# worktree the ports of the slot it claims. TREETIME_PORT_SLOT selects the slot,
# which dev/docker/run claims on the host and passes into the container.
# TREETIME_WEB2_PORT, TREETIME_WEB2_SERVE_PORT, TREETIME_DOCS_PORT,
# TREETIME_DOCS_SERVE_PORT and TREETIME_DESKTOP_PORT override single ports.
#
# A route launcher on the host can publish the web2 development server through an
# HTTPS proxy. The launcher writes the assigned hostnames to
# tmp/portless/web.hostnames.json as {"hostnames": [...], "urls": [...]} and then
# starts `up-web2`, which writes the port of the web2 server to tmp/portless/web.json
# as {"port": <n>} once the server answers. `status` prints the URLs. Without a
# launcher, nobody reads web.json and the server has no public hostname.
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "${root}"
# shellcheck source=lib/ports.sh
source "${root}/dev/lib/ports.sh"

state_dir="${root}/tmp/app/servers"
route_dir="${root}/tmp/portless"

resolve() {
  if [[ -z "${TREETIME_PORT_SLOT:-}" ]]; then
    TREETIME_PORT_SLOT="$(port_slot "${root}")"
  fi
  if ! [[ "${TREETIME_PORT_SLOT}" =~ ^[0-9]+$ ]] || ((TREETIME_PORT_SLOT >= port_slot_count)); then
    printf 'TREETIME_PORT_SLOT must be a slot number from 0 to %s, got: %s\n' "$((port_slot_count - 1))" "${TREETIME_PORT_SLOT}" >&2
    return 1
  fi
  export TREETIME_PORT_SLOT
  export TREETIME_WEB2_PORT="${TREETIME_WEB2_PORT:-$(port_of_slot "${TREETIME_PORT_SLOT}" 0)}"
  export TREETIME_WEB2_SERVE_PORT="${TREETIME_WEB2_SERVE_PORT:-$(port_of_slot "${TREETIME_PORT_SLOT}" 1)}"
  export TREETIME_DOCS_PORT="${TREETIME_DOCS_PORT:-$(port_of_slot "${TREETIME_PORT_SLOT}" 2)}"
  export TREETIME_DOCS_SERVE_PORT="${TREETIME_DOCS_SERVE_PORT:-$(port_of_slot "${TREETIME_PORT_SLOT}" 3)}"
  export TREETIME_DESKTOP_PORT="${TREETIME_DESKTOP_PORT:-$(port_of_slot "${TREETIME_PORT_SLOT}" 4)}"
}

commit() {
  git rev-parse --short HEAD
}

probe() {
  curl -fsS -o /dev/null --max-time 3 "${1}"
}

# Poll a URL until it answers. The server is a separate process whose only
# readiness signal is the socket; the timeout bounds a cold compile.
wait_ready() {
  local url="${1}" timeout="${2}" pid="${3}" elapsed=0
  until probe "${url}" 2>/dev/null; do
    ((elapsed < timeout)) || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    sleep 1
    elapsed=$((elapsed + 1))
  done
}

write_state() {
  mkdir -p "${state_dir}"
  jq -n --arg url "${2}" --arg commit "$(commit)" '{url: $url, commit: $commit}' >"${state_dir}/${1}.json"
}

# Rename into place, so a launcher that watches the folder never reads a partial file.
write_route_request() {
  local tmp
  mkdir -p "${route_dir}"
  tmp="$(mktemp "${route_dir}/.${1}.json.XXXXXX")"
  jq -n --argjson port "${2}" '{port: $port}' >"${tmp}" || {
    rm -f -- "${tmp}"
    return 1
  }
  mv -f -- "${tmp}" "${route_dir}/${1}.json"
}

stop_servers() {
  local pid
  for pid in "${pids[@]}"; do
    kill -TERM -- "-${pid}" 2>/dev/null || true
  done
}

health() {
  local state="${state_dir}/web2.json" url started
  if [[ ! -f "${state}" ]]; then
    printf 'web2: not started (start it with: just up-web2)\n' >&2
    return 1
  fi
  url="$(jq -r '.url' "${state}")"
  started="$(jq -r '.commit' "${state}")"
  if ! probe "${url}"; then
    printf 'web2: not answering at %s\n' "${url}" >&2
    return 1
  fi
  if [[ "${started}" != "$(commit)" ]]; then
    printf 'web2: stale, started from %s while the checkout is at %s\n' "${started}" "$(commit)" >&2
    return 1
  fi
  printf 'web2: ok at %s\n' "${url}"
}

status() {
  resolve
  printf 'port slot %s\n' "${TREETIME_PORT_SLOT}"
  printf 'web2  port %s\n' "${TREETIME_WEB2_PORT}"
  printf 'web2 serve port %s\n' "${TREETIME_WEB2_SERVE_PORT}"
  printf 'docs  port %s\n' "${TREETIME_DOCS_PORT}"
  printf 'docs serve port %s\n' "${TREETIME_DOCS_SERVE_PORT}"
  printf 'desktop port %s\n' "${TREETIME_DESKTOP_PORT}"
  if [[ -f "${route_dir}/web.hostnames.json" ]]; then
    jq -r '.urls[] | "web2  public URL \(.)"' "${route_dir}/web.hostnames.json"
  else
    printf 'web2  no public hostname\n'
  fi
  printf 'checkout HEAD %s\n' "$(commit)"
  if [[ -f "${state_dir}/web2.json" ]]; then
    jq -r '"web2  started from \(.commit) at \(.url)"' "${state_dir}/web2.json"
  else
    printf 'web2  not started\n'
  fi
}

up_web2() {
  resolve
  rm -f -- "${state_dir}/web2.json"
  local url="http://127.0.0.1:${TREETIME_WEB2_PORT}/"
  if probe "${url}" 2>/dev/null; then
    printf 'A server already answers at %s; stop it before starting another (just status)\n' "${url}" >&2
    return 1
  fi

  pids=()
  # The server runs in its own process group, so stopping it reaches the children of bun too.
  # A signal ends the script through exit, so the EXIT trap stops the group.
  set -m
  trap stop_servers EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  printf 'Starting the web2 server on %s\n' "${url}" >&2
  bun run --cwd packages/app-web2 dev &
  pids+=("$!")
  wait_ready "${url}" 300 "${pids[0]}" || {
    printf 'The web2 server did not answer at %s\n' "${url}" >&2
    return 1
  }
  write_state web2 "${url}"
  write_route_request web "${TREETIME_WEB2_PORT}"

  printf 'Ready: %s (Ctrl-C to stop)\n' "${url}" >&2
  wait -n "${pids[@]}"
}

serve_web2() {
  resolve
  bun run --silent build:web2
  printf 'Serving the production web2 app on http://127.0.0.1:%s (Ctrl-C to stop)\n' "${TREETIME_WEB2_SERVE_PORT}" >&2
  exec bun run --cwd packages/app-web2 preview
}

docs() {
  resolve
  printf 'Starting the docs server on http://127.0.0.1:%s/dev (Ctrl-C to stop)\n' "${TREETIME_DOCS_PORT}" >&2
  exec bun run --cwd packages/app-docs dev
}

docs_prod() {
  resolve
  bun run --silent build:docs
  exec bun run --cwd packages/app-docs serve
}

desktop() {
  resolve
  exec bun run --silent dev:desktop
}

case "${1:-}" in
health | status | desktop) "${1}" ;;
up-web2 | serve-web2 | docs | docs-prod) "${1//-/_}" ;;
*)
  sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g" >&2
  exit 1
  ;;
esac
