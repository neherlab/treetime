#!/usr/bin/env bash
#
# Usage: $0 <generate|check> [group...]
#
# Regenerate the committed generated files, or check that the committed copies
# match a fresh generation. `check` writes nothing into the working tree. Without
# groups, every group is processed.
#
# Groups:
#   schemas     packages/schemas/*.schema.json, from the CLI and data types (schemars)
#   openapi     packages/app-contracts/openapi.json, from the app-server handlers (aide)
#   catalog     packages/app-contracts/setting-catalog.json, the setting catalog of the app commands
#   ts-client   packages/app-contracts/src/generated/, from openapi.json (@hey-api/openapi-ts)
#   napi-types  packages/app-napi/index.d.ts, from the #[napi] exports of the Node addon
#   wasm-types  packages/app-wasm/pkg/app_wasm.d.ts, from the #[wasm_bindgen] exports of the
#               WebAssembly back end
#   cli-docs    packages/app-docs/src/generated/en/reference/cli.md, from the CLI help tree
#   data-index  data/index.json, the index of the example data, from the files git tracks in data/
#   i18n        packages/app-ui/src/i18n/generated/, the Paraglide message modules, from the inlang
#               project packages/app-ui/project.inlang and packages/app-ui/messages/
#   design      packages/design/src/css/{tokens,tailwind-theme}.css, packages/design/matplotlib/neherlab.mplstyle,
#               and packages/treetime-charts/src/palette.rs, from the design tokens in
#               packages/design/src/tokens/tokens.ts
#
# Examples:
#   $0 check
#   $0 generate openapi ts-client
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "${root}"

all_groups=(schemas openapi catalog ts-client napi-types wasm-types cli-docs data-index i18n design)

# Each produce_<group> writes the files of the group below the given directory,
# at their repository-relative paths, and prints those paths, one per line.
produce_schemas() {
  mkdir -p "${1}/packages/schemas"
  cargo run --locked --quiet --bin treetime -- schema write --for all -o "${1}/packages/schemas" >&2
  printf 'packages/schemas\n'
}

produce_openapi() {
  mkdir -p "${1}/packages/app-contracts"
  cargo run --locked --quiet -p app-server --bin generate-openapi -- "${1}/packages/app-contracts/openapi.json" >&2
  printf 'packages/app-contracts/openapi.json\n'
}

produce_catalog() {
  mkdir -p "${1}/packages/app-contracts"
  cargo run --locked --quiet -p app-server --bin generate-setting-catalog -- "${1}/packages/app-contracts/setting-catalog.json" >&2
  printf 'packages/app-contracts/setting-catalog.json\n'
}

produce_ts_client() {
  mkdir -p "${1}/packages/app-contracts/src/generated"
  (cd packages/app-contracts && bun run --silent generate --output "${1}/packages/app-contracts/src/generated") >&2
  printf 'packages/app-contracts/src/generated\n'
}

produce_napi_types() {
  mkdir -p "${1}/packages/app-napi"
  (cd packages/app-napi && bun run --silent generate --output-dir "${1}/packages/app-napi") >&2
  printf 'packages/app-napi/index.d.ts\n'
}

produce_wasm_types() {
  mkdir -p "${1}/packages/app-wasm/pkg"
  cargo build --locked --quiet --config=dev/cargo/wasm-st.toml --target=wasm32-unknown-emscripten -p app-wasm >&2
  cp "${CARGO_TARGET_DIR:-target}/wasm32-unknown-emscripten/debug/deps/app-wasm.d.ts" \
    "${1}/packages/app-wasm/pkg/app_wasm.d.ts"
  printf 'packages/app-wasm/pkg/app_wasm.d.ts\n'
}

produce_cli_docs() {
  cargo build --locked --quiet --bin treetime >&2
  dev/generate-reference-docs "${CARGO_TARGET_DIR:-target}/debug/treetime" \
    "${1}/packages/app-docs/src/generated/en/reference/cli.md"
  printf 'packages/app-docs/src/generated/en/reference/cli.md\n'
}

produce_data_index() {
  mkdir -p "${1}/data"
  dev/data-reindex --output "${1}/data/index.json" >&2
  printf 'data/index.json\n'
}

# The inlang SDK downloads and runs a module that settings.json names by URL, and
# compiles without messages when a module fails to load, so both stop the group.
produce_i18n() {
  local settings=packages/app-ui/project.inlang/settings.json output
  if jq -e '.modules[] | select(test("^[a-z][a-z0-9+.-]*:"; "i"))' "${settings}" >/dev/null; then
    printf '%s names a module by URL; load the inlang plugins from node_modules\n' "${settings}" >&2
    return 1
  fi
  output="$(bun run --silent --cwd packages/app-ui i18n --outdir "${1}/packages/app-ui/src/i18n/generated" 2>&1)"
  if grep -qE 'WARN|ERROR|Error' <<<"${output}"; then
    printf '%s\n' "${output}" >&2
    return 1
  fi
  printf 'packages/app-ui/src/i18n/generated\n'
}

produce_design() {
  bun packages/design/build/generate.ts --outdir "${1}"
}

main() {
  local mode="${1:-}"
  case "${mode}" in
  generate | check) shift ;;
  -h | --help | *)
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
    [[ "${mode}" == -h || "${mode}" == --help ]]
    return
    ;;
  esac

  local groups=("$@")
  if ((${#groups[@]} == 0)); then
    groups=("${all_groups[@]}")
  fi

  out="$(mktemp -d)"
  trap 'rm -rf "${out}"' EXIT

  local group path paths produced rc=0
  for group in "${groups[@]}"; do
    case " ${all_groups[*]} " in
    *" ${group} "*) ;;
    *)
      printf 'Unknown group: %s (%s)\n' "${group}" "${all_groups[*]}" >&2
      return 1
      ;;
    esac
    printf '==> %s\n' "${group}" >&2
    produced="$("produce_${group//-/_}" "${out}")"
    mapfile -t paths <<<"${produced}"
    for path in "${paths[@]}"; do
      if [[ "${mode}" == generate ]]; then
        if [[ ! -e "${out}/${path}" ]]; then
          printf 'The generator produced no %s\n' "${path}" >&2
          return 1
        fi
        rm -rf "${path:?}"
        mkdir -p "$(dirname "${path}")"
        cp -R "${out}/${path}" "${path}"
      elif ! diff -ru "${path}" "${out}/${path}" >&2; then
        printf 'The committed %s is stale; regenerate it with: just gen %s\n' "${path}" "${group}" >&2
        rc=1
      fi
    done
  done
  return "${rc}"
}

main "$@"
