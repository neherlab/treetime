#!/usr/bin/env bash
#
# Usage: $0 [--serial] <check>...
#
# Run just recipes as checks, in parallel by default, and keep going past
# failures. A check is a recipe name, followed by its arguments separated by
# colons: `build-wasm:prod` runs `just build-wasm prod`. Each check writes its
# output to tmp/checks/<check>.log. Prints nothing when every check passes. A
# FAIL line is printed as each check fails, and the output of every failed
# check and the list of failed checks at the end. Exits 1 when any check failed.
#
# Options:
#   -h, --help   Show this help
#   --serial     Run the checks one after another, with the output of each
#                streamed under a line that names it
#
# Examples:
#   $0 fmt-check lint typecheck
#   $0 --serial test
#   $0 build-wasm:prod
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
log_dir="${root}/tmp/checks"

show_help() {
  sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
}

seconds_since() {
  printf '%s' "$(($(date +%s) - ${1}))"
}

run_check() {
  local words
  IFS=: read -ra words <<<"${1}"
  just "${words[@]}"
}

run_serial() {
  local recipe start failed=()
  for recipe in "$@"; do
    printf '\n==> %s\n' "${recipe}" >&2
    start="$(date +%s)"
    if ! run_check "${recipe}" 2>&1 | tee "${log_dir}/${recipe}.log"; then
      printf 'FAIL %s (%ss)\n' "${recipe}" "$(seconds_since "${start}")" >&2
      failed+=("${recipe}")
    fi
  done
  report "${failed[@]+"${failed[@]}"}"
}

run_parallel() {
  local recipe pids=() start
  start="$(date +%s)"
  for recipe in "$@"; do
    (
      if ! run_check "${recipe}" >"${log_dir}/${recipe}.log" 2>&1; then
        printf 'FAIL %s (%ss)\n' "${recipe}" "$(seconds_since "${start}")" >&2
        exit 1
      fi
    ) &
    pids+=("$!")
  done

  local i failed=()
  for i in "${!pids[@]}"; do
    if ! wait "${pids[${i}]}"; then
      failed+=("${@:$((i + 1)):1}")
    fi
  done
  for recipe in "${failed[@]+"${failed[@]}"}"; do
    printf '\n==> Output of failed check %s (%s)\n' "${recipe}" "tmp/checks/${recipe}.log" >&2
    cat "${log_dir}/${recipe}.log" >&2
  done
  report "${failed[@]+"${failed[@]}"}"
}

report() {
  if (($# == 0)); then
    return 0
  fi
  printf '\nFailed checks:\n' >&2
  printf '  %s\n' "$@" >&2
  return 1
}

main() {
  local serial=""
  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      show_help
      exit 0
      ;;
    --serial)
      serial=1
      shift
      ;;
    -*)
      printf 'Unknown option: %s\n' "${1}" >&2
      exit 1
      ;;
    *) break ;;
    esac
  done
  if (($# == 0)); then
    show_help >&2
    exit 1
  fi

  mkdir -p "${log_dir}"
  if [[ -n "${serial}" ]]; then
    run_serial "$@"
  else
    run_parallel "$@"
  fi
}

main "$@"
