#!/usr/bin/env bash
#
# Usage: $0 [options] <bin>...
#
# Cross-compile release binaries for every target in dev/cross/targets, each in
# its cross image, in parallel. Output goes to .out/<bin>-<target>, one log per
# target to tmp/cross/<target>.log.
#
# Options:
#   -h, --help          Show this help
#   --target=<triple>   Build this target only (repeatable)
#   --serial            Build one target after another, with output streamed
#   --run               Run each binary with `--help` after building (QEMU, Wine)
#
# Examples:
#   $0 treetime
#   $0 --target=aarch64-apple-darwin --target=x86_64-pc-windows-gnu treetime
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"

build_one() {
  local target="${1}"
  shift
  local bin
  for bin in "${bins[@]}"; do
    CROSS_COMPILE="${target}" dev/docker/run dev/cross/build "${bin}" "${target}"
    CROSS_COMPILE="${target}" dev/docker/run dev/cross/check "${bin}" "${target}"
    if [[ -n "${run}" && "${target}" != *-apple-darwin ]]; then
      CROSS_COMPILE="${target}" dev/docker/run dev/cross/run "${bin}" "${target}" --help >/dev/null
    fi
  done
}

main() {
  local targets=() serial="" target
  run=""
  bins=()
  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
      exit 0
      ;;
    --target=*) targets+=("${1#--target=}") ;;
    --serial) serial=1 ;;
    --run) run=1 ;;
    -*)
      printf 'Unknown option: %s\n' "${1}" >&2
      exit 1
      ;;
    *) bins+=("${1}") ;;
    esac
    shift
  done
  if ((${#bins[@]} == 0)); then
    printf 'No binary given; see --help\n' >&2
    exit 1
  fi
  if ((${#targets[@]} == 0)); then
    mapfile -t targets <dev/cross/targets
  fi

  mkdir -p tmp/cross
  if [[ -n "${serial}" ]]; then
    for target in "${targets[@]}"; do
      build_one "${target}"
    done
    return
  fi

  local pids=() failed=() i
  for target in "${targets[@]}"; do
    build_one "${target}" >"tmp/cross/${target}.log" 2>&1 &
    pids+=("$!")
  done
  printf 'Building %s targets in parallel; logs in tmp/cross/\n' "${#targets[@]}" >&2
  for i in "${!pids[@]}"; do
    if wait "${pids[${i}]}"; then
      printf 'PASS %s\n' "${targets[${i}]}" >&2
    else
      printf 'FAIL %s (tmp/cross/%s.log)\n' "${targets[${i}]}" "${targets[${i}]}" >&2
      failed+=("${targets[${i}]}")
    fi
  done
  ((${#failed[@]} == 0))
}

main "$@"
