#!/usr/bin/env bash
#
# Usage: $0 [options] <bin>...
#        $0 --lib [options] <package>...
#
# Cross-compile shipped (dist profile) binaries for every target in
# dev/cross/targets, each in its cross image, in parallel. Output goes to
# .out/<bin>-<target>, one log per target to tmp/cross/<target>.log.
# Parallel builds divide the CPU budget of dev/docker/run (TREETIME_DOCKER_CPUS)
# between the targets, so all targets together use at most that many CPUs.
#
# With --lib, build the shared library of each package instead (the Node addon
# of the desktop app, package app-napi) for every target in
# dev/cross/targets-desktop, the targets Electron supports. Output goes to
# .out/<package>-<target>.node (see `dev/cross/build --help`).
#
# Options:
#   -h, --help          Show this help
#   --lib               Build shared libraries of packages instead of binaries
#   --target=<triple>   Build this target only (repeatable)
#   --serial            Build one target after another, with output streamed
#   --run               Run each binary with `--help` after building (QEMU, Wine),
#                       and run each Linux binary on the oldest CPU of its baseline
#                       (dev/cross/check-cpus); macOS and aarch64 Windows binaries
#                       are only built and checked
#
# Examples:
#   $0 treetime
#   $0 --target=aarch64-apple-darwin --target=x86_64-pc-windows-gnullvm treetime
#   $0 --lib app-napi
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"
# shellcheck source=../lib/env.sh
source "${root}/dev/lib/env.sh"
load_env_file "${root}/.env"

build_one() {
  local target="${1}"
  shift
  local bin
  for bin in "${bins[@]}"; do
    CROSS_COMPILE="${target}" dev/docker/run dev/cross/build "${mode[@]}" "${bin}" "${target}"
    CROSS_COMPILE="${target}" dev/docker/run dev/cross/check "${mode[@]}" "${bin}" "${target}"
    if [[ -z "${run}" || -n "${lib}" ]]; then
      continue
    fi
    local reason
    reason="$(no_run_reason "${target}")"
    if [[ -n "${reason}" ]]; then
      printf 'Not running %s for %s: %s\n' "${bin}" "${target}" "${reason}" >&2
      continue
    fi
    CROSS_COMPILE="${target}" dev/docker/run dev/cross/run "${bin}" "${target}" --help >/dev/null
    # aarch64 Linux kernels run with 4K, 16K, or 64K pages; QEMU emulates the
    # largest.
    if [[ "${target}" == aarch64-*-linux-* ]]; then
      CROSS_COMPILE="${target}" dev/docker/run env QEMU_PAGESIZE=65536 dev/cross/run "${bin}" "${target}" --help >/dev/null
    fi
    if [[ "${target}" == *-linux-* ]]; then
      CROSS_COMPILE="${target}" dev/docker/run dev/cross/check-cpus "${bin}" "${target}"
    fi
  done
}

# Print why the binaries of a target cannot run in its cross image, or nothing
# when they can.
no_run_reason() {
  case "${1}" in
  *-apple-darwin) printf 'macOS programs do not run on Linux\n' ;;
  aarch64-*-windows-*) printf 'Wine runs only x86_64 Windows programs\n' ;;
  esac
}

main() {
  local targets=() serial="" target
  run=""
  lib=""
  mode=()
  bins=()
  while (($# > 0)); do
    case "${1}" in
    -h | --help)
      sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
      exit 0
      ;;
    --target=*) targets+=("${1#--target=}") ;;
    --serial) serial=1 ;;
    --run) run=1 ;;
    --lib) lib=1 mode=(--lib) ;;
    -*)
      printf 'Unknown option: %s\n' "${1}" >&2
      exit 1
      ;;
    *) bins+=("${1}") ;;
    esac
    shift
  done
  if ((${#bins[@]} == 0)); then
    printf 'No binary given; see --help\n' >&2
    exit 1
  fi
  if ((${#targets[@]} == 0)); then
    if [[ -n "${lib}" ]]; then
      mapfile -t targets <dev/cross/targets-desktop
    else
      mapfile -t targets <dev/cross/targets
    fi
  fi

  mkdir -p tmp/cross
  if [[ -n "${serial}" ]]; then
    for target in "${targets[@]}"; do
      build_one "${target}"
    done
    return
  fi

  local budget
  budget="$(docker_cpu_budget)"
  TREETIME_DOCKER_CPUS="$(docker_cpu_share "${budget}" "${#targets[@]}")"
  export TREETIME_DOCKER_CPUS
  local pids=() failed=() i
  for target in "${targets[@]}"; do
    build_one "${target}" >"tmp/cross/${target}.log" 2>&1 &
    pids+=("$!")
  done
  printf 'Building %s targets in parallel with %s CPUs each; logs in tmp/cross/\n' "${#targets[@]}" "${TREETIME_DOCKER_CPUS}" >&2
  for i in "${!pids[@]}"; do
    if wait "${pids[${i}]}"; then
      printf 'PASS %s\n' "${targets[${i}]}" >&2
    else
      printf 'FAIL %s (tmp/cross/%s.log)\n' "${targets[${i}]}" "${targets[${i}]}" >&2
      failed+=("${targets[${i}]}")
    fi
  done
  ((${#failed[@]} == 0))
}

main "$@"
