#!/usr/bin/env bash
#
# Usage: $0 <bin> [target]
#
# Build a shipped (dist profile) binary for a target inside its cross image and
# copy it to .out/<bin>-<target>. The target defaults to CROSS_COMPILE, which
# dev/docker/run sets in the cross images.
#
# Examples:
#   CROSS_COMPILE=aarch64-apple-darwin dev/docker/run dev/cross/build treetime
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"

bin="${1:?binary name}"
target="${2:-${CROSS_COMPILE:?target}}"
target_safe="${target//-/_}"

case "${target}" in
aarch64-apple-*)
  c_arch="-mcpu=apple-m1"
  rust_arch="-C target-cpu=apple-m1"
  ;;
aarch64-*)
  # Features of -C target-feature=+v8.2a, which is unstable, listed explicitly.
  c_arch="-march=armv8.2-a"
  rust_arch="-C target-cpu=generic -C target-feature=+crc,+dpb,+lor,+lse,+neon,+pan,+ras,+rdm,+vh"
  ;;
x86_64-*)
  c_arch="-march=haswell"
  rust_arch="-C target-cpu=haswell"
  ;;
*)
  printf 'Unsupported target: %s\n' "${target}" >&2
  exit 1
  ;;
esac

static="-C target-feature=+crt-static -C link-arg=-static -C link-self-contained=yes"
case "${target}" in
*-apple-darwin)
  # https://github.com/NixOS/nixpkgs/issues/177129
  rustflags="${rust_arch} -C target-feature=+crt-static -C link-arg=-lgcc_eh"
  ;;
*-linux-gnu)
  rustflags="${rust_arch}"
  ;;
*-linux-musl)
  # The musl toolchains do not find these libraries on their own.
  rustflags="${rust_arch} -C link-args=-lpthread -C link-args=-lm -C link-args=-lc ${static}"
  ;;
*-windows-gnu)
  rustflags="${rust_arch} ${static}"
  ;;
esac
# The cross images install the OpenBLAS archive into OPENBLAS_LIB_DIR. The
# openblas-src build script passes that directory to the linker, but
# .cargo/config.toml replaces the script for x86_64-unknown-linux-gnu, and the
# cross linkers do not search LIBRARY_PATH.
rustflags="${rustflags} -L native=${OPENBLAS_LIB_DIR:?}"

c_flags="-O3 -ftree-vectorize -funroll-loops ${c_arch}"
# RUSTFLAGS replaces the target rustflags of .cargo/config.toml (native mold
# linking and development flags) instead of adding to them.
export RUSTFLAGS="${rustflags}"
export "CFLAGS_${target_safe}=${CFLAGS:-} ${c_flags}"
export "CXXFLAGS_${target_safe}=${CXXFLAGS:-} ${c_flags}"
export "FCFLAGS_${target_safe}=${FCFLAGS:-} ${c_flags}"

# The optional kache compiler cache (KACHE_STORE in .env.example), one store per
# kache version and target, next to the stores of the justfile.
if [[ -n "${KACHE_STORE:-}" ]]; then
  kache_version="$(kache --version)"
  export RUSTC_WRAPPER="kache"
  export KACHE_CACHE_DIR="${KACHE_STORE}/${kache_version##* }/docker-cross-${target}"
  export KACHE_MAX_SIZE="${KACHE_MAX_SIZE:-100GiB}"
fi

target_dir="${root}/.build/cross/${target}"
cargo build --locked --profile=dist --target="${target}" --target-dir="${target_dir}" --bin="${bin}"

ext=""
[[ "${target}" == *windows* ]] && ext=".exe"
mkdir -p .out
cp "${target_dir}/${target}/dist/${bin}${ext}" ".out/${bin}-${target}${ext}"
printf 'Built .out/%s-%s%s\n' "${bin}" "${target}" "${ext}" >&2
