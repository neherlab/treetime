#!/usr/bin/env bash
#
# Usage: $0 <bin> [target]
#        $0 --lib <package> [target]
#
# Build a shipped (dist profile) binary for a target inside its cross image and
# copy it to .out/<bin>-<target>. The target defaults to CROSS_COMPILE, which
# dev/docker/run sets in the cross images.
#
# With --lib, build the shared library of a package instead, with the same
# profile and CPU flags, and copy it to .out/<package>-<target>.node. This
# builds the Node addon of the desktop app (package app-napi). Linux musl
# targets cannot build it: a statically linked C runtime cannot be a shared
# library.
#
# Examples:
#   CROSS_COMPILE=aarch64-apple-darwin dev/docker/run dev/cross/build treetime
#   CROSS_COMPILE=x86_64-pc-windows-gnu dev/docker/run dev/cross/build --lib app-napi
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"

lib=""
if [[ "${1:-}" == "--lib" ]]; then
  lib=1
  shift
fi
name="${1:?binary or package name}"
target="${2:-${CROSS_COMPILE:?target}}"
target_safe="${target//-/_}"

# shellcheck source=../lib/dist-flags.sh
source "${root}/dev/lib/dist-flags.sh"
export_dist_flags "${target}"

static="-C target-feature=+crt-static -C link-arg=-static -C link-self-contained=yes"
case "${target}" in
*-apple-darwin)
  # https://github.com/NixOS/nixpkgs/issues/177129
  rustflags="${RUSTFLAGS} -C target-feature=+crt-static -C link-arg=-lgcc_eh"
  ;;
*-linux-gnu)
  rustflags="${RUSTFLAGS}"
  # The CLI links the GCC unwinder statically, so it needs no libgcc_s.so.1 and
  # runs on images that carry glibc alone (see the linker script in
  # dev/cross/static-unwinder/). The Node addon keeps the shared unwinder of
  # the Electron process that loads it.
  if [[ -z "${lib}" ]]; then
    rustflags="${rustflags} -L native=${root}/dev/cross/static-unwinder"
  fi
  ;;
*-linux-musl)
  if [[ -n "${lib}" ]]; then
    printf 'Cannot build a shared library for %s\n' "${target}" >&2
    exit 1
  fi
  # The musl toolchains do not find these libraries on their own.
  rustflags="${RUSTFLAGS} -C link-args=-lpthread -C link-args=-lm -C link-args=-lc ${static}"
  ;;
*-windows-gnu)
  # The MinGW startup objects and libraries come from the toolchain of the
  # image, which also built libgcc, libgfortran, and OpenBLAS. With the copies
  # that rustc bundles (link-self-contained), even a minimal program built with
  # the GCC 14 toolchain overflows its stack at startup.
  rustflags="${RUSTFLAGS} -C target-feature=+crt-static -C link-arg=-static"
  ;;
esac
# OpenBLAS calls LAPACK routines written in Fortran, which need the Fortran
# runtime; the openblas-src build script does not declare it. The static
# archives of the Fortran compiler of the image are linked, so no binary depends
# on a shared libgfortran, and libquadmath goes along where the target has it.
fc_var="FC_${target_safe}"
fc="${!fc_var:?the cross image sets ${fc_var}}"
fortran_runtime=()
for archive in libgfortran.a libquadmath.a; do
  path="$("${fc}" -print-file-name="${archive}")"
  if [[ "${path}" == /* ]]; then
    fortran_runtime+=("${path}")
  fi
done
[[ "${fortran_runtime[0]:-}" == */libgfortran.a ]] || {
  printf 'ERROR: %s has no libgfortran.a\n' "${fc}" >&2
  exit 1
}

# The Fortran runtime goes to the end of the link line, after the libraries
# that rustc lists. The C libraries it needs come after it again, because a
# linker resolves an archive only against the libraries that follow it; on
# glibc this also brings in the loader that provides __tls_get_addr, and
# libgcc provides the integer and float128 helpers of libgfortran and
# libquadmath, because rustc links with -nodefaultlibs.
case "${target}" in
*-linux-gnu) runtime_deps=(-lm -lpthread -lc -lgcc) ;;
*-linux-musl) runtime_deps=(-lc -lgcc) ;;
*-windows-gnu) runtime_deps=(-l:libpthread.a -lmingw32 -lmingwex -lmsvcrt -lkernel32 -lgcc) ;;
*) runtime_deps=() ;;
esac
if [[ "${target}" == *-windows-gnu ]]; then
  rustflags="${rustflags} -C link-arg=-Wl,--start-group"
fi
for arg in "${fortran_runtime[@]}" "${runtime_deps[@]}"; do
  rustflags="${rustflags} -C link-arg=${arg}"
done
if [[ "${target}" == *-windows-gnu ]]; then
  rustflags="${rustflags} -C link-arg=-Wl,--end-group"
fi

# The cross images install the OpenBLAS archive into OPENBLAS_LIB_DIR. Only
# this flag passes that directory to the linker: the openblas-src build script
# names the library without a search path, and the cross linkers do not search
# LIBRARY_PATH. The build script skips pkg-config, because the openblas.pc of
# the archive names the directory that OpenBLAS was built in.
rustflags="${rustflags} -L native=${OPENBLAS_LIB_DIR:?}"
export OPENBLAS_NO_PKG_CONFIG=1

export RUSTFLAGS="${rustflags}"

# The optional kache compiler cache (KACHE_STORE in .env.example), one store per
# kache version and target, next to the stores of the justfile.
if [[ -n "${KACHE_STORE:-}" ]]; then
  kache_version="$(kache --version)"
  export RUSTC_WRAPPER="kache"
  export KACHE_CACHE_DIR="${KACHE_STORE}/${kache_version##* }/docker-cross-${target}"
  export KACHE_MAX_SIZE="${KACHE_MAX_SIZE:-100GiB}"
fi

target_dir="${root}/.build/cross/${target}"
out_dir="${target_dir}/${target}/dist"
mkdir -p .out

# Cargo tracks neither the C compilers nor the native libraries of the image,
# so a target directory left by another image would keep objects and links of
# the old toolchain and OpenBLAS. The directory records the image that built it
# and starts over when the image changes or is unknown.
image_record="${target_dir}/.image"
if [[ -d "${target_dir}" && "$(cat "${image_record}" 2>/dev/null)" != "${TREETIME_IMAGE:?dev/docker/run sets TREETIME_IMAGE}" ]]; then
  printf 'Removing %s, which another image built\n' "${target_dir}" >&2
  rm -rf "${target_dir}"
fi
mkdir -p "${target_dir}"
printf '%s\n' "${TREETIME_IMAGE}" >"${image_record}"

if [[ -n "${lib}" && "${target}" == *-windows-gnu ]]; then
  # napi-build assumes that a Windows GNU target means the MSYS2 build of Node,
  # which keeps Node-API in libnode.dll: the build scripts of the napi crate and
  # of the addon panic unless they find that file, then link it. Node and
  # Electron for Windows are built with MSVC and export Node-API from the
  # executable, and napi-sys loads every Node-API function at run time (its
  # default dyn-symbols feature). An empty libnode.dll satisfies the lookup; the
  # addon uses none of its symbols, so the DLL imports nothing from it, which
  # dev/cross/check verifies.
  linker_var="CARGO_TARGET_$(tr '[:lower:]' '[:upper:]' <<<"${target_safe}")_LINKER"
  export LIBNODE_PATH="${target_dir}/libnode"
  mkdir -p "${LIBNODE_PATH}"
  "${!linker_var}" -shared -o "${LIBNODE_PATH}/libnode.dll" -x c /dev/null
fi

if [[ -n "${lib}" ]]; then
  cargo build --locked --profile=dist --target="${target}" --target-dir="${target_dir}" --package="${name}" --lib
  lib_name="${name//-/_}"
  case "${target}" in
  *-apple-darwin) lib_file="lib${lib_name}.dylib" ;;
  *-windows-gnu) lib_file="${lib_name}.dll" ;;
  *) lib_file="lib${lib_name}.so" ;;
  esac
  cp "${out_dir}/${lib_file}" ".out/${name}-${target}.node"
  printf 'Built .out/%s-%s.node\n' "${name}" "${target}" >&2
  exit 0
fi

cargo build --locked --profile=dist --target="${target}" --target-dir="${target_dir}" --bin="${name}"

ext=""
[[ "${target}" == *windows* ]] && ext=".exe"
cp "${out_dir}/${name}${ext}" ".out/${name}-${target}${ext}"
printf 'Built .out/%s-%s%s\n' "${name}" "${target}" "${ext}" >&2
