#!/usr/bin/env bash
#
# Usage: $0 <bin> [target]
#
# Check a cross-compiled binary in .out/: print its format and linkage, and fail
# when a binary that must be static is not (musl and Windows targets).
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"

bin="${1:?binary name}"
target="${2:-${CROSS_COMPILE:?target}}"
ext=""
[[ "${target}" == *windows* ]] && ext=".exe"

file -h ".out/${bin}-${target}${ext}"
dev/is-static-binary ".out/${bin}-${target}${ext}" "${target}"
