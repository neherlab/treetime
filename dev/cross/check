#!/usr/bin/env bash
#
# Usage: $0 <bin> [target]
#        $0 --lib <package> [target]
#
# Check a cross-compiled binary in .out/: print its format and linkage, and fail
# when it needs a library that is not part of the operating system, or when a
# binary that must be static is not (musl targets).
#
# With --lib, check the shared library .out/<package>-<target>.node built by
# `dev/cross/build --lib` the same way.
#
# The operating system libraries are:
# - Linux (gnu): the libraries of glibc 2.17 or older; the Node addon may also
#   need libgcc_s.so.1, which Electron needs too
# - Windows: KERNEL32.dll, the Universal C Runtime (api-ms-win-crt-*.dll), and
#   the other system DLLs listed in windows_system_dlls
# - Windows 7 (x86_64-win7-windows-gnu): the DLLs of windows7_system_dlls,
#   msvcrt.dll as the C runtime, and none of the functions that Windows 8 or
#   later added (the list WINDOWS8_FUNCTIONS of the image, from the mingw-w64
#   headers)
# - macOS: libraries in /usr/lib and frameworks in /System/Library
#
# It also fails when a macOS binary names another minimum macOS version than the
# deployment target of its image, and when a binary of any target contains
# instructions above the CPU baseline of its target (dev/lib/dist-flags.sh)
# outside the functions of dev/cross/isa-allowlist, which run only after a check
# of the CPU at run time. The symbol tables of the ELF, COFF, and Mach-O files
# name the function of each instruction.
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"

glibc_max="2.17"
glibc_libs='^(libc\.so\.6|libm\.so\.6|libpthread\.so\.0|libdl\.so\.2|librt\.so\.1|libutil\.so\.1|ld-linux-x86-64\.so\.2|ld-linux-aarch64\.so\.1)$'
electron_libs='^libgcc_s\.so\.1$'
windows_system_dlls='^(api-ms-win-[a-z0-9-]+|kernel32|ntdll|advapi32|bcrypt|bcryptprimitives|combase|crypt32|ncrypt|secur32|ws2_32|userenv|user32|shell32|ole32|oleaut32|iphlpapi|powrprof|dbghelp|synchronization)\.dll$'
windows7_system_dlls='^(kernel32|ntdll|msvcrt|advapi32|bcrypt|crypt32|ncrypt|secur32|ws2_32|userenv|user32|shell32|ole32|oleaut32|iphlpapi|powrprof|dbghelp|psapi|rpcrt4)\.dll$'
darwin_system_libs='^(/usr/lib/|/system/library/)'

lib=""
if [[ "${1:-}" == "--lib" ]]; then
  lib=1
  shift
fi
name="${1:?binary or package name}"
target="${2:-${CROSS_COMPILE:?target}}"
target_safe="${target//-/_}"

# Print the libraries a binary or shared library needs, one per line.
dependencies() {
  local file="${1}" objdump otool
  objdump="$(printenv "OBJDUMP_${target_safe}" || printenv "OBJDUMP" || echo "objdump")"
  otool="$(printenv "OTOOL_${target_safe}" || printenv "OTOOL" || echo "otool")"
  case "${target}" in
  *-apple-darwin)
    local id
    id="$("${otool}" -D "${file}" | awk 'NR > 1')"
    "${otool}" -L "${file}" | awk -v id="${id}" 'NR > 1 && $1 != id {print $1}'
    ;;
  *-windows-*) "${objdump}" -p "${file}" | awk '/DLL Name:/ {print $3}' ;;
  *) "${objdump}" -p "${file}" | awk '$1 == "NEEDED" {print $2}' ;;
  esac
}

# Print the dependencies that are not libraries of the operating system.
foreign_dependencies() {
  local allowed extra=""
  case "${target}" in
  *-apple-darwin) allowed="${darwin_system_libs}" ;;
  *-win7-windows-gnu) allowed="${windows7_system_dlls}" ;;
  *-windows-*) allowed="${windows_system_dlls}" ;;
  *-linux-gnu)
    allowed="${glibc_libs}"
    if [[ -n "${lib}" ]]; then
      extra="${electron_libs}"
    fi
    ;;
  *) allowed='^$' ;;
  esac
  dependencies "${1}" | allowed="${allowed}" extra="${extra}" awk '
    { name = tolower($0) }
    name !~ ENVIRON["allowed"] && (ENVIRON["extra"] == "" || name !~ ENVIRON["extra"])
  '
}

# Print the imported functions of a Windows program that Windows 7 lacks, as
# <dll> <function>.
windows8_imports() {
  local readobj
  readobj="$(printenv "READOBJ_${target_safe}" || echo "llvm-readobj")"
  "${readobj}" --coff-imports "${1}" |
    awk '$1 == "Name:" {dll = tolower($2)} $1 == "Symbol:" {print dll, $2}' |
    awk 'NR == FNR {denied[$1] = 1; next} $2 in denied' "${WINDOWS8_FUNCTIONS:?the Windows 7 image names the list of the functions of Windows 8 or later}" -
}

# Print the minimum macOS version that a binary names.
macos_min_version() {
  local otool
  otool="$(printenv "OTOOL_${target_safe}" || printenv "OTOOL" || echo "otool")"
  "${otool}" -l "${1}" | awk '
    $1 == "cmd" { cmd = $2 }
    cmd == "LC_BUILD_VERSION" && $1 == "minos" { print $2; exit }
    cmd == "LC_VERSION_MIN_MACOSX" && $1 == "version" { print $2; exit }
  '
}

# Print the instructions above the CPU baseline of the target, which
# dev/lib/dist-flags.sh sets, as <count> <function>, except in the functions of
# dev/cross/isa-allowlist.
# - x86_64 (x86-64-v2): VEX and EVEX instructions and the BMI, LZCNT, MOVBE,
#   and ADX instructions; TZCNT is left out, because CPUs without BMI run its
#   encoding as BSF, and compilers use it on purpose for generic code
# - aarch64 Linux (Armv8.0): every extension of Armv8.1 and later and the
#   optional ones of Armv8.0: the features of the Apple M1 (LSE atomics, CRC32,
#   RDM, LOR, the dot product, RCPC and RCPC2, JSCVT, FCMA, pointer
#   authentication outside the hint space, FlagM, FRINTTS, FP16 arithmetic and
#   FHM, AES, SHA1, SHA256, SHA512, SHA3, 64-bit PMULL, SB, SPECRES, DPB) and the
#   features above the M1
# - aarch64 Windows (Armv8.0 with LSE): the same without the LSE atomics
# - aarch64 macOS (Apple M1, the features that LLVM's apple-m1 CPU enables): the
#   features above the M1: SVE and SME, BF16, I8MM, MTE, MOPS, CSSC, LSE128,
#   RCPC3, WFxT, LS64, RNG, HBC, the compare-and-branch instructions, SM3, SM4,
#   FP8, FAMINMAX, LUT, and XS
# FP16 arithmetic is any floating-point instruction on half-precision registers
# or vectors except the conversions FCVT, FCVTL, and FCVTN, which Armv8.0 has.
# COFF and Mach-O keep the labels of assembly code (L*, .L*, ltmp*) as symbols;
# their instructions count for the function that contains them. Mach-O names C
# functions with a leading underscore, which is removed to match the ELF names.
# The NEON syntax is the generic one on every target, because llvm-objdump
# prints the Apple syntax (sdot.4s) for Mach-O.
isa_above_baseline() {
  local file="${1}" pattern allow insn lse m1 m1_line above_m1 above_m1_line object=""
  insn='^[[:space:]]*[0-9a-f]+:[[:space:]]+'
  lse='(ldadd|ldclr|ldeor|ldset|ldsmax|ldsmin|ldumax|ldumin|swp|cas|casp)[albh]*'
  m1='crc32c?[bhwx]|sqrdmlah|sqrdmlsh|sdot|udot|ldlar[bh]?|stllr[bh]?|ldapr[bh]?|ldapur(s?[bh]|sw)?|stlur[bh]?|fjcvtzs|fcmla|fcadd|(pac|aut)(ia|ib|da|db|iza|izb|dza|dzb)|pacga|xpac[id]|bl?ra(a|b|az|bz)|e?reta[ab]|ldra[ab]|cfinv|rmif|setf(8|16)|axflag|xaflag|frint(32|64)[xz]|fmlal2?|fmlsl2?|aes(e|d|mc|imc)|sha1(c|h|m|p|su0|su1)|sha(256|512)(h|h2|su0|su1)|eor3|bcax|rax1|xar|sb|cfp|dvp|cpp|cosp'
  m1_line="${insn}(f[a-z0-9]*|[su]cvtf)[[:space:]].*([[:space:]]h[0-9]+|\.[248]h)|${insn}pmull2?[[:space:]]+v[0-9]+\.1q|${insn}dc[[:space:]]+cvad?p,"
  above_m1='smstart|smstop|bfdot|bfmmla|bfmlal[bt]|bfcvtn?2?|smmla|ummla|usmmla|usdot|sudot|irg|gmi|addg|subg|subps?|stz?2?g|stgp|ldgm?|stz?gm|cpyf?[pme][a-z]*|setg?[pme](t|n|tn)?|ctz|(ldclrp|ldsetp|swpp)(a|l|al)?|ldiapp|stilp|ldap1|stl1|wfet|wfit|ld64b|st64bv?0?|bc\..*|cbh?b?(gt|ge|hi|hs|eq|ne|lt|lo|le|ls)|sm3(ss1|tt1a|tt1b|tt2a|tt2b|partw1|partw2)|sm4e(key)?|b?f[12]cvtl2?|fscale|fdot|fmlal[bt][bt]?|fmlall[bt][bt]|famax|famin|luti[24]'
  above_m1_line="${insn}(abs|cnt|smax|smin|umax|umin)[[:space:]]+[wx][0-9z]|${insn}mrs[[:space:]]+x[0-9]+, (RNDR|RNDRRS)\$|${insn}(dsb|tlbi)[[:space:]]+[a-z0-9]*nxs|[{ ]za[0-9]*[hv]?[.}[]| z[0-9]+\.| p[0-9]+[./]"
  case "${target}" in
  x86_64-*)
    pattern='^(v[a-z0-9]+|(andn|bextr|blsi|blsmsk|blsr|bzhi|mulx|pdep|pext|rorx|sarx|shlx|shrx|lzcnt|movbe|adcx|adox)[bwlq]?)$|%[yz]mm'
    allow="x86_64"
    ;;
  aarch64-*-linux-*)
    pattern="^(${lse}|${m1}|${above_m1})\$|${m1_line}|${above_m1_line}"
    allow="aarch64"
    ;;
  aarch64-*-windows-*)
    pattern="^(${m1}|${above_m1})\$|${m1_line}|${above_m1_line}"
    allow="aarch64"
    ;;
  aarch64-apple-*)
    pattern="^(${above_m1})\$|${above_m1_line}"
    allow="aarch64"
    ;;
  *) return 0 ;;
  esac
  case "${target}" in
  *-apple-*) object="macho" ;;
  *-windows-*) object="coff" ;;
  esac
  /opt/llvm/bin/llvm-objdump -d --no-show-raw-insn --demangle -mllvm=--aarch64-neon-syntax=generic "${file}" |
    pattern="${pattern}" object="${object}" awk '
      $2 ~ /^(fcvt|fcvtl2?|fcvtn2?)$/ { next }
      /^[0-9a-f]+ <.*>:$/ {
        name = substr($0, index($0, "<") + 1); sub(/>:$/, "", name)
        if (ENVIRON["object"] != "" && name ~ /^(\.L|L[a-z0-9_]|ltmp)/) next
        if (ENVIRON["object"] == "macho") sub(/^_/, "", name)
        fn = name
        next
      }
      $2 ~ ENVIRON["pattern"] || $0 ~ ENVIRON["pattern"] { count[fn]++ }
      END { for (f in count) print count[f], f }
    ' |
    awk -v arch="${allow}" '
      NR == FNR {
        if ($0 ~ /^[[:space:]]*(#|$)/) next
        split($0, field, /[[:space:]]+/)
        if (field[1] == arch || field[1] == "any") allowed[++n] = substr($0, length(field[1]) + 2)
        next
      }
      {
        name = substr($0, index($0, " ") + 1)
        for (i = 1; i <= n; i++) if (name ~ allowed[i]) next
        print
      }
    ' dev/cross/isa-allowlist - | sort -rn
}

# Print the glibc symbol versions above the oldest supported glibc.
glibc_too_new() {
  local objdump version
  objdump="$(printenv "OBJDUMP_${target_safe}" || printenv "OBJDUMP" || echo "objdump")"
  "${objdump}" -T "${1}" |
    awk '{ while (match($0, /GLIBC_[0-9][0-9.]*/)) { print substr($0, RSTART + 6, RLENGTH - 6); $0 = substr($0, RSTART + RLENGTH) } }' |
    sort -u -V | while read -r version; do
    if [[ "$(printf '%s\n%s\n' "${glibc_max}" "${version}" | sort -V | tail -n 1)" != "${glibc_max}" ]]; then
      printf 'GLIBC_%s\n' "${version}"
    fi
  done
}

if [[ -n "${lib}" ]]; then
  file=".out/${name}-${target}.node"
  file -h "${file}"
  printf 'Needs:\n'
  dependencies "${file}" | sed 's/^/  * /'
else
  ext=""
  [[ "${target}" == *windows* ]] && ext=".exe"
  file=".out/${name}-${target}${ext}"
  file -h "${file}"
  dev/is-static-binary "${file}" "${target}"
fi

failed=""
foreign="$(foreign_dependencies "${file}")"
if [[ -n "${foreign}" ]]; then
  printf '%s needs libraries that are not part of the operating system:\n' "${file}" >&2
  while IFS= read -r dependency; do
    printf '  * %s\n' "${dependency}" >&2
  done <<<"${foreign}"
  failed=1
fi
if [[ "${target}" == *-win7-windows-gnu ]]; then
  newer="$(windows8_imports "${file}")"
  if [[ -n "${newer}" ]]; then
    printf '%s imports functions that Windows 7 lacks:\n' "${file}" >&2
    while IFS= read -r entry; do
      printf '  * %s\n' "${entry}" >&2
    done <<<"${newer}"
    failed=1
  fi
fi
if [[ "${target}" == *-linux-gnu ]]; then
  too_new="$(glibc_too_new "${file}")"
  if [[ -n "${too_new}" ]]; then
    printf '%s needs symbols of a glibc newer than %s:\n' "${file}" "${glibc_max}" >&2
    while IFS= read -r version; do
      printf '  * %s\n' "${version}" >&2
    done <<<"${too_new}"
    failed=1
  fi
fi
if [[ "${target}" == *-apple-darwin ]]; then
  minos="$(macos_min_version "${file}")"
  if [[ "${minos}" != "${MACOSX_DEPLOYMENT_TARGET:?the macOS images set the deployment target}" ]]; then
    printf '%s names macOS %s as its minimum version instead of the deployment target %s\n' "${file}" "${minos:-(none)}" "${MACOSX_DEPLOYMENT_TARGET}" >&2
    failed=1
  fi
fi
above="$(isa_above_baseline "${file}")"
if [[ -n "${above}" ]]; then
  printf '%s has instructions above the CPU baseline of %s outside dev/cross/isa-allowlist (count, function):\n' "${file}" "${target}" >&2
  while IFS= read -r entry; do
    printf '  * %s\n' "${entry}" >&2
  done <<<"${above}"
  failed=1
fi
[[ -z "${failed}" ]]
