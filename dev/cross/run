#!/usr/bin/env bash
#
# Usage: $0 <bin> [target] [args...]
#
# Run a cross-compiled binary from .out/ with the runner of its cross image
# (QEMU for Linux targets, Wine for Windows). macOS binaries cannot run here.
#
set -euo pipefail
shopt -s inherit_errexit

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "${root}"

bin="${1:?binary name}"
target="${2:-${CROSS_COMPILE:?target}}"
shift 2 || shift $#
ext=""
[[ "${target}" == *windows* ]] && ext=".exe"

if [[ -z "${CROSS_RUNNER:-}" ]]; then
  printf 'No runner for %s in this image\n' "${target}" >&2
  exit 1
fi
if [[ "${target}" == *windows* ]]; then
  export WINEPREFIX="${HOME}/wine"
  mkdir -p "${WINEPREFIX}/drive_c/windows/system32"
  # Programs of the Windows 10 targets need the bcryptprimitives.dll stub to
  # start under Wine (install-wine-bcryptprimitives); the Windows 7 image has
  # none, because its programs do not import that DLL.
  if [[ -f /opt/wine/bcryptprimitives.dll ]]; then
    cp /opt/wine/bcryptprimitives.dll "${WINEPREFIX}/drive_c/windows/system32/"
  fi
fi
exec "${CROSS_RUNNER}" ".out/${bin}-${target}${ext}" "$@"
