#!/usr/bin/env bash
#
# Usage: $0 [options]
#
# Benchmark graph-pass CLI performance before and after a revision across
# ancestral, mugration, clock, optimize, and timetree, and verify output
# equality before/after at every requested thread count and thread-count
# determinism against each binary's own single-thread result.
#
# Options:
#   --before-ref REF          Baseline git revision (default: d5c89c78)
#   --after-ref REF           Changed git revision (default: HEAD)
#   --before-bin PATH         Reuse a baseline binary instead of building REF
#   --after-bin PATH          Reuse a changed binary instead of building REF
#   --before-build-record P   Build record (JSON) describing --before-bin
#   --after-build-record P    Build record (JSON) describing --after-bin
#   --data PATH               Dataset directory (default: data/mpox/clade-ii/2000)
#   --workloads LIST          Comma-separated workloads (default: all)
#   --jobs LIST               Comma-separated Rayon thread counts (default: 1,2,4,8)
#   --runs N                  Hyperfine measured runs (default: 3)
#   --warmup N                Hyperfine warmup runs (default: 1)
#   --output PATH             Output below the project root (default: tmp/graph-pass-cli-benchmark)
#   --only-output-check       Only run output-equality checks (skip timing benchmarks)
#   --skip-output-check       Skip output equivalence runs
#   -h, --help                Show this help
#
# Build identity:
#   A binary built from a REF is bound to a build record (treetime-<label>.build.json) carrying the
#   full source SHA, working-tree dirty-diff identity, toolchain, build mode, and input/matrix
#   hashes. REF builds use a real git worktree checkout (not `git archive`, whose extracted tree has
#   no .git and fails app-cli/build.rs). A supplied binary is only verified when a matching build
#   record is supplied via --<label>-build-record; a record whose binary_sha256 disagrees with the
#   supplied binary is rejected. A supplied binary without a record is used but reported unverified.
#
# Output equality:
#   For every requested thread count the before and after outputs are compared, and each binary's
#   output at each thread count is compared against its own single-thread result. Any difference
#   makes the tool exit nonzero.
#
# Environment:
#   BENCH_GRAPH_PASS_RUN_WRAPPER  Command prefix for running binaries and tools (default:
#                                 `./dev/docker/run`). Set empty to run directly (e.g. already inside
#                                 the container, or in tests with a fake binary).
#   BENCH_GRAPH_PASS_PY_WRAPPER   Command for the metadata-prep Python step (default:
#                                 `./dev/docker/python`).
#
# Outputs:
#   summary.json           Metadata (incl. build records), timing/RSS rows, and output comparisons
#   summary.tsv            Flat timing and peak-RSS table
#   output-comparison.tsv  Before/after and thread-count output comparison
#   raw/                   Hyperfine and /usr/bin/time JSON
#
set -euo pipefail
trap "exit" INT

THIS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PROJECT_DIR="$(dirname "${THIS_DIR}")"

ALL_WORKLOADS="ancestral,mugration,clock,optimize,timetree"

BEFORE_REF="d5c89c78"
AFTER_REF="HEAD"
BEFORE_BIN=""
AFTER_BIN=""
BEFORE_BUILD_RECORD=""
AFTER_BUILD_RECORD=""
DATA_DIR="data/mpox/clade-ii/2000"
WORKLOADS_CSV="${ALL_WORKLOADS}"
JOBS_CSV="1,2,4,8"
RUNS=3
WARMUP=1
OUTPUT_DIR="tmp/graph-pass-cli-benchmark"
CHECK_OUTPUT=true
RUN_BENCHMARKS=true

# Command prefix (as an array) used to run binaries and measurement tools. Overridable so this tool
# can run inside the container or against a fake binary in tests.
read -r -a RUN_WRAPPER <<<"${BENCH_GRAPH_PASS_RUN_WRAPPER-./dev/docker/run}"
PY_WRAPPER="${BENCH_GRAPH_PASS_PY_WRAPPER-./dev/docker/python}"

# Reference thread count that every other thread count is compared against for determinism.
REF_JOBS=1

# Set true by compare_dirs on any difference, making the whole run fail.
OUTPUT_DIFF_FOUND=false

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  # shfmt:off
  while (( $# > 0 )); do
    case "${1}" in
      -h|--help) show_help; exit 0 ;;
      --before-ref) BEFORE_REF="${2}"; shift 2 ;;
      --after-ref) AFTER_REF="${2}"; shift 2 ;;
      --before-bin) BEFORE_BIN="${2}"; shift 2 ;;
      --after-bin) AFTER_BIN="${2}"; shift 2 ;;
      --before-build-record) BEFORE_BUILD_RECORD="${2}"; shift 2 ;;
      --after-build-record) AFTER_BUILD_RECORD="${2}"; shift 2 ;;
      --data) DATA_DIR="${2}"; shift 2 ;;
      --workloads) WORKLOADS_CSV="${2}"; shift 2 ;;
      --jobs) JOBS_CSV="${2}"; shift 2 ;;
      --runs) RUNS="${2}"; shift 2 ;;
      --warmup) WARMUP="${2}"; shift 2 ;;
      --output) OUTPUT_DIR="${2}"; shift 2 ;;
      --only-output-check) RUN_BENCHMARKS=false; shift ;;
      --skip-output-check) CHECK_OUTPUT=false; shift ;;
      --) shift; break ;;
      -*) printf "Unknown option: %s\n" "${1}" >&2; exit 1 ;;
      *) printf "Unexpected argument: %s\n" "${1}" >&2; exit 1 ;;
    esac
  done
  # shfmt:on

  validate_args
  pushd "${PROJECT_DIR}" >/dev/null
  prepare_dirs
  prepare_metadata
  BEFORE_BIN="$(resolve_binary "before" "${BEFORE_REF}" "${BEFORE_BIN}" "${BEFORE_BUILD_RECORD}")"
  AFTER_BIN="$(resolve_binary "after" "${AFTER_REF}" "${AFTER_BIN}" "${AFTER_BUILD_RECORD}")"
  if "${RUN_BENCHMARKS}"; then
    run_benchmarks
  fi
  if "${CHECK_OUTPUT}"; then
    compare_outputs
  fi
  write_summaries
  popd >/dev/null

  printf "Benchmark results: %s/%s\n" "${PROJECT_DIR}" "${OUTPUT_DIR}"
  if "${OUTPUT_DIFF_FOUND}"; then
    printf "Output equality check FAILED: differing outputs detected (see output-comparison.tsv)\n" >&2
    exit 1
  fi
}

validate_args() {
  if [[ "${OUTPUT_DIR}" == /* || "${OUTPUT_DIR}" == *".."* ]]; then
    printf "--output must be a path below the project root: %s\n" "${OUTPUT_DIR}" >&2
    exit 1
  fi
  if [[ "${DATA_DIR}" == /* || "${DATA_DIR}" == *".."* ]]; then
    printf "--data must be a path below the project root: %s\n" "${DATA_DIR}" >&2
    exit 1
  fi
  if ! "${RUN_BENCHMARKS}" && ! "${CHECK_OUTPUT}"; then
    printf -- "--only-output-check and --skip-output-check are mutually exclusive\n" >&2
    exit 1
  fi
  if ! [[ "${RUNS}" =~ ^[1-9][0-9]*$ && "${WARMUP}" =~ ^[0-9]+$ ]]; then
    printf "--runs must be positive and --warmup non-negative\n" >&2
    exit 1
  fi

  IFS=',' read -r -a WORKLOADS <<<"${WORKLOADS_CSV}"
  if ((${#WORKLOADS[@]} == 0)); then
    printf "--workloads must contain at least one workload\n" >&2
    exit 1
  fi
  for workload in "${WORKLOADS[@]}"; do
    if [[ ",${ALL_WORKLOADS}," != *",${workload},"* ]]; then
      printf "Unknown workload in --workloads: %s (known: %s)\n" "${workload}" "${ALL_WORKLOADS}" >&2
      exit 1
    fi
  done

  IFS=',' read -r -a JOBS <<<"${JOBS_CSV}"
  if ((${#JOBS[@]} == 0)); then
    printf "--jobs must contain at least one thread count\n" >&2
    exit 1
  fi
  for jobs in "${JOBS[@]}"; do
    if ! [[ "${jobs}" =~ ^[1-9][0-9]*$ ]]; then
      printf "Invalid thread count in --jobs: %s\n" "${jobs}" >&2
      exit 1
    fi
  done

  # Thread counts whose outputs are produced: the requested set plus the determinism reference.
  declare -A jobs_set=()
  for jobs in "${JOBS[@]}" "${REF_JOBS}"; do
    jobs_set["${jobs}"]=1
  done
  mapfile -t ALL_JOBS < <(printf '%s\n' "${!jobs_set[@]}" | sort -n)
}

prepare_dirs() {
  rm -rf -- "${OUTPUT_DIR}"
  mkdir -p \
    "${OUTPUT_DIR}/bin" \
    "${OUTPUT_DIR}/output" \
    "${OUTPUT_DIR}/raw" \
    "${OUTPUT_DIR}/sources"
  : >"${OUTPUT_DIR}/results.ndjson"
  : >"${OUTPUT_DIR}/comparisons.ndjson"
}

# Only the date-dependent workloads need the tree-filtered metadata.
needs_metadata() {
  local workload
  for workload in "${WORKLOADS[@]}"; do
    case "${workload}" in
    mugration | clock | timetree) return 0 ;;
    esac
  done
  return 1
}

prepare_metadata() {
  needs_metadata || return 0

  local metadata="${DATA_DIR}/metadata.tsv"
  local tree="${DATA_DIR}/tree.nwk"
  local filtered="${OUTPUT_DIR}/metadata-tree-tips.tsv"

  "${PY_WRAPPER}" python - "${metadata}" "${tree}" "${filtered}" <<'PY'
import csv
import sys
from pathlib import Path

from Bio import Phylo

source = Path(sys.argv[1])
tree = Path(sys.argv[2])
target = Path(sys.argv[3])
tips = {tip.name for tip in Phylo.read(tree, "newick").get_terminals()}

with source.open(newline="") as input_file, target.open("w", newline="") as output_file:
    reader = csv.DictReader(input_file, delimiter="\t")
    if reader.fieldnames is None or "accession" not in reader.fieldnames:
        raise ValueError("metadata must contain an accession column")
    writer = csv.DictWriter(output_file, fieldnames=reader.fieldnames, delimiter="\t")
    writer.writeheader()
    writer.writerows(row for row in reader if row["accession"] in tips)
PY
}

sha256_of() {
  sha256sum -- "${1}" | cut -d' ' -f1
}

matrix_identity() {
  # Binds a build record to the exact benchmark matrix it was measured against.
  printf 'workloads=%s\njobs=%s\ndata=%s\n' "${WORKLOADS_CSV}" "${JOBS_CSV}" "${DATA_DIR}" |
    sha256sum | cut -d' ' -f1
}

input_identity() {
  # Content hash of the dataset input files the workloads read.
  local file
  {
    for file in tree.nwk aln.fasta.xz metadata.tsv; do
      if [[ -f "${DATA_DIR}/${file}" ]]; then
        printf '%s ' "${file}"
        sha256_of "${DATA_DIR}/${file}"
      fi
    done
  } | sha256sum | cut -d' ' -f1
}

resolve_binary() {
  local label="${1}"
  local ref="${2}"
  local supplied="${3}"
  local supplied_record="${4}"
  local destination="${OUTPUT_DIR}/bin/treetime-${label}"
  local record="${OUTPUT_DIR}/bin/treetime-${label}.build.json"

  if [[ -n "${supplied}" ]]; then
    if [[ ! -f "${supplied}" ]]; then
      printf "%s binary not found: %s\n" "${label}" "${supplied}" >&2
      exit 1
    fi
    cp -- "${supplied}" "${destination}"
    local actual_sha
    actual_sha="$(sha256_of "${destination}")"
    if [[ -n "${supplied_record}" ]]; then
      verify_supplied_record "${label}" "${supplied_record}" "${actual_sha}"
      jq --arg sha "${actual_sha}" \
        '. + {binary_sha256: $sha, verified: true, provenance: "supplied+record"}' \
        "${supplied_record}" >"${record}"
    else
      printf "WARNING: %s binary supplied without a build record; its identity is unverified.\n" "${label}" >&2
      jq -n --arg sha "${actual_sha}" --arg path "${supplied}" \
        '{binary_sha256: $sha, verified: false, provenance: "supplied", source_bin: $path}' >"${record}"
    fi
    printf "%s" "${destination}"
    return
  fi

  build_ref_binary "${label}" "${ref}" "${destination}" "${record}"
  printf "%s" "${destination}"
}

verify_supplied_record() {
  local label="${1}"
  local record_path="${2}"
  local actual_sha="${3}"

  if [[ ! -f "${record_path}" ]]; then
    printf "%s build record not found: %s\n" "${label}" "${record_path}" >&2
    exit 1
  fi
  local recorded_sha
  recorded_sha="$(jq -r '.binary_sha256 // ""' "${record_path}")"
  if [[ -z "${recorded_sha}" ]]; then
    printf "%s build record has no binary_sha256: %s\n" "${label}" "${record_path}" >&2
    exit 1
  fi
  if [[ "${recorded_sha}" != "${actual_sha}" ]]; then
    printf "%s build record mismatch: record binary_sha256=%s but supplied binary hashes to %s\n" \
      "${label}" "${recorded_sha}" "${actual_sha}" >&2
    exit 1
  fi
}

build_ref_binary() {
  local label="${1}"
  local ref="${2}"
  local destination="${3}"
  local record="${4}"
  local checkout="${OUTPUT_DIR}/sources/${label}"

  local source_sha
  if ! source_sha="$(git rev-parse --verify "${ref}^{commit}" 2>/dev/null)"; then
    printf "Cannot resolve %s ref: %s (never substitute another baseline silently)\n" "${label}" "${ref}" >&2
    exit 1
  fi

  rm -rf -- "${checkout}"
  # Real checkout with .git metadata so app-cli/build.rs git queries succeed. A `git archive` extract
  # has no .git and fails the build.
  git worktree add --detach --force "${checkout}" "${source_sha}" >&2
  (
    cd "${checkout}"
    "${RUN_WRAPPER[@]}" ./dev/dev br treetime
  ) >&2
  cp -- "${checkout}/.out/treetime" "${destination}"

  local dirty_diff dirty_flag dirty_sha toolchain bin_sha
  dirty_diff="$(git -C "${checkout}" diff HEAD)"
  if [[ -n "${dirty_diff}" ]]; then dirty_flag=true; else dirty_flag=false; fi
  dirty_sha="$(printf '%s' "${dirty_diff}" | sha256sum | cut -d' ' -f1)"
  toolchain="$("${RUN_WRAPPER[@]}" rustc --version 2>/dev/null | head -1 || true)"
  bin_sha="$(sha256_of "${destination}")"

  jq -n \
    --arg binary_sha256 "${bin_sha}" \
    --arg source_sha "${source_sha}" \
    --argjson source_dirty "${dirty_flag}" \
    --arg dirty_diff_sha256 "${dirty_sha}" \
    --arg toolchain "${toolchain}" \
    --arg build_mode "release" \
    --arg build_command "./dev/dev br treetime" \
    --arg input_id "$(input_identity)" \
    --arg matrix_id "$(matrix_identity)" \
    '{
      binary_sha256: $binary_sha256,
      source_sha: $source_sha,
      source_dirty: $source_dirty,
      dirty_diff_sha256: $dirty_diff_sha256,
      toolchain: $toolchain,
      build_mode: $build_mode,
      build_command: $build_command,
      input_id: $input_id,
      matrix_id: $matrix_id,
      verified: true,
      provenance: "built"
    }' >"${record}"

  git worktree remove --force "${checkout}" >&2 || true
}

workload_args() {
  local workload="${1}"
  local binary="${2}"
  local output="${3}"
  local jobs="${4}"
  local metadata="${OUTPUT_DIR}/metadata-tree-tips.tsv"

  case "${workload}" in
  ancestral)
    WORKLOAD_ARGS=(
      "${binary}" ancestral --method-anc=marginal --dense=false
      --tree="${DATA_DIR}/tree.nwk" --aln="${DATA_DIR}/aln.fasta.xz"
      --output-all="${output}" -j "${jobs}" --silent
    )
    ;;
  mugration)
    WORKLOAD_ARGS=(
      "${binary}" mugration --tree="${DATA_DIR}/tree.nwk" --states="${metadata}"
      --attribute=country --name-column=accession --pc=1.0
      --output-all="${output}" -j "${jobs}" --silent
    )
    ;;
  clock)
    WORKLOAD_ARGS=(
      "${binary}" clock --tree="${DATA_DIR}/tree.nwk" --dates="${metadata}"
      --name-column=accession --output-all="${output}" -j "${jobs}" --silent
    )
    ;;
  optimize)
    WORKLOAD_ARGS=(
      "${binary}" optimize --dense=false --tree="${DATA_DIR}/tree.nwk"
      --aln="${DATA_DIR}/aln.fasta.xz" --output-all="${output}"
      -j "${jobs}" --silent
    )
    ;;
  timetree)
    WORKLOAD_ARGS=(
      "${binary}" timetree --tree="${DATA_DIR}/tree.nwk" --dates="${metadata}"
      --name-column=accession --aln="${DATA_DIR}/aln.fasta.xz"
      --output-all="${output}"
      "--output-selection=nwk,nexus,auspice,augur-node-data,clock-model,gtr"
      -j "${jobs}" --silent
    )
    ;;
  *)
    printf "Unknown workload: %s\n" "${workload}" >&2
    exit 1
    ;;
  esac
}

command_string() {
  local command=""
  printf -v command '%q ' "$@"
  printf "%s" "${command}"
}

run_benchmarks() {
  local workload jobs before_command after_command hyperfine_json version binary rss_json result_index

  for jobs in "${JOBS[@]}"; do
    for workload in "${WORKLOADS[@]}"; do
      workload_args "${workload}" "${BEFORE_BIN}" "${OUTPUT_DIR}/output/run-before" "${jobs}"
      before_command="$(command_string "${WORKLOAD_ARGS[@]}")"
      workload_args "${workload}" "${AFTER_BIN}" "${OUTPUT_DIR}/output/run-after" "${jobs}"
      after_command="$(command_string "${WORKLOAD_ARGS[@]}")"
      hyperfine_json="${OUTPUT_DIR}/raw/${workload}-j${jobs}-hyperfine.json"

      "${RUN_WRAPPER[@]}" hyperfine \
        --warmup "${WARMUP}" \
        --runs "${RUNS}" \
        --prepare "rm -rf ${OUTPUT_DIR}/output/run-before ${OUTPUT_DIR}/output/run-after" \
        --export-json="${hyperfine_json}" \
        "${before_command}" \
        "${after_command}"

      for version in before after; do
        if [[ "${version}" == "before" ]]; then
          binary="${BEFORE_BIN}"
          result_index=0
        else
          binary="${AFTER_BIN}"
          result_index=1
        fi
        rss_json="${OUTPUT_DIR}/raw/${workload}-j${jobs}-${version}-rss.json"
        rm -rf -- "${OUTPUT_DIR}/output/rss-${version}"
        workload_args "${workload}" "${binary}" "${OUTPUT_DIR}/output/rss-${version}" "${jobs}"
        "${RUN_WRAPPER[@]}" /usr/bin/time \
          -f '{"elapsed_seconds":%e,"peak_rss_kb":%M}' \
          -o "${rss_json}" \
          "${WORKLOAD_ARGS[@]}"

        jq \
          --arg workload "${workload}" \
          --arg version "${version}" \
          --argjson jobs "${jobs}" \
          --argjson result_index "${result_index}" \
          --slurpfile rss "${rss_json}" \
          '.results[$result_index] as $timing | {
            workload: $workload,
            jobs: $jobs,
            version: $version,
            mean_seconds: $timing.mean,
            stddev_seconds: $timing.stddev,
            min_seconds: $timing.min,
            max_seconds: $timing.max,
            user_seconds: $timing.user,
            system_seconds: $timing.system,
            peak_rss_kb: $rss[0].peak_rss_kb
          }' "${hyperfine_json}" >>"${OUTPUT_DIR}/results.ndjson"
      done
    done
  done
}

compare_outputs() {
  local workload jobs version binary output

  # Produce a clean output tree for every workload, version, and thread count (requested plus the
  # determinism reference).
  for workload in "${WORKLOADS[@]}"; do
    for version in before after; do
      binary="$(version_binary "${version}")"
      for jobs in "${ALL_JOBS[@]}"; do
        output="${OUTPUT_DIR}/output/check-${workload}-${version}-j${jobs}"
        rm -rf -- "${output}"
        workload_args "${workload}" "${binary}" "${output}" "${jobs}"
        "${RUN_WRAPPER[@]}" "${WORKLOAD_ARGS[@]}"
      done
    done

    # Before vs after at every requested thread count.
    for jobs in "${JOBS[@]}"; do
      compare_dirs "${workload}" "before-after-j${jobs}" \
        "${OUTPUT_DIR}/output/check-${workload}-before-j${jobs}" \
        "${OUTPUT_DIR}/output/check-${workload}-after-j${jobs}"
    done

    # Thread-count determinism: each binary at each thread count vs its own single-thread result.
    for version in before after; do
      for jobs in "${JOBS[@]}"; do
        if [[ "${jobs}" != "${REF_JOBS}" ]]; then
          compare_dirs "${workload}" "${version}-j${REF_JOBS}-j${jobs}" \
            "${OUTPUT_DIR}/output/check-${workload}-${version}-j${REF_JOBS}" \
            "${OUTPUT_DIR}/output/check-${workload}-${version}-j${jobs}"
        fi
      done
    done
  done
}

version_binary() {
  if [[ "${1}" == "before" ]]; then
    printf "%s" "${BEFORE_BIN}"
  else
    printf "%s" "${AFTER_BIN}"
  fi
}

compare_dirs() {
  local workload="${1}"
  local comparison="${2}"
  local left="${3}"
  local right="${4}"
  local diff_file="${OUTPUT_DIR}/raw/${workload}-${comparison}.diff"
  local status

  if diff -qr -- "${left}" "${right}" >"${diff_file}"; then
    status="identical"
  else
    local code=$?
    if ((code != 1)); then
      printf "Output comparison failed: %s\n" "${comparison}" >&2
      exit "${code}"
    fi
    status="different"
    OUTPUT_DIFF_FOUND=true
  fi

  jq -n \
    --arg workload "${workload}" \
    --arg comparison "${comparison}" \
    --arg status "${status}" \
    --arg diff_file "${diff_file}" \
    '{workload: $workload, comparison: $comparison, status: $status, diff_file: $diff_file}' \
    >>"${OUTPUT_DIR}/comparisons.ndjson"
}

write_summaries() {
  jq -s '.' "${OUTPUT_DIR}/results.ndjson" >"${OUTPUT_DIR}/results.json"
  jq -s '.' "${OUTPUT_DIR}/comparisons.ndjson" >"${OUTPUT_DIR}/comparisons.json"

  jq -r '
    ["workload", "jobs", "version", "mean_seconds", "stddev_seconds", "min_seconds", "max_seconds", "user_seconds", "system_seconds", "peak_rss_kb"],
    (.[] | [.workload, .jobs, .version, .mean_seconds, .stddev_seconds, .min_seconds, .max_seconds, .user_seconds, .system_seconds, .peak_rss_kb])
    | @tsv
  ' "${OUTPUT_DIR}/results.json" >"${OUTPUT_DIR}/summary.tsv"

  jq -r '
    ["workload", "comparison", "status", "diff_file"],
    (.[] | [.workload, .comparison, .status, .diff_file])
    | @tsv
  ' "${OUTPUT_DIR}/comparisons.json" >"${OUTPUT_DIR}/output-comparison.tsv"

  local output_ok=true
  if "${OUTPUT_DIFF_FOUND}"; then output_ok=false; fi

  jq -n \
    --arg generated_at "$(date --iso-8601=seconds)" \
    --arg dataset "${DATA_DIR}" \
    --arg workloads "${WORKLOADS_CSV}" \
    --arg jobs "${JOBS_CSV}" \
    --argjson runs "${RUNS}" \
    --argjson warmup "${WARMUP}" \
    --argjson output_check_ok "${output_ok}" \
    --slurpfile before_build "${OUTPUT_DIR}/bin/treetime-before.build.json" \
    --slurpfile after_build "${OUTPUT_DIR}/bin/treetime-after.build.json" \
    --slurpfile results "${OUTPUT_DIR}/results.json" \
    --slurpfile comparisons "${OUTPUT_DIR}/comparisons.json" \
    '{
      metadata: {
        generated_at: $generated_at,
        dataset: $dataset,
        workloads: ($workloads | split(",")),
        jobs: ($jobs | split(",") | map(tonumber)),
        runs: $runs,
        warmup: $warmup,
        output_check_ok: $output_check_ok,
        before_build: $before_build[0],
        after_build: $after_build[0]
      },
      results: $results[0],
      output_comparisons: $comparisons[0]
    }' >"${OUTPUT_DIR}/summary.json"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
