#!/usr/bin/env bash
#
# Usage: $0 <executable> <output.md>
#
# Re-generate the command-line reference page of the docs site in Markdown format.
#
# The executable must support the `help-markdown` subcommand.
# The output file is overwritten with the front matter of a docs page
# followed by the generated markdown.
#
# Examples:
#   $0 .out/treetime packages/app-docs/src/generated/en/reference/cli.md
#   $0 target/debug/treetime packages/app-docs/src/generated/en/reference/cli.md
#
set -euo pipefail
trap "exit" INT

main() {
  show_help() {
    sed -n '2,${/^#/!q; s/^# \?//p}' "${BASH_SOURCE[0]}" | sed "s|\$0|${0##*/}|g"
  }

  [[ "${1:-}" =~ ^(-h|--help)$ ]] && {
    show_help
    exit 0
  }

  if (($# != 2)); then
    show_help
    exit 1
  fi

  local exe="${1}"
  local out="${2}"

  mkdir -p "$(dirname "${out}")"

  cat <<'EOF' >"${out}"
---
title: Command-line reference
description: Every command, flag, and default of the treetime command-line program.
---

<!-- WARNING: GENERATED CONTENT -->
<!-- Do not edit the generated file manually! All manual changes will be overwritten by automation. -->
<!-- See developer guide for how to properly work with this. -->

> This page is generated from the help text of the `treetime` program. Report issues at https://github.com/neherlab/treetime/issues

EOF

  "${exe}" help-markdown >>"${out}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
