#!/usr/bin/env python3

"""
Compare treetime output equality between two binaries across the full smoke-test matrix.

This drives `dev/run-smoke-tests` twice - once with a "before" binary (run once, then persisted) and
once with an "after" binary - and diffs the outputs of every test that PASSED on the before binary,
after normalizing volatile fields (the auspice "updated" date). It gives far broader coverage than a
single-command benchmark: every command (ancestral, clock, mugration, optimize, prune, timetree) over
many datasets and flag combinations.

Persisting the before run means it is computed once and then acts as a fixed comparison target while
the after binary evolves: re-run with a fresh `--after-bin` and the before run is reused.

Evidence integrity. A saved comparison is only trustworthy if it describes the binaries and outputs
actually tested, so this script refuses stale or mismatched evidence:

  - Each run owns fresh outputs: the run directory is wiped before the runner starts, so no output
    from an earlier run can survive and be mistaken for this run's output.
  - Each run must leave a fresh, completed manifest. `run-smoke-tests` writes its manifest atomically
    only after the whole matrix finishes, so a missing manifest means the driver died (a "driver
    failure"), distinct from a matrix that completed with some failing cases.
  - Manifests are validated: correct schema, `completed: true`, matching `case_count`, no duplicate
    case ids, and (when a binary is supplied) a `binary_sha256` that matches that binary. A persisted
    before-run is therefore rejected the moment it no longer matches the requested before binary.
  - Before and after must share `matrix_id` and `input_id`, so a persisted before-run is never
    cross-compared against an after-run built from a different matrix or different input data.
  - Every passing case with a declared output directory must actually have output files on both
    sides; a missing expected output directory is a failure, not a silent empty-vs-empty match.

Tests that FAIL on the before binary are excluded from the equality check (a failing run is not a
meaningful target). A test that passed on before but fails on after is reported as a regression.

Usage:

    ./dev/docker/run ./dev/smoke-compare --before-bin PATH --after-bin PATH [options]

Options:
    --before-bin PATH   Baseline binary. Required for the first run; reused afterwards.
    --after-bin PATH    Changed binary (default: .out/treetime).
    --output DIR        Working directory below the project root (default: tmp/smoke-compare).
    --refresh-before    Re-run the before binary even if a persisted before run exists.
    --refresh-after     No-op kept for symmetry; the after run always executes.
    --only-failures     Quieter sub-runs (passed through to run-smoke-tests).

Environment:
    SMOKE_COMPARE_RUNNER  Path to the smoke-test runner (default: dev/run-smoke-tests). Overriding it
                          lets tests drive this script against a controlled fake runner.

NOTE: you must build the compared binaries yourself; this script does not build anything.

Exit code: 0 if every compared test is identical, 1 otherwise.
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from enum import Enum
from pathlib import Path

# The only wall-clock-volatile field treetime writes: the auspice `"updated": "YYYY-MM-DD"` generation
# date (see `generation_date()` in tree_output.rs). Masked so a persisted before run stays comparable
# to an after run made on a different day. Everything else treetime emits is deterministic.
UPDATED_DATE_RE = re.compile(rb'("updated"\s*:\s*)"\d{4}-\d{2}-\d{2}"')
DATE_PLACEHOLDER = rb'\1"<normalized-date>"'

# Must match the constant of the same name in `dev/run-smoke-tests`.
MANIFEST_SCHEMA = "treetime-smoke-manifest/v2"

PROJECT_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_RUNNER = Path(__file__).resolve().parent / "run-smoke-tests"
RUNNER = Path(os.environ.get("SMOKE_COMPARE_RUNNER", str(DEFAULT_RUNNER)))


def main() -> None:
  args = parse_args()
  output_root = (PROJECT_ROOT / args.output).resolve()
  before = RunPaths.under(output_root / "before")
  after = RunPaths.under(output_root / "after")

  if args.refresh_before or not before.manifest.exists():
    if not args.before_bin:
      sys.exit("No persisted before run found; pass --before-bin PATH to establish the baseline.")
    run_smoke(args.before_bin, before, only_failures=args.only_failures, label="before")
  else:
    print(f"Reusing persisted before run: {before.manifest.relative_to(PROJECT_ROOT)}")

  # Validate the before run (fresh or persisted) before touching the after run: a stale or mismatched
  # baseline (e.g. persisted against a different --before-bin) must be rejected up front.
  before_manifest = load_manifest(before, label="before", expected_binary=args.before_bin)

  run_smoke(args.after_bin, after, only_failures=args.only_failures, label="after")
  after_manifest = load_manifest(after, label="after", expected_binary=args.after_bin)

  if before_manifest.matrix_id != after_manifest.matrix_id:
    sys.exit("matrix identity mismatch: before and after ran different test matrices; nothing to compare.")
  if before_manifest.input_id != after_manifest.input_id:
    sys.exit("input identity mismatch: before and after ran against different input data; nothing to compare.")

  outcomes = [compare_test(test_id, before_manifest.cases[test_id], after_manifest.cases.get(test_id), before, after)
              for test_id in sorted(before_manifest.cases)]

  report_path = output_root / "comparison.tsv"
  write_report(outcomes, report_path)
  print_summary(outcomes, report_path)
  sys.exit(0 if all(o.status.ok for o in outcomes) else 1)


def run_smoke(binary: str, paths: "RunPaths", only_failures: bool, label: str) -> None:
  """Run the smoke-test matrix for one binary into a freshly created, run-owned directory.

  The run directory is wiped first so no earlier output or manifest can survive; the caller then
  requires a fresh completed manifest via `load_manifest`, which is how a driver failure (no manifest)
  is told apart from a completed matrix that merely had failing cases.
  """
  binary_path = Path(binary)
  if not binary_path.is_file():
    sys.exit(f"{label} binary not found: {binary}")
  shutil.rmtree(paths.root, ignore_errors=True)
  paths.out.mkdir(parents=True, exist_ok=True)
  command = [
    sys.executable, str(RUNNER), str(binary_path.resolve()),
    f"--output-dir={paths.out}", f"--manifest={paths.manifest}", "--no-stats",
  ]
  if only_failures:
    command.append("--only-failures")
  print(f"Running smoke matrix ({label}): {binary} -> {paths.root.relative_to(PROJECT_ROOT)}")
  with paths.log.open("w") as log:
    # run-smoke-tests exits nonzero when any case fails; that is expected (the before binary has known
    # failures), so its exit code is ignored - completion is proven by a fresh, valid manifest, and a
    # missing manifest (checked in load_manifest) is read as a driver failure.
    subprocess.run(command, cwd=PROJECT_ROOT, stdout=log, stderr=subprocess.STDOUT, check=False)


def load_manifest(paths: "RunPaths", label: str, expected_binary: str | None) -> "Manifest":
  """Load and validate a run's completion manifest, exiting on any integrity violation."""
  if not paths.manifest.exists():
    sys.exit(f"{label} run left no fresh manifest (driver failure?); see {paths.log.relative_to(PROJECT_ROOT)}")
  try:
    doc = json.loads(paths.manifest.read_text())
  except json.JSONDecodeError as error:
    sys.exit(f"{label} manifest is not valid JSON ({error}); see {paths.log.relative_to(PROJECT_ROOT)}")

  if not isinstance(doc, dict) or doc.get("schema") != MANIFEST_SCHEMA:
    sys.exit(f"{label} manifest schema mismatch: expected {MANIFEST_SCHEMA!r}, got {doc.get('schema') if isinstance(doc, dict) else type(doc).__name__!r}")
  if doc.get("completed") is not True:
    sys.exit(f"{label} manifest is incomplete (completed != true); the run did not finish the matrix.")

  cases = doc.get("cases")
  if not isinstance(cases, list) or not cases:
    sys.exit(f"{label} manifest has no cases; nothing was run.")
  if doc.get("case_count") != len(cases):
    sys.exit(f"{label} manifest case_count ({doc.get('case_count')}) disagrees with the number of cases ({len(cases)}).")

  ids = [case["id"] for case in cases]
  duplicates = sorted({case_id for case_id in ids if ids.count(case_id) > 1})
  if duplicates:
    sys.exit(f"{label} manifest has duplicate case ids: {duplicates}")

  for field in ("matrix_id", "input_id", "binary_sha256"):
    if not isinstance(doc.get(field), str) or not doc[field]:
      sys.exit(f"{label} manifest is missing required field {field!r}.")

  if expected_binary is not None:
    actual = sha256_file(Path(expected_binary))
    if actual != doc["binary_sha256"]:
      sys.exit(f"{label} binary identity mismatch: manifest records {doc['binary_sha256'][:12]} "
               f"but {label} binary {expected_binary} hashes to {actual[:12]}.")

  return Manifest(
    cases={case["id"]: case for case in cases},
    matrix_id=doc["matrix_id"],
    input_id=doc["input_id"],
    binary_sha256=doc["binary_sha256"],
  )


def compare_test(test_id: str, before: dict, after: dict | None, before_paths: "RunPaths", after_paths: "RunPaths") -> "Outcome":
  cmd_name = str(before["cmd_name"])
  if before["code"] != 0:
    return Outcome(test_id, cmd_name, Status.SKIP_BEFORE_FAILED, "")
  if after is None:
    return Outcome(test_id, cmd_name, Status.MISSING_AFTER, "not present in after manifest")
  if after["code"] != 0:
    return Outcome(test_id, cmd_name, Status.AFTER_FAILED, "before passed, after failed")
  if before["output_dir"] is None:
    return Outcome(test_id, cmd_name, Status.NO_OUTPUT, "no file output to compare")

  left = before_paths.out / before["output_dir"]
  right = after_paths.out / after["output_dir"]
  left_missing = not dir_has_files(left)
  right_missing = not dir_has_files(right)
  if left_missing or right_missing:
    where = "both sides" if left_missing and right_missing else ("before" if left_missing else "after")
    return Outcome(test_id, cmd_name, Status.MISSING_OUTPUT, f"expected output missing ({where}): {before['output_dir']}")

  difference = diff_dirs(left, right)
  if difference is None:
    return Outcome(test_id, cmd_name, Status.IDENTICAL, "")
  return Outcome(test_id, cmd_name, Status.DIFFERENT, difference)


def diff_dirs(left: Path, right: Path) -> str | None:
  """Return None if the two output trees are equal after normalization, else a short difference note."""
  left_files = relative_files(left)
  right_files = relative_files(right)
  only_left = sorted(left_files - right_files)
  only_right = sorted(right_files - left_files)
  if only_left:
    return f"missing in after: {only_left[0]}"
  if only_right:
    return f"only in after: {only_right[0]}"
  for rel in sorted(left_files):
    if normalize(left / rel) != normalize(right / rel):
      return f"content differs: {rel}"
  return None


def relative_files(root: Path) -> set[str]:
  if not root.exists():
    return set()
  return {str(path.relative_to(root)) for path in root.rglob("*") if path.is_file()}


def dir_has_files(root: Path) -> bool:
  return root.is_dir() and any(path.is_file() for path in root.rglob("*"))


def sha256_file(path: Path) -> str:
  digest = hashlib.sha256()
  with path.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1 << 20), b""):
      digest.update(chunk)
  return digest.hexdigest()


def normalize(path: Path) -> bytes:
  return UPDATED_DATE_RE.sub(DATE_PLACEHOLDER, path.read_bytes())


def write_report(outcomes: list["Outcome"], report_path: Path) -> None:
  report_path.parent.mkdir(parents=True, exist_ok=True)
  lines = ["id\tcmd_name\tstatus\tdetail"]
  lines.extend(f"{o.test_id}\t{o.cmd_name}\t{o.status.value}\t{o.detail}" for o in outcomes)
  report_path.write_text("\n".join(lines) + "\n")


def print_summary(outcomes: list["Outcome"], report_path: Path) -> None:
  counts = {status: 0 for status in Status}
  for outcome in outcomes:
    counts[outcome.status] += 1

  print("\nSmoke output comparison")
  for status in Status:
    if counts[status]:
      print(f"  {status.value:<20} {counts[status]}")

  problems = [o for o in outcomes if not o.status.ok]
  if problems:
    print("\nProblems:")
    for outcome in problems:
      print(f"  {outcome.status.value}: {outcome.test_id} ({outcome.detail})")

  print(f"\nReport: {report_path.relative_to(PROJECT_ROOT)}")


class Status(Enum):
  IDENTICAL = "identical"
  DIFFERENT = "different"
  AFTER_FAILED = "after-failed"
  MISSING_AFTER = "missing-after"
  MISSING_OUTPUT = "missing-output"
  SKIP_BEFORE_FAILED = "skip-before-failed"
  NO_OUTPUT = "no-output"

  @property
  def ok(self) -> bool:
    return self in (Status.IDENTICAL, Status.SKIP_BEFORE_FAILED, Status.NO_OUTPUT)


@dataclass(frozen=True)
class Outcome:
  test_id: str
  cmd_name: str
  status: Status
  detail: str


@dataclass(frozen=True)
class Manifest:
  cases: dict[str, dict]
  matrix_id: str
  input_id: str
  binary_sha256: str


@dataclass(frozen=True)
class RunPaths:
  root: Path
  out: Path
  manifest: Path
  log: Path

  @classmethod
  def under(cls, root: Path) -> "RunPaths":
    return cls(root=root, out=root / "out", manifest=root / "manifest.json", log=root / "smoke.log")


def parse_args() -> argparse.Namespace:
  parser = argparse.ArgumentParser(
    description="Compare treetime output equality between two binaries across the smoke-test matrix.",
    formatter_class=argparse.RawDescriptionHelpFormatter,
  )
  parser.add_argument("--before-bin", default=None, help="Baseline binary (required on first run).")
  parser.add_argument("--after-bin", default=".out/treetime", help="Changed binary (default: .out/treetime).")
  parser.add_argument("--output", default="tmp/smoke-compare", help="Working directory below the project root.")
  parser.add_argument("--refresh-before", action="store_true", help="Re-run the before binary even if persisted.")
  parser.add_argument("--refresh-after", action="store_true", help="No-op; the after run always executes.")
  parser.add_argument("--only-failures", action="store_true", help="Quieter sub-runs.")
  return parser.parse_args()


if __name__ == "__main__":
  main()
