  "configs": [
    {
      "path": "dengue/100/clock.yaml",
      "command": "clock",
      "title": "Root-to-tip clock regression (dengue/100).",
      "folder": "dengue/100",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-clock.schema.json\n\n# Root-to-tip clock regression (dengue/100).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime clock --config data/dengue/100/clock.yaml --output-all tmp/examples/dengue/100/clock\n#\n# `clock` reroots the tree to maximize the temporal signal, then fits the\n# root-to-tip regression and reports the clock rate. The taxon identifier lives\n# in a non-default metadata column here, named once in the config instead of a\n# `--metadata-id-columns genbank_accession` flag repeated on every run.\n\ntree: \"tree.nwk\"\nmetadata: \"metadata.tsv\"\nmetadata_id_columns:\n  - \"genbank_accession\"\n",
      "inputs": {
        "metadata": [
          "dengue/100/metadata.tsv"
        ],
        "tree": [
          "dengue/100/tree.nwk"
        ]
      }
    },
    {
      "path": "ebola/20/ancestral-parsimony.yaml",
      "command": "ancestral",
      "title": "Ancestral reconstruction by Fitch parsimony (ebola/20).",
      "folder": "ebola/20",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-ancestral.schema.json\n\n# Ancestral reconstruction by Fitch parsimony (ebola/20).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime ancestral --config data/ebola/20/ancestral-parsimony.yaml --output-all tmp/examples/ebola/20/ancestral-parsimony\n#\n# A per-command config is the command's own argument object. Every value here\n# has a matching `--flag`; the file is a saved, reviewable, version-controlled\n# invocation. An explicit flag on the command line still overrides the file.\n\ntree: \"tree.nwk\"\nalignment:\n  - \"aln.fasta.xz\"\n\n# Fitch parsimony: fast, model-free ancestral states and mutations.\nmethod_anc: \"parsimony\"\n",
      "inputs": {
        "alignment": [
          "ebola/20/aln.fasta.xz"
        ],
        "tree": [
          "ebola/20/tree.nwk"
        ]
      }
    },
    {
      "path": "flu/h3n2/20/optimize.yaml",
      "command": "optimize",
      "title": "Branch-length optimization with divergence-based rerooting (flu/h3n2/20).",
      "folder": "flu/h3n2/20",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-optimize.schema.json\n\n# Branch-length optimization with divergence-based rerooting (flu/h3n2/20).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime optimize --config data/flu/h3n2/20/optimize.yaml --output-all tmp/examples/flu/h3n2/20/optimize\n#\n# `optimize` re-estimates every branch length under the substitution model and\n# (here) reroots to minimize root-to-tip divergence variance. This is the\n# date-free step that replaces `augur refine` in a Nextstrain build.\n\ntree: \"tree.nwk\"\nalignment:\n  - \"aln.fasta.xz\"\n\n# Per-edge optimizer: Brent's method in sqrt(t) space (the default, matches v0).\noptimizer: \"brent\"\n\n# Reroot by minimizing root-to-tip divergence variance (a date-free method).\nreroot: \"min-dev\"\n",
      "inputs": {
        "alignment": [
          "flu/h3n2/20/aln.fasta.xz"
        ],
        "tree": [
          "flu/h3n2/20/tree.nwk"
        ]
      }
    },
    {
      "path": "flu/h3n2/200/timetree.yaml",
      "command": "timetree",
      "title": "Time-scaled tree with a fixed clock rate and date confidence intervals (flu/h3n2/200).",
      "folder": "flu/h3n2/200",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-timetree.schema.json\n\n# Time-scaled tree with a fixed clock rate and date confidence intervals (flu/h3n2/200).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime timetree --config data/flu/h3n2/200/timetree.yaml --output-all tmp/examples/flu/h3n2/200/timetree\n#\n# `timetree` turns divergence into calendar time. Fixing the clock rate\n# (`clock_rate`) skips rate estimation and is common for well-characterized\n# pathogens like seasonal influenza. `confidence` adds date confidence\n# intervals, which need a rate uncertainty (`clock_std_dev`) when the rate is\n# fixed; `coalescent: opt` fits a constant coalescent time scale analytically.\n\ntree: \"tree.nwk\"\nmetadata: \"metadata.tsv\"\nalignment:\n  - \"aln.fasta.xz\"\n\nclock_rate: 0.003\nclock_std_dev: 0.0006\nconfidence: true\ncoalescent: \"opt\"\nmax_iter: 3\n\n# The default outputs: with `confidence`, the node dates table holds the 90% intervals.\noutput_selection:\n  - \"nwk\"\n  - \"nexus\"\n  - \"auspice\"\n  - \"node-data\"\n  - \"model\"\n  - \"sequences\"\n  - \"clock-model\"\n  - \"coalescent\"\n  - \"dates\"\n",
      "inputs": {
        "alignment": [
          "flu/h3n2/200/aln.fasta.xz"
        ],
        "metadata": [
          "flu/h3n2/200/metadata.tsv"
        ],
        "tree": [
          "flu/h3n2/200/tree.nwk"
        ]
      }
    },
    {
      "path": "mpox/clade-ii/1000/optimize.yaml",
      "command": "optimize",
      "title": "Branch-length optimization for a Nextstrain mpox build (mpox/clade-ii/1000).",
      "folder": "mpox/clade-ii/1000",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-optimize.schema.json\n\n# Branch-length optimization for a Nextstrain mpox build (mpox/clade-ii/1000).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime optimize --config data/mpox/clade-ii/1000/optimize.yaml --output-all tmp/examples/mpox/clade-ii/1000/optimize\n#\n# This is the date-free step that replaces `augur refine` in the nextstrain/mpox\n# `WIP/new_tt` workflow. It re-estimates every branch length and reroots on the\n# minimum-divergence branch. mpox divergence is counted in absolute mutations\n# (`divergence_units: mutations`), and indels are excluded from the branch-length\n# likelihood (`no_indels`), matching the pipeline's `treetime optimize` rule.\n\ntree: \"tree.nwk\"\nalignment:\n  - \"aln.fasta.xz\"\n\nreroot: \"min-dev\"\ndivergence_units: \"mutations\"\nno_indels: true\n",
      "inputs": {
        "alignment": [
          "mpox/clade-ii/1000/aln.fasta.xz"
        ],
        "tree": [
          "mpox/clade-ii/1000/tree.nwk"
        ]
      }
    },
    {
      "path": "rsv/a/100/prune.yaml",
      "command": "prune",
      "title": "Tree cleanup: drop short and uninformative branches, collapse shared mutations (rsv/a/100).",
      "folder": "rsv/a/100",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-prune.schema.json\n\n# Tree cleanup: drop short and uninformative branches, collapse shared mutations (rsv/a/100).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime prune --config data/rsv/a/100/prune.yaml --output-all tmp/examples/rsv/a/100/prune\n#\n# `prune` removes tree-builder artifacts before a downstream analysis: branches\n# shorter than a threshold, branches carrying no mutation, and sibling branches\n# in a polytomy that share identical mutations (regrouped under one edge).\n\ntree: \"tree.nwk\"\nalignment:\n  - \"aln.fasta.xz\"\n\ncollapse_short: 1.0e-6\ncollapse_empty: true\nmerge_shared_mutations: true\n",
      "inputs": {
        "alignment": [
          "rsv/a/100/aln.fasta.xz"
        ],
        "tree": [
          "rsv/a/100/tree.nwk"
        ]
      }
    },
    {
      "path": "sc2/2844/ancestral.yaml",
      "command": "ancestral",
      "title": "Marginal ancestral reconstruction on 2844 SARS-CoV-2 genomes (sc2/2844).",
      "folder": "sc2/2844",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-ancestral.schema.json\n\n# Marginal ancestral reconstruction on 2844 SARS-CoV-2 genomes (sc2/2844).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime ancestral --config data/sc2/2844/ancestral.yaml --output-all tmp/examples/sc2/2844/ancestral\n#\n# A large single-command run: marginal reconstruction treats every site\n# independently, fits a GTR rate matrix from the data (the default\n# `model: infer`), and maps nucleotide mutations onto the tree. The sparse\n# representation (the default) stores only variable sites, which keeps a\n# genome-length SARS-CoV-2 alignment tractable.\n\ntree: \"tree.nwk\"\nalignment:\n  - \"aln.fasta.xz\"\n\nmethod_anc: \"marginal\"\n",
      "inputs": {
        "alignment": [
          "sc2/2844/aln.fasta.xz"
        ],
        "tree": [
          "sc2/2844/tree.nwk"
        ]
      }
    },
    {
      "path": "zika/20/ancestral.yaml",
      "command": "ancestral",
      "title": "Marginal ancestral reconstruction with an inferred GTR model (zika/20).",
      "folder": "zika/20",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-ancestral.schema.json\n\n# Marginal ancestral reconstruction with an inferred GTR model (zika/20).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime ancestral --config data/zika/20/ancestral.yaml --output-all tmp/examples/zika/20/ancestral\n#\n# Marginal reconstruction treats every site independently and reports the\n# maximum-likelihood ancestral state per node. It fits a GTR rate matrix from the\n# data (the default `model: infer`) and writes it alongside the tree.\n\ntree: \"tree.nwk\"\nalignment:\n  - \"aln.fasta.xz\"\n\nmethod_anc: \"marginal\"\n",
      "inputs": {
        "alignment": [
          "zika/20/aln.fasta.xz"
        ],
        "tree": [
          "zika/20/tree.nwk"
        ]
      }
    },
    {
      "path": "zika/20/mugration.yaml",
      "command": "mugration",
      "title": "Discrete ancestral geography (\"mugration\") over sampling country (zika/20).",
      "folder": "zika/20",
      "content": "# yaml-language-server: $schema=https://raw.githubusercontent.com/neherlab/treetime/rust/packages/schemas/input-config-mugration.schema.json\n\n# Discrete ancestral geography (\"mugration\") over sampling country (zika/20).\n#\n# Run from any folder; relative paths in this file resolve from its folder, and\n# `--output-all` chooses the output folder. From the repository root:\n#   treetime mugration --config data/zika/20/mugration.yaml --output-all tmp/examples/zika/20/mugration\n#\n# `mugration` treats a discrete metadata column (here `country`) like a\n# sequence character and reconstructs it on internal nodes, inferring a GTR\n# model of transitions between states. `weights` supplies a prior on state\n# equilibrium frequencies; `pc` is the pseudo-count that flattens the model.\n\ntree: \"tree.nwk\"\nmetadata: \"metadata.tsv\"\nattribute: \"country\"\n\nweights: \"../country_weights.csv\"\npc: 1.0\n\n# The default outputs, plus the probability of every state at every node.\nconfidence: true\n",
      "inputs": {
        "metadata": [
          "zika/20/metadata.tsv"
        ],
        "tree": [
          "zika/20/tree.nwk"
        ],
        "weights": [
          "zika/country_weights.csv"
        ]
      }
    }
  ],
