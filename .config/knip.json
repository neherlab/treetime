{
  "$schema": "https://unpkg.com/knip@6.36.0/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "dev/lints/oxlint-anti-slop/vendor/**/*.d.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "dev/lints/oxlint/__tests__/*.ts",
        "dev/lints/oxlint-anti-slop/effect/index.ts",
        "dev/lints/oxlint-anti-slop/**/*.test.ts"
      ],
      "project": ["*.ts", "dev/lints/oxlint/**/*.ts", "dev/lints/oxlint-anti-slop/**/*.ts"],
      "ignoreDependencies": ["react"]
    },
    "packages/app-contracts": {
      "entry": ["src/generated/index.ts"],
      "project": ["src/**/*.ts!"],
      "ignore": ["src/generated/**"]
    },
    "packages/app-ui": {
      "entry": ["src/App.tsx!"],
      "project": ["src/**/*.{ts,tsx}!", "!src/**/__tests__/**!"],
      "ignoreDependencies": ["tw-animate-css", "@svgr/plugin-jsx"]
    },
    "packages/app-web": {
      "entry": ["index.html!"],
      "project": ["src/**/*.{ts,tsx,css}!"]
    },
    "packages/app-desktop": {
      "entry": ["src/main.ts!", "src/backend.ts!", "src/preload.ts!", "renderer/index.html!"],
      "project": ["src/**/*.{ts,tsx}!", "renderer/**/*.{ts,tsx,css}!"]
    },
    "packages/app-napi": {
      "entry": [],
      "project": []
    }
  }
}
