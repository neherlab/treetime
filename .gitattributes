# Normalize line endings to LF for text files, on checkout and in the repo.
* text=auto eol=lf

# Patch files carry exact bytes; never convert their newlines.
*.patch -text
*.diff -text

# Vendored license texts keep the exact bytes of their upstream release.
packages/treetime-charts/fonts/*-OFL.txt -text

# Lock files are regenerated by their tools, not edited by hand.
Cargo.lock linguist-generated=true
dev/lints/*/Cargo.lock linguist-generated=true
.config/mise.lock linguist-generated=true
bun.lock linguist-generated=true
pixi.lock linguist-generated=true

# Generated sources (`just gen`): mark as generated and hide from diffs.
packages/app-contracts/src/generated/** linguist-generated=true -diff
packages/app-contracts/openapi.json linguist-generated=true -diff
packages/app-contracts/setting-catalog.json linguist-generated=true -diff
packages/app-napi/index.d.ts linguist-generated=true -diff
packages/app-ui/src/i18n/generated/** linguist-generated=true -diff
packages/app-ui/public/basemap/** linguist-generated=true -diff
packages/schemas/*.schema.json linguist-generated=true -diff
packages/app-docs/src/generated/en/reference/cli.md linguist-generated=true -diff
packages/design/src/css/tokens.css linguist-generated=true
packages/design/src/css/tailwind-theme.css linguist-generated=true
packages/design/matplotlib/neherlab.mplstyle linguist-generated=true
packages/treetime-charts/src/palette.rs linguist-generated=true
