PROJECT_NAME=treetime
PROJECT_DOCKER_REPO=neherlab/treetime
PROJECT_DOCKER_BUILDER_REPO=neherlab/treetime_builder

# URL to `osxcross.tar.xz` file containing osxcross toolchain
# distribution (https://github.com/tpoechtrager/osxcross) used for cross-compilation
# from Linux to macOS. See `tools/osxcross/README.md` for instructions on how to
# produce it. Refer to osxcross documentation for more info.
# This is only needed if you are on Linux and want to produce binaries for macOS.
OSXCROSS_URL=http://example.com/osxcross/osxcross.tar.xz

# Compiler cache (optional, sccache). Uncomment and set these in your own .env to
# speed up rebuilds. Leave unset (the default) to compile directly with no cache.
# These are standard sccache/cargo variables, forwarded into the build container;
# configure your own backend and paths. See https://github.com/mozilla/sccache.
#
# RUSTC_WRAPPER=sccache            # master switch: unset -> no cache at all
# CARGO_INCREMENTAL=0              # required for cache hits (incremental is uncacheable)
# SCCACHE_BASEDIRS=/workdir        # normalize paths so worktrees share cache keys
# SCCACHE_IGNORE_SERVER_IO_ERROR=1 # fall back to direct compile if the cache is unreachable
# CC=sccache cc                    # also cache native C for build scripts / the cc crate
# CXX=sccache c++
#
# Pick ONE backend:
#   Local disk (bind-mounted at the same path in the container):
# SCCACHE_DIR=/home/you/.cache/sccache
#   Shared daemon over a Unix socket (its directory is bind-mounted at the same path):
# SCCACHE_SERVER_UDS=/home/you/.cache/sccache/sccache.sock
#   Networked (no mount; uses host network): set SCCACHE_BUCKET/SCCACHE_ENDPOINT (S3),
#   SCCACHE_REDIS, SCCACHE_WEBDAV_ENDPOINT, etc. per sccache docs.
