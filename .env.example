PROJECT_NAME=treetime
PROJECT_DOCKER_REPO=neherlab/treetime
PROJECT_DOCKER_BUILDER_REPO=neherlab/treetime_builder

# URL to `osxcross.tar.xz` file containing osxcross toolchain
# distribution (https://github.com/tpoechtrager/osxcross) used for cross-compilation
# from Linux to macOS. See `tools/osxcross/README.md` for instructions on how to
# produce it. Refer to osxcross documentation for more info.
# This is only needed if you are on Linux and want to produce binaries for macOS.
OSXCROSS_URL=http://example.com/osxcross/osxcross.tar.xz

# Compiler cache (optional, kache). Uncomment and set these in your own .env to
# speed up rebuilds. Leave unset (the default) to compile directly with no cache.
# kache is a content-addressed store, safe for concurrent builds across worktrees,
# and it caches `cargo clippy` as well as rustc. The variables are forwarded into
# the build container; the local-disk store is bind-mounted at the same absolute
# path inside the container. See https://github.com/kunobi-ninja/kache.
#
# RUSTC_WRAPPER=kache              # master switch: unset -> no cache at all
# KACHE_BASE_DIR=/workdir          # normalize paths so worktrees share cache keys
# KACHE_CACHE_DIR=/home/you/.kache/treetime  # shared store, bind-mounted at this path
