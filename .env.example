# Machine settings template. Copy the keys you need into the gitignored .env
# next to this file. The justfile and dev/docker/run read .env; a variable that
# is already set in the environment wins over the file.

# kache compiler cache (https://github.com/kunobi-ninja/kache), optional. The
# directory of the cache stores; every build and clippy pass then compiles
# through kache. Workspace crates of incremental builds keep their incremental
# state, and kache serves the dependencies and the builds without incremental
# state (CI, dist, profiling, bench, cross). It holds one store per kache
# version, environment (host or docker), and pass (build, clippy, or
# cross-<target>), and dev/docker/run mounts it into the container at the same
# path. An absolute path shares the stores between the worktrees of this
# project; never share it with another project. Unset: plain rustc.
#KACHE_STORE=/home/you/.kache/treetime
# Size limit of each store. Unset: 100GiB.
#KACHE_MAX_SIZE=100GiB

# Smoke snapshot store, optional. An absolute directory that dev/smoke shares
# between all checkouts of this project on the machine: every snapshot, the
# baseline of a git ref included, is built and run once and then reused by every
# worktree. dev/docker/run mounts it into the container at the same path. Unset:
# each checkout keeps its own snapshots/ directory.
#SMOKE_STORE=/home/you/.cache/treetime-smoke

# portless proxy (https://github.com/vercel-labs/portless) for the web dev
# server: `allowed` (default) registers https://<name>.localhost when the proxy
# state directory (PORTLESS_STATE_DIR, default ~/.portless) exists, `off` never,
# `required` fails when the proxy is not set up.
#TREETIME_PORTLESS=allowed

# Desktop app folders, optional. The app keeps settings.yaml and the profile/,
# runs/, logs/, and examples/ folders in one root folder. `just desktop` and
# `just desktop-prod` use tmp/app/treetime-dev and tmp/app/treetime-prod of the
# checkout as root, and data/ of the checkout as examples. A relative path is
# relative to the checkout; dev/docker/run mounts an absolute path into the
# container at the same path. TREETIME_APP_DIR sets the root of both modes and of
# an installed app (default ~/.config/treetime on Linux). The TREETIME_*_DIR
# variables of single folders take precedence over the `paths:` block of
# settings.yaml.
#TREETIME_DESKTOP_DEV_DIR=tmp/app/treetime-dev
#TREETIME_DESKTOP_PROD_DIR=tmp/app/treetime-prod
#TREETIME_APP_DIR=/home/you/treetime
#TREETIME_PROFILE_DIR=/home/you/treetime/profile
#TREETIME_RUNS_DIR=/home/you/treetime-runs
#TREETIME_LOGS_DIR=/home/you/treetime/logs
#TREETIME_EXAMPLES_DIR=data
