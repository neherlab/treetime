{
  "name": "@neherlab/treetime",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/app-contracts",
      "packages/app-desktop",
      "packages/app-napi",
      "packages/app-server",
      "packages/app-ui",
      "packages/app-web"
    ],
    "catalog": {
      "@better-fetch/fetch": "1.3.2",
      "@types/react": "19.2.15",
      "better-result": "3.0.1",
      "fast-check": "4.10.0",
      "globby": "16.2.4",
      "luxon": "3.7.2",
      "nanoid": "6.0.1",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "remeda": "2.50.0",
      "superjson": "2.2.6",
      "typescript": "7.0.2",
      "vitest": "4.1.7",
      "zod": "4.6.5"
    }
  },
  "scripts": {
    "dev:desktop": "turbo dev --cache-dir=.turbo/cache --filter=@neherlab/app-desktop",
    "dev:web": "turbo dev --cache-dir=.turbo/cache --filter=@neherlab/app-web --filter=@neherlab/app-server",
    "dev:server": "turbo dev --cache-dir=.turbo/cache --filter=@neherlab/app-server",
    "build": "turbo build --cache-dir=.turbo/cache",
    "build:desktop": "turbo build --cache-dir=.turbo/cache --filter=@neherlab/app-desktop",
    "build:web": "turbo build --cache-dir=.turbo/cache --filter=@neherlab/app-web --filter=@neherlab/app-server",
    "release:web": "turbo watch release --cache-dir=.turbo/cache --filter=@neherlab/app-web --filter=@neherlab/app-server",
    "lint": "turbo lint --cache-dir=.turbo/cache",
    "lint:fix": "turbo lint:fix --cache-dir=.turbo/cache",
    "format": "turbo format --cache-dir=.turbo/cache",
    "format:check": "turbo format:check --cache-dir=.turbo/cache",
    "typecheck": "turbo typecheck --cache-dir=.turbo/cache",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "knip:production": "knip --production",
    "upgrade": "bun update --latest"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@microsoft/fetch-event-source": "2.0.1",
    "@types/node": "24.13.4",
    "fast-check": "4.10.0",
    "knip": "6.35.1",
    "oxfmt": "0.51.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.9.14",
    "typescript": "7.0.2",
    "vitest": "4.1.7"
  },
  "trustedDependencies": [
    "electron"
  ]
}
