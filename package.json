{
  "name": "@neherlab/treetime",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "packages/app-contracts",
      "packages/app-desktop",
      "packages/app-napi",
      "packages/app-server",
      "packages/app-ui",
      "packages/app-web"
    ],
    "catalog": {
      "@types/react": "18.3.31",
      "@types/react-dom": "18.3.7",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "typescript": "7.0.2",
      "vitest": "4.1.7",
      "zod": "4.6.2"
    }
  },
  "scripts": {
    "dev:desktop": "turbo dev --cache-dir=.turbo/cache --filter=@neherlab/app-desktop",
    "dev:web": "turbo dev --cache-dir=.turbo/cache --filter=@neherlab/app-web --filter=@neherlab/app-server",
    "dev:server": "turbo dev --cache-dir=.turbo/cache --filter=@neherlab/app-server",
    "build": "turbo build --cache-dir=.turbo/cache",
    "build:desktop": "turbo build --cache-dir=.turbo/cache --filter=@neherlab/app-desktop",
    "build:web": "turbo build --cache-dir=.turbo/cache --filter=@neherlab/app-web --filter=@neherlab/app-server",
    "release:web": "turbo watch release --cache-dir=.turbo/cache --filter=@neherlab/app-web --filter=@neherlab/app-server",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write packages/app-*/src packages/app-*/renderer dev/lints/oxlint test oxlint.config.ts oxfmt.config.ts vitest.config.ts vitest.setup.ts",
    "format:check": "oxfmt --check packages/app-*/src packages/app-*/renderer dev/lints/oxlint test oxlint.config.ts oxfmt.config.ts vitest.config.ts vitest.setup.ts",
    "typecheck": "turbo typecheck --cache-dir=.turbo/cache --continue=always",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "typecheck:vendor": "tsc -p tsconfig.vendor.json --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "knip:production": "knip --production",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.all --coverage.include=\"packages/*/src/**/*.{ts,tsx}\"",
    "upgrade": "bun update --latest"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@oxlint/plugins": "1.82.0",
    "@vitest/coverage-v8": "4.1.7",
    "@types/node": "24.13.4",
    "eslint-plugin-no-comments": "1.2.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "fast-check": "4.10.0",
    "knip": "6.35.1",
    "oxfmt": "0.51.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.9.14",
    "typescript": "7.0.2",
    "vitest": "4.1.7"
  },
  "trustedDependencies": [
    "electron"
  ]
}
