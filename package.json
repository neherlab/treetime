{
  "name": "@neherlab/treetime",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/app-contracts",
      "packages/app-docs",
      "packages/app-desktop",
      "packages/app-napi",
      "packages/app-ui",
      "packages/app-wasm",
      "packages/app-web",
      "packages/app-web2"
    ],
    "catalog": {
      "@tailwindcss/vite": "4.3.3",
      "@types/node": "24.13.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.1",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.3.4",
      "vite-plugin-compression2": "2.5.3",
      "zod": "4.6.7",
      "p-wait-for": "6.0.0",
      "katex": "0.19.0",
      "@tanstack/react-hotkeys": "0.10.0",
      "zustand": "5.0.15",
      "ts-pattern": "5.9.0",
      "unplugin-icons": "24.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "build:desktop": "bun run --cwd packages/app-desktop build",
    "build:docs": "bun run --cwd packages/app-docs build",
    "build:web": "bun run --cwd packages/app-web build",
    "build:web2": "bun run --cwd packages/app-web2 build",
    "coverage": "bun test --parallel --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=tmp/coverage/ts",
    "dev:desktop": "bun run --cwd packages/app-desktop dev",
    "dev:docs": "bun run --cwd packages/app-docs dev",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "knip": "knip --config .config/knip.json",
    "knip:production": "knip --config .config/knip.json --production",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "test": "bun test --parallel"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/node": "catalog:",
    "bun-types": "1.4.2",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-no-comments": "1.2.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-sonarjs": "4.2.1",
    "fast-check": "4.10.1",
    "knip": "6.36.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "overrides": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dompurify": "3.4.17",
    "katex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "styled-components": "5.3.11"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=24.22.1"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "auspice@3.1.0": "patches/auspice@3.1.0.patch",
    "unplugin-icons@24.0.0": "patches/unplugin-icons@24.0.0.patch"
  }
}
