{
  "name": "@neherlab/treetime",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/app-contracts",
      "packages/app-desktop",
      "packages/app-napi",
      "packages/app-ui",
      "packages/app-web"
    ],
    "catalog": {
      "@tailwindcss/vite": "4.3.3",
      "@types/node": "24.13.5",
      "@types/react": "18.3.31",
      "@types/react-dom": "18.3.7",
      "@vitejs/plugin-react": "6.1.1",
      "@vitest/coverage-v8": "5.0.1",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.3.0",
      "vitest": "5.0.1",
      "zod": "4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "build:desktop": "turbo run build --filter=@neherlab/app-desktop",
    "build:web": "turbo run build --filter=@neherlab/app-web",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=tmp/coverage/ts --coverage.include=\"packages/*/src/**/*.{ts,tsx}\"",
    "dev:desktop": "turbo run dev --filter=@neherlab/app-desktop",
    "format": "bun --bun oxfmt --write .",
    "format:check": "bun --bun oxfmt --check .",
    "knip": "knip",
    "knip:production": "knip --production",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "test": "vitest run",
    "typecheck:packages": "turbo run typecheck --continue=always",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:vendor": "tsc -p tsconfig.vendor.json"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-no-comments": "1.2.1",
    "eslint-plugin-sonarjs": "4.2.1",
    "fast-check": "4.10.1",
    "knip": "6.36.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.13",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.4.2"
}
