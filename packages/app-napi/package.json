{
  "name": "@neherlab/app-napi",
  "version": "0.0.1",
  "private": true,
  "description": "TreeTime desktop application - Rust native addon for Electron",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "RUSTC_WRAPPER= napi build --platform --release --no-dts-header"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.3"
  },
  "napi": {
    "binaryName": "app-napi",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
