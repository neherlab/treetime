#!/usr/bin/env python3
"""
Simulation capture script for the partition rate recovery test.

Evolves sequences along data/zika/86/tree.nwk under JC69 with the v0 simulator
(treetime.seqgen.SeqGen). Each replicate simulates three alignment files of
3000 sites with the relative rates 0.3, 1.0 and 2.0, using the replicate number
(1 to 20) as the random seed. The three files of one replicate come from one
random number generator, one after another, so they are independent.

Output: rate_recovery_alignments.fasta.xz, one record per leaf. Each sequence is
the concatenation of all replicates in seed order, and each replicate is the
concatenation of its three files in rate order:

    columns [(s - 1) * 9000 + (f - 1) * 3000, ...) of length 3000
    hold file f of the replicate with seed s

Usage:
    ./dev/docker/python python packages/treetime/src/optimize/__tests__/__fixtures__/rate_recovery_capture
"""

import lzma
from pathlib import Path

from Bio import Phylo
from treetime.nuc_models import JC69
from treetime.seqgen import SeqGen

FIXTURES_DIR = Path(__file__).parent
REPO_ROOT = FIXTURES_DIR.parents[5]
TREE_PATH = REPO_ROOT / "data" / "zika" / "86" / "tree.nwk"
OUTPUT_PATH = FIXTURES_DIR / "rate_recovery_alignments.fasta.xz"

SEEDS = range(1, 21)
SITES_PER_FILE = 3000
RATES = [0.3, 1.0, 2.0]


def simulate_replicate(seed: int) -> dict[str, str]:
    tree = Phylo.read(TREE_PATH, "newick")
    gen = SeqGen(SITES_PER_FILE, tree=tree, gtr=JC69(alphabet="nuc_nogap"), rng_seed=seed)
    sequences: dict[str, list[str]] = {}
    for rate in RATES:
        gen.gtr.mu = rate
        gen.evolve()
        for record in gen.get_aln():
            sequences.setdefault(record.id, []).append(str(record.seq))
    return {name: "".join(parts) for name, parts in sequences.items()}


def main() -> None:
    replicates = [simulate_replicate(seed) for seed in SEEDS]
    names = list(replicates[0])
    if any(list(replicate) != names for replicate in replicates):
        raise RuntimeError("Replicates differ in their leaf names")

    fasta = "".join(f">{name}\n{''.join(replicate[name] for replicate in replicates)}\n" for name in names)
    with lzma.open(OUTPUT_PATH, "wt", preset=9 | lzma.PRESET_EXTREME) as file:
        file.write(fasta)

    print(f"Written: {OUTPUT_PATH} ({OUTPUT_PATH.stat().st_size} bytes)")


if __name__ == "__main__":
    main()
