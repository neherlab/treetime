{
  "name": "@neherlab/app-server",
  "version": "0.0.1",
  "private": true,
  "description": "TreeTime HTTP API server",
  "scripts": {
    "build": "just b --bin=treetime-server",
    "build:release": "just br treetime-server",
    "dev": "cd ../.. && bacon --headless server",
    "release": "STATIC_DIR=../app-web/dist just rr treetime-server -- --data-dir=data --out-dir=tmp/web",
    "server:run": "printf 'Compiling server...\\n' >&2 && exec just r treetime-server -- --data-dir=data --out-dir=tmp/web"
  }
}
