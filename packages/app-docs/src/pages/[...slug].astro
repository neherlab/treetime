---
import { baseLocale } from "@neherlab/app-ui/i18n";

import DocsPage from "../components/DocsPage.astro";
import { source } from "../lib/source";

export function getStaticPaths() {
  return source.getPages(baseLocale).map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<DocsPage page={page} locale={baseLocale} />
