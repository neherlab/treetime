{
  "name": "@neherlab/app-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared React components for TreeTime desktop and web apps",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@neherlab/app-contracts": "workspace:*",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-router": "1.170.35",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.16.0",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "6.1.5",
    "tailwindcss": "4.3.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
