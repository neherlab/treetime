{
  "name": "@neherlab/app-ui",
  "version": "0.0.1",
  "private": true,
  "description": "Shared React components for TreeTime desktop and web apps",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
