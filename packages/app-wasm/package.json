{
  "name": "@neherlab/app-wasm",
  "version": "0.0.1",
  "private": true,
  "description": "TreeTime web2 application - WebAssembly back end, single-threaded in pkg/st/ (`just build-wasm`) and threaded in pkg/mt/ (`just build-wasm-mt`)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./pkg/app_wasm.d.ts",
      "default": "./pkg/st/app_wasm.js"
    },
    "./app_wasm.wasm": "./pkg/st/app_wasm.wasm",
    "./threads": {
      "types": "./pkg/app_wasm.d.ts",
      "default": "./pkg/mt/app_wasm.js"
    },
    "./threads/app_wasm.wasm": "./pkg/mt/app_wasm.wasm"
  },
  "devDependencies": {
    "@neherlab/app-contracts": "workspace:*",
    "@types/node": "catalog:",
    "zod": "catalog:"
  }
}
