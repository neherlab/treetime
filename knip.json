{
  "$schema": "https://unpkg.com/knip@6.35.1/schema.json",
  "ignoreWorkspaces": ["packages/app-server"],
  "ignoreIssues": {
    "dev/lints/oxlint-anti-slop/vendor/**/*.d.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "dev/lints/oxlint/__tests__/*.ts",
        "dev/lints/oxlint-anti-slop/effect/index.ts",
        "dev/lints/oxlint-anti-slop/**/*.test.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "*.ts",
        "dev/lints/oxlint/**/*.ts",
        "dev/lints/oxlint-anti-slop/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/app-contracts": {
      "entry": ["src/bridge.ts!", "src/generated/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/app-ui": {
      "entry": ["src/App.tsx!"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@base-ui-components/react",
        "@fontsource/ibm-plex-mono",
        "@fontsource/lato",
        "@tanstack/react-query",
        "class-variance-authority",
        "cn",
        "lucide-react",
        "next-themes",
        "react-error-boundary",
        "zustand"
      ]
    },
    "packages/app-web": {
      "entry": ["index.html!", "src/bridge-web.ts!"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@tailwindcss/vite", "tailwindcss"]
    },
    "packages/app-desktop": {
      "entry": [
        "src/preload.ts!",
        "renderer/index.html!"
      ],
      "project": ["src/**/*.{ts,tsx}", "renderer/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@tailwindcss/vite", "tailwindcss"]
    },
    "packages/app-napi": {
      "entry": [],
      "project": []
    }
  }
}
